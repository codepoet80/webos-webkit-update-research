     if (!o.isText()) {
         if (o.parent() && o.parent()->childrenInline() && o.isRenderInline()) {

diff -u a/WebCore/rendering/InlineTextBox.cpp b/WebCore/rendering/InlineTextBox.cpp
--- a/WebCore/rendering/InlineTextBox.cpp
+++ b/WebCore/rendering/InlineTextBox.cpp
@@ -330,7 +330,11 @@ void InlineTextBox::paint(RenderObject::PaintInfo& paintInfo, int tx, int ty)
         return;

     if (m_truncation != cNoTruncation) {
-        TextDirection flowDirection = renderer()->containingBlock()->style()->direction();
+        // Security fix: containingBlock() can return null in edge cases
+        RenderBlock* cb = renderer()->containingBlock();
+        if (!cb)
+            return;
+        TextDirection flowDirection = cb->style()->direction();
         if (flowDirection != direction()) {
             // Make the visible fragment of text hug the edge closest to the rest of the run by moving the origin
             // at which we start drawing text.
@@ -936,7 +940,9 @@ void InlineTextBox::paintCompositionBackground(GraphicsContext* context, int tx

 void InlineTextBox::paintDecoration(GraphicsContext* context, int tx, int ty, int deco, ShadowData* shadow)
 {
-    RenderBlock *blockElement = renderer()->containingBlock();
+    RenderBlock* blockElement = renderer()->containingBlock();
+    if (!blockElement)
+        return;

     // Get the text decoration colors.
     Color underline, overline, linethrough;
