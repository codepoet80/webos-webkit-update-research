From: webOS Security Patches
Subject: [PATCH 001] Fix null pointer dereferences in rendering code
Date: 2025-01-01

This patch addresses CVE-2010-1813 and similar memory corruption
vulnerabilities in the rendering pipeline where containingBlock()
can return null but the return value is dereferenced without checks.

Affected areas:
- RenderBlock::paintContinuationOutlines()
- RenderTreeAsText (debugging/test code)
- InlineTextBox::paint()

---
diff -u a/WebCore/rendering/RenderBlock.cpp b/WebCore/rendering/RenderBlock.cpp
--- a/WebCore/rendering/RenderBlock.cpp
+++ b/WebCore/rendering/RenderBlock.cpp
@@ -1723,10 +1723,14 @@ void RenderBlock::paintObject(PaintInfo& paintInfo, int tx, int ty)
             RenderInline* inlineRenderer = toRenderInline(inlineFlow->node()->renderer());
             if (inlineRenderer != inlineFlow) {
                 // Renderers changed, likely due to reattach - use the new one
-                containingBlock()->addContinuationWithOutline(inlineRenderer);
-            else if (!inlineRenderer->firstLineBox())
-                inlineRenderer->paintOutline(paintInfo.context, tx - x() + inlineRenderer->containingBlock()->x(),
-                                             ty - y() + inlineRenderer->containingBlock()->y());
+                RenderBlock* cb = containingBlock();
+                if (cb)
+                    cb->addContinuationWithOutline(inlineRenderer);
+            } else if (!inlineRenderer->firstLineBox()) {
+                RenderBlock* cb = inlineRenderer->containingBlock();
+                if (cb)
+                    inlineRenderer->paintOutline(paintInfo.context, tx - x() + cb->x(),
+                                                 ty - y() + cb->y());
+            }
         }
         paintContinuationOutlines(paintInfo, tx, ty);
     }
@@ -1830,6 +1834,8 @@ void RenderBlock::paintContinuationOutlines(PaintInfo& info, int tx, int ty)
     for (ListHashSet<RenderInline*>::iterator it = continuations->begin(); it != end; ++it) {
         // Need to add in the coordinates of the intervening blocks.
         RenderInline* flow = *it;
+        if (!flow)
+            continue;
         RenderBlock* block = flow->containingBlock();
         for ( ; block && block != this; block = block->containingBlock()) {
             tx += block->x();
@@ -1837,6 +1843,11 @@ void RenderBlock::paintContinuationOutlines(PaintInfo& info, int tx, int ty)
         }
-        ASSERT(block);
-        flow->paintOutline(info.context, tx, ty);
+        // Security fix: Check block is valid before proceeding
+        // This can be null if the render tree changed during iteration
+        if (block) {
+            flow->paintOutline(info.context, tx, ty);
+        } else {
+            // Block chain broken - skip this outline
+        }
     }

     // Delete

