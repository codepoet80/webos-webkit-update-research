@@ -0,0 +1,20 @@
+#ifndef SQLDumpCallback_h
+#define SQLDumpCallback_h
+
+#include "Threading.h"
+
+namespace WebCore {
+
+class SQLDump;
+class SQLError;
+    
+class SQLDumpCallback : public ThreadSafeShared<SQLDumpCallback> {
+public:
+    virtual ~SQLDumpCallback() { }
+    virtual void handleEvent(SQLDump*, bool& raisedException) = 0;
+};
+
+}
