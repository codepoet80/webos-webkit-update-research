+        void trimVideoTitleChanged()
+        {
+        };
+        void fitModeChanged()
+        {
+            mpp_->m_fitMode = mpp_->m_client->getFitMode();
+        };
+        void savedChanged()
+        {
+            PRINTF_YELLOW("SAVED!");
+        };
+        void networkStateChanged()
+        {
+            switch (mpp_->m_client->getNetworkState()) {
+            default:
+            case media::NETWORK_EMPTY:
+                mpp_->m_networkState = MediaPlayer::Empty;
+                break;
+            case media::NETWORK_IDLE:
+                mpp_->m_networkState = MediaPlayer::Idle;
+                break;
+            case media::NETWORK_LOADING:
+                mpp_->m_networkState = MediaPlayer::Loading;
+                break;
+            case media::NETWORK_LOADED:
+                mpp_->m_networkState = MediaPlayer::Loaded;
+                break;
+            }
+            mpp_->m_player->networkStateChanged();
+        };
+        void readyStateChanged()
+        {
+            switch (mpp_->m_client->getReadyState()) {
+            default:
+            case media::HAVE_NOTHING:
+                mpp_->m_readyState = MediaPlayer::HaveNothing;
+                break;
+            case media::HAVE_METADATA:
+                mpp_->m_readyState = MediaPlayer::HaveMetadata;
+                break;
+            case media::HAVE_CURRENT_DATA:
+                mpp_->m_readyState = MediaPlayer::HaveCurrentData;
+                m_makeReadyForDisplay = true;
+                break;
+            case media::HAVE_FUTURE_DATA:
+                mpp_->m_readyState = MediaPlayer::HaveFutureData;
+                break;
+            case media::HAVE_ENOUGH_DATA:
+                mpp_->m_readyState = MediaPlayer::HaveEnoughData;
+                break;
+            }
+            mpp_->m_player->readyStateChanged();
+            makeReadyForDisplay();
+        };
+        void extendedErrorChanged()
+        {
+            string valueStr = mpp_->m_client->getExtendedError();
+            if (mpp_->m_element) {
+                ExceptionCode ec;
+                mpp_->m_element->setAttribute("x-palm-media-extended-error", valueStr.c_str(), ec);
+            }
+        };
+        void errorChanged()
+        {
+            media::Error e = mpp_->m_client->getError();
+            if (media::NO_ERROR == e) {
+                if (mpp_->m_element) {
+                    ExceptionCode ec;
+                    mpp_->m_element->setAttribute("x-palm-media-extended-error", "", ec);
+                }
+            } else {
+                if (e == media::INVALID_SOURCE_ERROR) {
+                    mpp_->m_networkState = MediaPlayer::FormatError;
+                    mpp_->m_player->networkStateChanged();
+                } else if (e == media::NETWORK_ERROR) {
+                    mpp_->m_networkState = MediaPlayer::NetworkError;
+                    mpp_->m_player->networkStateChanged();
+                } else if (e == media::FORMAT_ERROR) {
+                    mpp_->m_networkState = MediaPlayer::FormatError;
+                    mpp_->m_player->networkStateChanged();
+                } else if (e == media::DECODE_ERROR) {
+                    mpp_->m_networkState = MediaPlayer::DecodeError;
+                    mpp_->m_player->networkStateChanged();
+                }
+            }
+        };
+        void totalBytesChanged()
+        {
+            mpp_->m_totalBytes = mpp_->m_client->getTotalBytes();
+        };
+        void bytesLoadedChanged()
+        {
+            mpp_->m_bytesLoaded = mpp_->m_client->getBytesLoaded();
+        };
+        void durationChanged()
+        {
+            mpp_->m_duration = mpp_->m_client->getDuration();
+            if (mpp_->m_duration < 0.0)
+                mpp_->m_duration = numeric_limits<float>::infinity();
+
+            PRINTF_BLUE("MediaPlayerChangeListener::durationChanged %f", mpp_->m_duration);
+            mpp_->m_player->durationChanged();
+        };
+        void startTimeChanged()
+        {
+            PRINTF_RED("MediaPlayerChangeListener::startTimeChanged Removed from HTML5 spec ");
+        };
+        void endTimeChanged()
+        {
+            PRINTF_RED("MediaPlayerChangeListener::endTimeChanged Removed from HTML5 spec ");
+        };
+        void pausedChanged()
+        {
+            mpp_->m_paused = mpp_->m_client->getPaused();
+        };
+        void pausedChangeReasonChanged()
+        {
+            string reason = mpp_->m_client->getPausedChangeReason();
+            bool pause = mpp_->m_client->getPaused();
+
+            if ("paused true by arbitrator" == reason) {
+                if (mpp_->m_paused)
+                    mpp_->m_element->pause(true);
+            } else if ("paused false by arbitrator" == reason) {
+                if (!mpp_->m_paused)
+                    mpp_->m_element->play(false);
+            }
+            if (!mpp_->m_paused && !mpp_->m_overlayplayback) {
+                // only release non overlay playback capture
+                // overlay playback capture is released when media process sent us a message
+                if (mpp_->m_videoFrameCaptured) {
+                    mpp_->m_videoFrameCaptured->releaseRef();
+                    mpp_->m_videoFrameCaptured = 0;
+                }
+            }
+        };
+        void currentTimeChanged()
+        {
+            mpp_->m_currentTime = mpp_->m_client->getCurrentTime();
+            m_makeReadyForDisplay = TRUE;
+            makeReadyForDisplay();
+        };
+        void eosChanged()
+        {
+            if (mpp_->m_client->getEos()) {
+                // NOV-105135: pausing first as a workaround to ensure file continues playing after seek
+                if (mpp_->m_element->loop())
+                    mpp_->m_player->pause();
+
+                /*
+                 * NOV-85709: we need to set the current time
+                 * to end time before notifying that the time
+                 * changed for the HTMLMediaElement to generate
+                 * the 'ended' event.
+                 */
+                mpp_->m_currentTime = mpp_->m_duration;
+                mpp_->m_player->timeChanged();
+            }
+        };
+        void seekingChanged()
+        {
+            mpp_->m_seeking = mpp_->m_client->getSeeking();
+            if (!mpp_->m_seeking) {
+                mpp_->m_player->timeChanged();
+                m_makeReadyForDisplay = TRUE;
+                makeReadyForDisplay();
+            }
+        };
+        void hasVideoChanged()
+        {
+            mpp_->m_hasVideo = mpp_->m_client->getHasVideo();
+        };
+        void hasAudioChanged()
+        {
+            mpp_->m_hasAudio = mpp_->m_client->getHasAudio();
+        };
+        void pausableChanged()
+        {
+            mpp_->m_pausable = mpp_->m_client->getPausable();
+            ExceptionCode ec;
+            mpp_->m_element->setAttribute("x-palm-media-pausable", mpp_->m_pausable?"true":"false", ec);
+        };
+        void videoFrameCaptureChanged()
+        {
+            string tokSharedMem = mpp_->m_client->getVideoFrameCapture();
+            PRINTF_BLUE("videoFrameCapture: %s", tokSharedMem.c_str());
+
+            if (!tokSharedMem.size()) {
+                // playing: don't show anything and let the overlay shine
+                if (mpp_->m_videoFrameCaptured) {
+                    mpp_->m_videoFrameCaptured->releaseRef();
+                    mpp_->m_videoFrameCaptured = 0;
+                }
+                mpp_->m_player->repaint();
+            } else if ("-" == tokSharedMem) {
+                // Magic value to ignore.
+                PRINTF_BLUE("Ignoring videoFrameCapture message");
+            } else {
+                // use the bitmap data passed in shared memory
+                const char * cFailedCapture = "?"; // TODO: how do we share this with mediaserver
+
+                bool success = false;
+                VERIFY(tokSharedMem != cFailedCapture);
+                if (tokSharedMem != cFailedCapture) {
+                    bool isSysV =  (!tokSharedMem.compare(0, 5 /*"SYSV:".length*/, "SYSV:"));
+                    bool isPosix = !isSysV; // tokSharedMem.compare(0, 6 /*"POSIX:".length*/, "POSIX:");
+
+                    if (isPosix) {
+                        string shmName = tokSharedMem.substr(6);
+
+                        int fd = shm_open(shmName.c_str(), O_RDONLY, S_IRUSR | S_IWUSR);
+                        VERIFY(fd >= 0);
+                        if (fd >= 0) {
+                            struct stat statbuf;
+                            bool fstatok = !fstat(fd, &statbuf);
+                            VERIFY(fstatok);
+                            if (fstatok) {
+                                VERIFY(statbuf.st_size > 2 * (int) sizeof(int));
+                                if (statbuf.st_size > 2 * (int) sizeof(int)) {
+                                    int * ptr = (int *) mmap(0, statbuf.st_size, PROT_READ, MAP_SHARED, fd, 0);
+                                    VERIFY(ptr != MAP_FAILED && ptr);
+                                    if (ptr != MAP_FAILED && ptr) {
+                                        int width = *(ptr++);
+                                        int height = *(ptr++);
+                                        bool dimensionsLookGood = width > 0 && width < 10000 && height > 0 && height < 10000;
+                                        bool dataFitsInSharedMemory = width * height * 3 + 2 * (int) sizeof(int) <= statbuf.st_size;
+                                        VERIFY(dimensionsLookGood);
+                                        VERIFY(dataFitsInSharedMemory);
+                                        if (dimensionsLookGood && dataFitsInSharedMemory) {
+                                            int * dst = mpp_->getVideoFrameCaptureData(width, height);
+                                            VERIFY(dst);
+                                            if (dst) {
+                                                const char * src = (const char *) ptr;
+                                                const char * end = src + 3 * width * height;
+                                                while (src < end) {
+                                                    int data = *src++;
+                                                    data = (*src++ << 8) | data;
+                                                    data = (*src++ << 16) | data;
+                                                    *(dst++) = data | 0xff000000; // transparency
+                                                }
+
+                                                PRINTF_BLUE("Got video frame capture data from POSIX memory!");
+                                                success = true;
+                                            }
+                                        }
+                                        munmap(ptr, statbuf.st_size);
+                                    }
+                                }
+                            }
+                        }
+                        if (fd >= 0)
+                            close(fd);
+                    } else if (isSysV) {
+                        int shmMemId = atoi(tokSharedMem.substr(5).c_str());
+                        PRINTF_BLUE("SysV ID for shared memory is %i", shmMemId);
+
+                        struct shmid_ds buf;
+                        // get the size of the shared memory created
+                        int result = shmctl(shmMemId, IPC_STAT, &buf);
+                        VERIFY(result != -1);
+                        if (result != -1) {
+                            VERIFY(buf.shm_segsz > 2 * (int) sizeof(int));
+                            if (buf.shm_segsz > 2 * (int) sizeof(int)) {
+                                const void * shmMemAddr = shmat(shmMemId, 0, SHM_RND);
+                                VERIFY(shmMemAddr != MAP_FAILED && shmMemAddr);
+                                if (shmMemAddr != MAP_FAILED && shmMemAddr) {
+                                    const int * ptr = (const int *) shmMemAddr;
+                                    int width = *(ptr++);
+                                    int height = *(ptr++);
+                                    bool dimensionsLookGood = width > 0 && width < 10000 && height > 0 && height < 10000;
+                                    bool dataFitsInSharedMemory = width * height * 3 + 2 * sizeof(int) <= buf.shm_segsz;
+                                    VERIFY(dimensionsLookGood);
+                                    VERIFY(dataFitsInSharedMemory);
+                                    if (dimensionsLookGood && dataFitsInSharedMemory) {
+                                        int * dst = mpp_->getVideoFrameCaptureData(width, height);
+                                        VERIFY(dst);
+                                        if (dst) {
+                                            const char * src = (const char *) ptr;
+                                            const char * end = src + 3 * width * height;
+                                            while (src < end) {
+                                                int data = *src++;
+                                                data = (*src++ << 8) | data;
+                                                data = (*src++ << 16) | data;
+                                                *(dst++) = data | 0xff000000; // transparency
+                                            }
+
+                                            PRINTF_BLUE("Got video frame capture data from Sys V shared memory!");
+                                            success = true;
+                                        }
+                                    }
+                                    shmdt(shmMemAddr);
+                                }
+                            }
+                        }
+                    } else {
+                        PRINTF_RED("Shared Memory ID did not decode to a valid format (SYS V or POSIX)");
+                    }
+                }
+                if (!success) {
+                    PRINTF_BLUE("Failed to get video frame capture data: using black...");
+                    int width = mpp_->m_width > 0 ? mpp_->m_width : mpp_->m_element->clientWidth();
+                    int height = mpp_->m_height > 0 ? mpp_->m_height : mpp_->m_element->clientHeight();
+                    int * data = mpp_->getVideoFrameCaptureData(width, height);
+                    if (data) {
+                        int * dataEnd = data + width * height;
+                        while (data < dataEnd)
+                            *(data++) = 0xff000000; // no transparency, all the rest 0 = black
+                    }
+                }
+                if (mpp_->m_overlayplayback && mpp_->m_paused && mpp_->m_unloading) {
+                    PRINTF_YELLOW("Received card event and the pipeline is paused, suspend!");
+                    mpp_->m_client->suspend();
+                    mpp_->m_unloading = false;
+                }
+                mpp_->m_player->repaint();
+            }
+        };
+
+    }; // MediaPlayerChangeListener
