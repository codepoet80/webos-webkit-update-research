+#if PLATFORM(WEBOS)
+bool SQLiteDatabase::openAndValidate(const String& filename, bool forWebSQLDatabase)
+{
+    close();
+
+	String path = filename;
+    
+    m_lastError = SQLiteFileSystem::openDatabase(filename, &m_db, forWebSQLDatabase);
+    if (m_lastError != SQLITE_OK) {
+        LOG_ERROR("SQLite database failed to load from %s\nCause - %s", filename.ascii().data(),
+            sqlite3_errmsg(m_db));
+        sqlite3_close(m_db);
+        m_db = 0;
+        return false;
+    }
+
+    if (isOpen())
+        m_openingThread = currentThread();
+
+	if (!verifyDbIntegrity()) {
+		LOG_ERROR("SQLite database is corrupt.");
+
+		if( m_db ) 
+			sqlite3_close( m_db );
+		
+		// Remove this database file and retry. We can't recover from this anyway.
+		g_warning( "Database %s is corrupt, erasing.\n", path.utf8().data() );
+		unlink( path.utf8().data() );
+		
+		m_lastError = sqlite3_open16(path.charactersWithNullTermination(), &m_db);
+		if (m_lastError != SQLITE_OK) {
+			return false;
+		}
+	}
+    
+    if (!SQLiteStatement(*this, "PRAGMA temp_store = MEMORY;").executeCommand())
+        LOG_ERROR("SQLite database could not set temp_store to memory");
+
+    return isOpen();
+}
+
+int SQLiteDatabase::getTotalChanges(int& numTotalChanges) const
+{
+	if (m_db == NULL) {
+		numTotalChanges = 0;
+		return -1;
+	}
+
+	numTotalChanges = sqlite3_total_changes(m_db);
+	return 0;
+}
+
+/**
+ * Dump a sqlite database file to the specified output file.
+ */
+int SQLiteDatabase::dump(const String& inSqlFile, const String& outCmdFile)
+{
+	int	rc(0);
+	char* cmd(NULL);
+	CString in = inSqlFile.utf8();
+	CString out = outCmdFile.utf8();
+
+	if (access(out.data(), R_OK) == 0) {
+		if (0 != ::unlink(out.data())) {
+			g_warning("ERROR %d deleting '%s'", errno, out.data());
+			return errno;
+		}
+	}
+
+	if (asprintf(&cmd, "/usr/bin/sqlite3 \"%s\" .dump > \"%s\"", in.data(), out.data()) > 0) {
+		rc = ::system(cmd);
+		::free(cmd);
+        if (rc >= 0) {
+            if (WIFEXITED(rc)) {
+                rc = WEXITSTATUS(rc);   // return the exit status of sqlite3
+            }
+            else {
+                g_warning("sqlite3 returned %d dumping from %s to %s", rc, in.data(), out.data());
+            }
+        }
+	}
+	else {
+		g_warning("ERROR formatting command");
+		rc = ENOMEM;	// Most likely the cause of failure
+	}
+
+	return rc;
+}
+
+/**
+ * Drop all data in this database.
+ */
+int SQLiteDatabase::dropAll()
+{
+	if (!isOpen()) {
+		return SQLITE_CANTOPEN;
+	}
+	
+	assert(!m_dbPath.isEmpty());
+	int	rc(SQLITE_OK);
+
+	close();
+
+	if (0 != ::unlink(m_dbPath.utf8().data())) {
+		rc = errno;
+	}
+
+	if (SQLITE_OK == rc) {
+		if (!open(m_dbPath, DontValidateDatabase)) {
+			rc = SQLITE_CANTOPEN;
+		}
+	}
+
+	return rc;
+}
+
+int SQLiteDatabase::import(const String& inCmdFile, const String& outSqlFile)
+{
+	int	rc(0);
+	char* cmd(NULL);
+	CString in = inCmdFile.utf8();
+	CString out = outSqlFile.utf8();
+
+	if (access(out.data(), R_OK) == 0) {
+		if (0 != ::unlink(out.data())) {
+			return errno;
+		}
+	}
+
+	// TODO This is a hacky implementation that starts another process. We need to use
+	// the sqlite API to do this in this process.
+	if (asprintf(&cmd, "/usr/bin/sqlite3 \"%s\" < \"%s\"", out.data(), in.data()) > 0) {
+		rc = ::system(cmd);
+		::free(cmd);
+
+        if (rc >= 0) {
+            if (WIFEXITED(rc)) {
+                rc = WEXITSTATUS(rc);   // return the exit status of sqlite3
+				// rc is now a sqlite error code (i.e. SQLITE_ERROR, etc.)
+            }
+            else {
+                g_warning("sqlite3 returned %d importing from %s to %s", rc, in.data(), out.data());
+            }
+        }
+	}
+	else {
+		g_warning("ERROR formatting command");
+		rc = 1;
+	}
+
+	return rc;
+}
+
+int SQLiteDatabase::import(const String& inCmdFile)
+{
+	if (!isOpen()) {
+		return SQLITE_CANTOPEN;
+	}
+
+	close();
+
+	int rc = import(inCmdFile, m_dbPath);
+	if (0 == rc) {
+		if (!open(m_dbPath)) {
+			rc = SQLITE_CANTOPEN;
+		}
+	}
+	
+	return rc;
+}
+
+/**
+ * Backup this database to a new sqlite3 database on disk. The output format will be
+ * a sqlite database file (not a dump file).
+ *
+ * @param filename the path to the backup database that will be created.
+ * @return Zero if successful, non-zero on error (errno).
+ */
+int SQLiteDatabase::backup(const String& filename)
+{
+	// sqlite backup API introduced in version 3.6.11
+#if SQLITE_VERSION_NUMBER >= 3006011
+	
+	const int k_BackupPageQuantum = 5;
+	int      rc(SQLITE_ERROR);
+	sqlite3* pBackupFile(NULL);
+	sqlite3_backup* pBackupObj(NULL);
+
+	CString str = filename.utf8();
+	const char* const zFilename = str.data();
+	if (access(zFilename, R_OK) == 0) {
+		if (0 != ::unlink(zFilename)) {
+			return errno;
+		}
+	}
+	rc = sqlite3_open(zFilename, &pBackupFile);
+	if( rc==SQLITE_OK ) {
+
+		pBackupObj = sqlite3_backup_init(pBackupFile, "main", m_db, "main");
+		if( pBackupObj ) {
+
+			// TODO We need to run this in a separate thread when it gets 
+			// plugged into WebKit.
+			do {
+				rc = sqlite3_backup_step(pBackupObj, k_BackupPageQuantum);
+				if( rc==SQLITE_OK || rc==SQLITE_BUSY || rc==SQLITE_LOCKED ) {
+					sqlite3_sleep(250);
+				}
+			} while( rc==SQLITE_OK || rc==SQLITE_BUSY || rc==SQLITE_LOCKED );
+
+			(void)sqlite3_backup_finish(pBackupObj);
+		}
+		rc = sqlite3_errcode(pBackupFile);
+	
+		(void)sqlite3_close(pBackupFile);
+	}
+
+	return rc;
+	
+#else
+
+	printf("Backup not supported in this version of sqlite\n");
+	return SQLITE_ERROR;
+
+#endif	
+}
+
+/**
+ * Run an integrity check on the database.
+ *
+ * @return true if the database is OK, false if not.
+ */
+bool SQLiteDatabase::verifyDbIntegrity()
+{
+	String query = "PRAGMA quick_check;";
+    Vector<String> results;
+    if (SQLiteStatement(*this, query).returnTextResults(0, results)) {
+		return results.size() == 1 && results[0] == "ok";
+	}
+	else {
+        LOG(SQLDatabase, "Unable to verify integrity of database.");
+		if (lastError() == SQLITE_BUSY) {
+			// If the we get SQLITE_BUSY when checking db integrity then this means that
+			// somebody else has it open so they've already passed the integrity check.
+        	LOG(SQLDatabase, "Database was busy, assuming it is ok.");
+			return true;
+		}
+		else {
+			// If I couldn't run the integrity check - the db's corrupt.
+        	LOG(SQLDatabase, "Couldn't run integrity check.");
+			return false;
+		}
+    }
+}
+
