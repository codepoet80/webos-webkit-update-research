+void PluginView::getScreenSize(int& width, int& height)
+{
+    width = PalmBrowserSettings()->browserViewWidth;
+    height = PalmBrowserSettings()->browserViewHeight;
+    
+    Palm::WebView* view = static_cast<ScrollView*>(parent())->containingWindow();
+    if (!view)
+        return;
+    
+    Palm::WebViewClient* viewClient = view->client();
+    if (!viewClient) 
+        return;
+    
+    viewClient->getScreenSize(width, height);
+    return;
+}
