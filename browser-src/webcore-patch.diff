+struct PGContextStateBase {
+
+	void reset() {
+		strokeWidth = 1.0f;
+		strokeStyle = PGContextIface::SolidStroke;
+		strokeColor = PColor32(0, 0, 0);
+		fillColor = PColor32(0x00, 0x00, 0x00);
+		lineCap = PButtCap;
+        lineJoin = PMiterJoin;
+        miterLimit = 10.0f;
+		fillOpacity = 0xFF;
+		strokeOpacity = 0xFF;
+		compRule = PSrcOverMode;
+
+		matrix.Identity();
+        Extended = false;
+        Matrix[0][0] = Matrix[1][1] = Matrix[2][2] = 1.0f;
+        Matrix[0][1] = Matrix[0][2] = Matrix[1][0] = Matrix[2][0] = Matrix[1][2] = Matrix[2][1] = 0.0f;
+
+		clipRect = k_EmptyRect;
+		clipValid = false;
+
+		globalClipRect = k_EmptyRect;
+		globalClipSet = false;
+
+		currClipRect = k_EmptyRect;
+		currClipValid = false;
+
+		scale = 1.0f;
+		
+		doStroke = true;
+		doFill = true;
+	}
+
+	float strokeWidth;
+	PGContextIface::StrokeStyle strokeStyle;
+	PColor32 strokeColor;
+	PColor32 fillColor;
+	PCapRule lineCap;
+	PJoinRule lineJoin;
+    PValue miterLimit;
+	uint8_t fillOpacity;
+	uint8_t strokeOpacity;
+	PCompRule compRule;
+
+	PMatrix3D matrix;
+    float Matrix[3][3];     /// HAAAAAAAAAAAAAAAACK
+    bool Extended;
+
+	PRect clipRect;
+	bool clipValid;
+
+	PRect globalClipRect;
+	bool globalClipSet;
+
+	PRect currClipRect;
+	bool currClipValid;
+
+	float scale;
+
+	bool doStroke;
+	bool doFill;
+};
+
+struct PGContextState : public PGContextStateBase
+{
+	PGPath clipPath;
+	bool clipPathValid;
+
+	PGContextState()
+	{
+		reset();
+	}
+	
+	void reset()
+	{
+		PGContextStateBase::reset();
+		clipPathValid = false;
+	}
+
+	PGContextState& operator=(const PGContextState& State)
+	{
+		if (&State != this) {
+			*(PGContextStateBase*)this = State;
+			
+			// Only copy if necessary
+			clipPathValid = State.clipPathValid;
+			if (State.clipPathValid) {
+				clipPath = State.clipPath;
+			}
+		}
+		return *this;
+	}
+};
+
+static PRect intersectRects(const PRect& r1, const PRect& r2) {
+
+	if (!r1.Intersects(r2))
+		return r1;
+
+	int l = MAX(r1.Start.X, r2.Start.X);
+	int t = MAX(r1.Start.Y, r2.Start.Y);
+	int r = MIN(r1.End.X, r2.End.X);
+	int b = MIN(r1.End.Y, r2.End.Y);
+
+	return PRect(l, t, r, b);
+}
