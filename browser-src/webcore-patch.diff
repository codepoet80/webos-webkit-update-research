+
+void Path::addQuadCurveTo(const FloatPoint& controlPoint, const FloatPoint& point)
+{
+    m_path->enableRectHitDetect(false);
+
+    // Inspired by Path::addQuadCurveTo() in PathCairo.cpp.
+
+    const float x0 = currentPoint().x();
+    const float y0 = currentPoint().y();
+
+    const float x1 = controlPoint.x();
+    const float y1 = controlPoint.y();
+
+    const float x2 = point.x();
+    const float y2 = point.y();
+
+    FloatPoint control1(x0 + 2.0 / 3.0 * (x1 - x0),
+                        y0 + 2.0 / 3.0 * (y1 - y0));
+
+    FloatPoint control2(x2 + 2.0 / 3.0 * (x1 - x2),
+                        y2 + 2.0 / 3.0 * (y1 - y2));
+
+    m_path->bezierTo(control1, control2, point);
+}
