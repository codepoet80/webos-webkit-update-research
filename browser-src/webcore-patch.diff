+PGSurface* PGSurface::create(uint32_t width, uint32_t height, bool hasAlpha,
+							 const unsigned char* pixelData)
+{
+	PGContextIface* ctxt = PGThreadGlobalContext::instance()->graphicsContext();
+	PGSurface* surf = ctxt->createSurface(width, height, hasAlpha, pixelData);
+	
+	return surf;
+}
+
+PGSurface* PGSurface::wrap(uint32_t width, uint32_t height, const unsigned char* pixelData, bool hasAlpha )
+{
+	PGContextIface* ctxt = PGThreadGlobalContext::instance()->graphicsContext();
+	PGSurface* surf = ctxt->wrapBitmapData(width, height, hasAlpha, pixelData);
+    if (!surf)
+        return create(width, height, hasAlpha, pixelData);
+	surf->m_context = ctxt;
+
+	return surf;    
+}
