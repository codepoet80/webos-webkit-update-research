+String FontPlatformData::mappedFamilyName(const FontDescription& fontDescription, const AtomicString& familyName)
+{
+
+    return FontCatalog::instance()->select( familyName.string(),
+                    fontDescription.genericFamily(),
+                    ( ( fontDescription.weight() >= FontWeightBold ) ?  FontCatalog::bold : 0 ) |
+                    ( fontDescription.italic() ? FontCatalog::italic : 0 ) );
+}
+
+
+FontPlatformData::FontPlatformData(const FontDescription& fontDescription, const String& familyName)
+    : m_font(0)
+	, m_fontDescription(fontDescription)
+{
+    FontPlatformData::init();
+
+    // The font family specifier will be an array of names provided by
+    // the CSS. We want select the font based on the first hit we get.
+    CString utf8FamilyName = familyName.utf8();
+    m_font = PGFont::createFromFile(utf8FamilyName.data(), (int)fontDescription.computedPixelSize());
+
+    if (m_font)
+        m_font->setClampWidth(!PalmBrowserSettings()->runningInBrowserServer);
+}
+
+FontPlatformData::FontPlatformData(float size, bool bold, bool italic)
+    : m_font(0)
+{
+    m_fontDescription.setSpecifiedSize(size);
+    m_fontDescription.setWeight(FontWeightBold);
+    m_fontDescription.setItalic(italic);
+}
+
+FontPlatformData::FontPlatformData(PGFont* fontFace, int size, bool bold, bool italic)
+{
+    m_font = fontFace;
+	
+    if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+		m_font->addRef();
+}
+
+FontPlatformData::FontPlatformData(const FontPlatformData& f)
+	: m_fontDescription(f.m_fontDescription)
+{
+    m_font = f.m_font;
+    if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+        m_font->addRef();
+}
+
+FontPlatformData& FontPlatformData::operator=(const FontPlatformData& f)
+{
+	if (this != &f) {
+
+		if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+			m_font->releaseRef();
+		
+        m_fontDescription = f.m_fontDescription;
+        m_font            = f.m_font;
+
+        if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+            m_font->addRef();
+    }
+
+    return *this;
+}
+
+
+bool FontPlatformData::init()
+{
+    static bool initialized = false;
+    if (initialized)
+        return true;
+
+	FontCatalog::instance();
+	
+    initialized = true;
+    return true;
+}
+
+FontPlatformData::~FontPlatformData()
+{
+	if( m_font && m_font != reinterpret_cast<PGFont*>(-1) )
+		m_font->releaseRef();
+}
+
+bool FontPlatformData::isFixedPitch()
+{
+    if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+        return m_font->isFixedPitch();
+    else
+        return false;
+}
+
+void FontPlatformData::setFont(PGContext* gc) const
+{
+    if (m_font && m_font != reinterpret_cast<PGFont*>(-1)) 
+        gc->setFont(m_font);
+}
+
+bool FontPlatformData::operator==(const FontPlatformData& other) const
+{
+	if( m_font == other.m_font )
+		return true;
+
+    // non-created or deleted font?
+    if (m_font == 0 || m_font == reinterpret_cast<PGFont*>(-1) ||
+        other.m_font == 0 || other.m_font == reinterpret_cast<PGFont*>(-1))
+        return false;
+	
+	if( m_font && other.m_font )
+		return (*m_font == *( other.m_font ));
+	
+	return false;
+}
+
+#ifndef NDEBUG
+String FontPlatformData::description() const
+{
+    return String();
+}
+#endif
+
+}
