+/**
+ * Constructor.
+ */
+PluginInstanceData::PluginInstanceData(PluginPackage* plugin, const String& mimeType, Frame* frame) : 
+	m_plugin(plugin)
+	,m_mimeType(mimeType)
+    ,m_cacheInstanceData(::PalmBrowserSettings()->cachePluginsInDOM)
+	,m_haveInitialized(false)
+#if PLATFORM(WEBOS)
+    ,m_sendRaster(true)
+    ,m_client(0)
+    ,m_isInteractive(false)
+    ,m_haveCalledDestroy(false)
+#endif
+	,m_platformStarted(false)
+	,m_pluginStatus(PluginStatusLoadedSuccessfully)
+	,m_elementDeleting(false)
+	,m_viewDeleted(false)
+	,m_frame(frame)
+{
+	m_instance.ndata = NULL;
+	m_instance.pdata = NULL;
+#if PLATFORM(WEBOS)
+	PluginView::addToPluginsByFrame(frame, this);
+#endif
+}
+
+/**
+ * Destructor.
+ */
+PluginInstanceData::~PluginInstanceData()
+{
+	NPSavedData* savedData = 0;
+	if( m_plugin )
+	{
+        NPError npErr = pluginDestroy(&m_instance, &savedData);
+		LOG_NPERROR(npErr);
+	}
+
+#if ENABLE(NETSCAPE_PLUGIN_API)	
+    if (savedData) {
+		// TODO: Actually save this data instead of just discarding it
+        if (savedData->buf)
+            NPN_MemFree(savedData->buf);
+        NPN_MemFree(savedData);
+    }
+#endif
+
+	if (m_plugin && !(m_plugin->quirks().contains(PluginQuirkDontUnloadPlugin))) {
+        m_plugin->unload();
+        m_plugin = 0;
+	}
+
+#if PLATFORM(WEBOS)
+	PluginView::removeFromPluginsByFrame(m_frame, this);
+#endif
+}
+
+PluginStatus PluginInstanceData::init(void)
+{
+    if (m_haveInitialized)
+        return m_pluginStatus;
+
+    m_haveInitialized = true;
+	if (!m_plugin) {
+		m_pluginStatus = PluginStatusCanNotFindPlugin;
+		return m_pluginStatus;
+    }
+
+    LOG(Plugins, "PluginInstanceData::init(): Initializing plug-in '%s'", m_plugin->name().utf8().data());
+
+    if (!m_plugin->load()) {
+        m_plugin = 0;
+        m_pluginStatus = PluginStatusCanNotLoadPlugin;
+		return m_pluginStatus;
+    }
+
+	m_pluginStatus = PluginStatusLoadedSuccessfully;
+	return m_pluginStatus;
+}
+
+// PluginInstanceData::pluginDestroy ensures that the plugin's destroy
+// function is only called one time.  As a consequence of the Plugin
+// Caching implementation in webOS, it was observed that a plugin's destroy
+// function was being called twice: once in PluginView::stop and also in
+// PluginInstanceData::~PluginInstanceData.  It is feared that some plugins
+// may misbehave if their destroy function is called more than once leading to
+// crashes and other unexpected behavior.
+NPError PluginInstanceData::pluginDestroy(NPP instance, NPSavedData** save)
+{
+    if (m_haveCalledDestroy)
+        return NPERR_NO_ERROR;
+
+    if (!instance || !save)
+        return NPERR_INVALID_PARAM;
+
+    if (!m_plugin)
+        return NPERR_INVALID_INSTANCE_ERROR;
+
+
+    m_haveCalledDestroy = true;
+    return m_plugin->pluginFuncs()->destroy(instance, save);
+}
+
+HashMap<Frame*, PluginInstanceSet*> PluginView::s_PluginInstanceMap;
+
+void PluginView::addToPluginsByFrame(Frame* frame, PluginInstanceData* inst)
+{
+	ASSERT(frame);
+	ASSERT(inst);
+
+	PluginInstanceSet* instances = s_PluginInstanceMap.get(frame);
+	if (!instances) {
+		instances = new PluginInstanceSet;
+		s_PluginInstanceMap.set(frame, instances);
+	}
+
+	if (instances->contains(inst))
+		return;
+
+	instances->add(inst);
+}
+
+void PluginView::removeFromPluginsByFrame(Frame* frame, PluginInstanceData* inst)
+{
+	ASSERT(frame);
+	ASSERT(inst);
+
+	PluginInstanceSet* instances = s_PluginInstanceMap.get(frame);
+	if (!instances || !instances->contains(inst))
+		return;
+
+	instances->remove(inst);
+	if (instances->isEmpty()) {
+		s_PluginInstanceMap.remove(frame);
+		delete instances;
+	}
+}
+
+void PluginView::detachPlugins(Frame* frame)
+{
+	PluginInstanceSet* instances = s_PluginInstanceMap.get(frame);
+	if (!instances)
+		return;
+
+	s_PluginInstanceMap.remove(frame);
+	PluginInstanceSet::const_iterator end = instances->end();
+	for (PluginInstanceSet::const_iterator it = instances->begin(); it != end; ++it) {
+        PluginView::frameDeleted(*it);
+	}
+	
+	delete instances;
+}
+
