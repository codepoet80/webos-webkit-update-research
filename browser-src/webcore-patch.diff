+static void init_buffer (j_compress_ptr cinfo)
+{
+}
+/* what to do when the buffer is full; this should almost never
+ * happen since we allocated our buffer to the surface dimensions
+ */
+static boolean empty_buffer (j_compress_ptr cinfo)
+{
+  return TRUE;
