+/**
+ * Dump this <strong>open</strong> database to an SQL dump file.
+ */
+int Database::dump(const String& dumpFile, PassRefPtr<DatabaseWatcher> watcher)
+{
+	MutexLocker locker(m_dumpInProgressMutex);
+    if (!m_dumpInProgress) {
+        scheduleDump(dumpFile, watcher);
+		return 0;
+	}
+	else {
+		LOG_ERROR("Dump already in progress.");
+		return EALREADY;
+	}
+}
+
+/**
+ * Dump this <strong>open</strong> database to an SQL dump file.
+ */
+int Database::dump(const String& dumpFile)
+{
+	LOG(StorageAPI, "Doing HTML5 database dump.");
+	char	tempFileName[48];
+	strncpy(tempFileName, "/tmp/dbbackup-XXXXXX", sizeof(tempFileName));
+	int fd = mkstemp(tempFileName);
+	if (-1 == fd) {
+		return errno;
+	}
+	::close(fd);
+
+	String	sqlBackup(tempFileName);
+	int rc = sqliteDatabase().backup(sqlBackup);
+	if (0 == rc) {
+		rc = SQLiteDatabase::dump(sqlBackup, dumpFile);
+	}
+	else {
+		LOG_ERROR("Error backing up to '%s'", dumpFile.ascii().data());
+	}
+
+	::unlink(tempFileName);
+
+	return rc;
+}
+
+int Database::dump(const String& dbFile, const String& dumpFile)
+{
+	return SQLiteDatabase::dump(dbFile, dumpFile);
+}
+
+/**
+ * Restore this database from a SQL dump file.
+ */
+int Database::restore(const String& dumpFile)
+{
+	return sqliteDatabase().import(dumpFile);
+}
+
+int Database::restore(const String& dumpFile, const String& dbFile)
+{
+	return SQLiteDatabase::import(dumpFile, dbFile);
+}
+
+int Database::getTotalChanges(int& numTotalChanges)
+{
+	return sqliteDatabase().getTotalChanges(numTotalChanges);
+}
+
+void Database::scheduleDump(const String& dumpFile, PassRefPtr<DatabaseWatcher> watcher)
+{
+	LOG(StorageAPI, "Scheduling a database dump to \"%s\".", dumpFile.utf8().data());
+	ASSERT(!m_dumpInProgressMutex.tryLock()); // Locked by caller.
+    RefPtr<SQLDump> dump = SQLDump::create(this, NULL, NULL, NULL, NULL);
+	dump->setDumpFile(dumpFile);
+	dump->setWatcher(watcher);
+    //if (m_document->databaseThread())
+    if( scriptExecutionContext()->databaseThread() )
+    {
+    	DatabaseTaskSynchronizer synchronizer;
+        OwnPtr<DatabaseDumpTask> task = DatabaseDumpTask::create(dump,&synchronizer);
+        LOG(StorageAPI, "Scheduling DatabaseDump %p for dump %p\n", task.get(), task->dump());
+        m_dumpInProgress = true;
+        scriptExecutionContext()->databaseThread()->scheduleTask(task.release());
+    } else {
+        m_dumpInProgress = false;
+		watcher->dumpStopped(EALREADY);
+	}
+}
+
+// background dump of database is complete
+void Database::mainDumpCallback(void* context)
+{
+    SQLDump* dump = static_cast<SQLDump*>(context);
+
+	RefPtr<DatabaseWatcher> watcher = dump->getWatcher();
+	int status = dump->getDumpStatus();
+
+	dump->database()->m_dumpInProgress = false;
+
+	if (watcher) {
+		watcher->dumpStopped(status);
+	}
+    
+	dump->deref(); // Was ref'd in scheduleDumpCallback().
+}
+
+// Database thread has finished the dump.
+void Database::dumpCallback(SQLDump* dump)
+{
+	// Marshal this to the main thread to be handled.
+    dump->ref();
+    callOnMainThread(mainDumpCallback, dump);
+}
