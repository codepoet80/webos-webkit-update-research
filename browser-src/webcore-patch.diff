+bool PluginView::dispatchNPEvent(NPEvent event)
+{
+    VERBOSE_TRACE("event(0x%08x) = %s", (unsigned int) event, NpPalmEventType_to_s((NpPalmEventType *) event));
+
+    if (!plugin() || !plugin()->pluginFuncs() || !plugin()->pluginFuncs()->event) {
+        return false;
+    }
+
+    PluginView::setCurrentPluginView(this);
+	
+#if USE(JSC)
+    JSC::JSLock::DropAllLocks dropAllLocks(JSC::SilenceAssertionsOnly);
+#endif	
+    setCallingPlugin(true);
+    bool accepted = plugin()->pluginFuncs()->event(instance(), event);
+    VERBOSE_TRACE("accepted = %s", accepted ? "true" : "false");
+    setCallingPlugin(false);
+	
+    PluginView::setCurrentPluginView(0);
+    return accepted;
+}
