+AuthenticationHandler::AuthenticationHandler(CredentialsCache* cache, CurlHandle* job)
+    : m_cache(cache)
+    , m_chandle(job)
+    , m_cancelled(false)
+    , m_realmBasedAuthHeaderAdded(false)
+    , m_pathBasedAuthHeaderAdded(false)
+    , m_authHeaderAddded(false)
+    , m_ntlmState(NtlmStateNone)
+{
+
+}
