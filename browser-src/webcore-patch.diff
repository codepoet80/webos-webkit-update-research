+void GraphicsContext::drawLineForText(const IntPoint& origin, int width, bool printing)
+{
+    if (paintingDisabled())
+        return;
+
+    // This is a workaround for http://bugs.webkit.org/show_bug.cgi?id=15659
+    StrokeStyle savedStrokeStyle = strokeStyle();
+    setStrokeStyle(SolidStroke);
+
+    IntPoint endPoint = origin + IntSize(width, 0);
+    drawLine(origin, endPoint);
+
+    setStrokeStyle(savedStrokeStyle);
+}
+
+void GraphicsContext::drawLineForMisspellingOrBadGrammar(const IntPoint& origin, int width, bool grammar)
+{
+	if (paintingDisabled())
+		return;
+
+    static const Color mispellingColor(255, 90, 0);
+    static const Color grammarColor(0, 167, 0);
+    static const float mispellingThickness(3.0);
+
+    Color prevColor(strokeColor());
+    float prevThickness(strokeThickness());
+    StrokeStyle prevStyle(strokeStyle());
+
+    setStrokeColor(grammar ? grammarColor : mispellingColor, sRGBColorSpace );
+    setStrokeThickness(mispellingThickness);
+    setStrokeStyle(DottedStroke);
+
+    IntPoint endPoint = origin + IntSize(width, 0);
+    drawLine(origin, endPoint);
+
+    setStrokeColor(prevColor, sRGBColorSpace);
+    setStrokeThickness(prevThickness);
+    setStrokeStyle(prevStyle);
+}
