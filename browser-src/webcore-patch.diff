+
+    class PluginCacheListener : public EventListener {
+
+    public:
+
+        static PassRefPtr<PluginCacheListener> create(PluginInstanceCache* cache, Element* eventBase) {
+            ASSERT(::PalmBrowserSettings()->cachePluginsInDOM);
+            RefPtr<PluginCacheListener> listener = adoptRef(new PluginCacheListener(cache, eventBase));
+            listener->registerListener();
+            return listener.release();
+        }
+
+        static const PluginCacheListener* cast(const EventListener* listener) {
+            return listener->type() == ConditionEventListenerType
+                ? static_cast<const PluginCacheListener*>(listener)
+                : NULL;
+        }
+
+        virtual bool operator==(const EventListener& listener) {
+            if (const PluginCacheListener* pluginEventListener = PluginCacheListener::cast(&listener))
+                return m_cache == pluginEventListener->m_cache;
+            else
+                return false;
+        }
+
+        /**
+         * Called when a DOMNodeRemovedFromDocumentEvent fires on one of the
+         * elements we are observing.
+         */
+        virtual void handleEvent(ScriptExecutionContext* ,Event* event) {
+            Node* node = event->target()->toNode();
+            HashMap<Element*, PluginCacheItem>::iterator i = m_cache->m_items.find(static_cast<Element*>(node));
+            if (i != m_cache->m_items.end()) {
+                PluginCacheItem item = (*i).second;
+                if (item.data->isViewDeleted()) {
+                    // The view was deleted *before* it's element was so delete the instance data
+                    // and remove from the cache.
+                    delete item.data;
+                    m_cache->m_items.remove(i);
+                }
+                else {
+                    // The view still exists so mark the fact that the element is deleted
+                    // so that this data can be removed later.
+                    item.data->setElementDeleting();
+                }
+            }
+        }
+
+        void unregister() {
+            // If this has only one ref then the event base is dead already and we don't need to remove ourself.
+            if (!hasOneRef())
+                m_eventBase->removeEventListener(eventNames().DOMNodeRemovedFromDocumentEvent, this, true /*capture*/);
+        }
+
+        void registerListener() {
+            ASSERT(::PalmBrowserSettings()->cachePluginsInDOM);
+            m_eventBase->addEventListener(eventNames().DOMNodeRemovedFromDocumentEvent, this, true /*capture*/);
+        }
+
+        private:
+        PluginInstanceCache* m_cache;
+        Element* m_eventBase;
+
+        PluginCacheListener(PluginInstanceCache* cache, Element* eventBase) 
+            : EventListener(ConditionEventListenerType)
+              , m_cache(cache)
+              , m_eventBase(eventBase)
