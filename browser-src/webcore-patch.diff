+            m_origRepeatInterval = repeatInterval();
+        }
+
+        bool wasActive = isActive();
+
+        // Stop the present timer.
+        if (wasActive)
+            stop();
+
+        // Set the new throttle level.
+        m_throttleLevel = throttleLevelFrom0To100Percent;
+
