+     * through all of the items in the hash rather than simply looking it up by
+     * the key.
+     * @return true if removed from the list, false if not.
+     */
+    bool remove(PluginInstanceData* instance) {
+        HashMap<Element*, PluginCacheItem>::iterator i = m_items.begin();
+        for (; i != m_items.end(); ++i) {
+            if (i->second.data == instance) {
+                i->second.listener->unregister();
+                i->second.listener = 0;
+                m_items.remove(i);
+                return true;
+            }
+        }
+        return false;
+    }
+
+private:
+
+    HashMap<Element*, PluginCacheItem> m_items; ///< The plugin instances to reuse or delete.
+};
