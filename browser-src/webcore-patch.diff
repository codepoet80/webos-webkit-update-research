+bool EventHandler::handleGestureEvent(Palm::GestureEventType type, int fx, int fy, float rotation, float scale,
+	int centerX, int centerY, bool shiftKey, bool ctrlKey, bool altKey, bool metaKey)
+{
+	bool handled = false;
+    Document* doc = m_frame->document();
+    if (!doc)
+        return handled;
+
+    RenderObject* docRenderer = doc->renderer();
+    if (!docRenderer)
+        return handled;
+
+	IntPoint pt(fx, fy);
+	IntPoint vPoint = m_frame->view()->windowToContents(pt);
+
+	HitTestRequest request(HitTestRequest::ReadOnly);
+	HitTestResult result(vPoint);
+	doc->renderer()->enclosingLayer()->hitTest(request, result);
+	Node* node = result.innerNode();
+	if( !node )
+		return handled;
+
+	RefPtr<EventTarget> evtTarget = node;
+
+	AtomicString eventName;
+	switch(type) {
+		case Palm::GestureStart:
+			eventName = eventNames().gesturestartEvent;
+			break;
+		case Palm::GestureChange:
+			eventName = eventNames().gesturechangeEvent;
+			break;
+		case Palm::GestureEnd:
+			eventName = eventNames().gestureendEvent;
+			break;
+		case Palm::GestureSingleTap:
+			eventName = eventNames().singletapEvent;
+			break;
+		default:
+			return handled;
+	}
+
+	RefPtr<Event> ge = GestureEvent::create(
+			/* eventname */ eventName,
+			/* bubble */ true,
+			/* cancelable */ true,
+			/* view */m_frame->document()->defaultView(),
+			/* detail */ 0,
+			/* screenX */ vPoint.x(),
+			/* screenY */ vPoint.y(),
+			/* pageX */ vPoint.x(),
+			/* pageY */ vPoint.y(),
+			/* ctrlKey */ ctrlKey,
+			/* altKey */ altKey,
+			/* shiftKey */ shiftKey,
+			/* metaKey */ metaKey,
+			/* scale */ scale,
+			/* rot */ rotation,
+			/* centerX */ centerX,
+			/* centerY */ centerY,
+			/* EventTarget */ evtTarget->toNode(),
+			/* clipboard */ 0,
+			/* isSimulated */ false );
+	
+	ExceptionCode ec;
+	evtTarget->dispatchEvent( ge, ec );
+	handled |= ge->defaultHandled() || ge->defaultPrevented();
+
+	return handled;
+}
+
+bool EventHandler::dispatchShakeEvent(const AtomicString& shakeEventName,
+                                      const float shakeMagnitude,
+                                      const uint32_t time)
+{
+
+    Document* doc = m_frame->document();
+    if (!doc)
+        return false;
+
+    RefPtr<EventTarget> target = doc;
+
+    ExceptionCode ec;
+
+    RefPtr<Event> event = ShakeEvent::create(
+            shakeEventName,
+            false, // bubble
+            true,  // cancelable
+            doc->defaultView(),        // view
+            0,                         // detail
+            shakeMagnitude,
+            time);
+
+    target->dispatchEvent(event, ec);
+
+    bool handled = event->defaultHandled() || event->defaultPrevented();
+
+    return handled;
+}
+
+bool EventHandler::dispatchAccelerationEvent(const float accelX,
+                                             const float accelY,
+                                             const float accelZ,
+                                             const uint32_t time)
+{
+
+    Document* doc = m_frame->document();
+    if (!doc) {
+        return false;
+    }
+
+    RefPtr<EventTarget> target = doc;
+
+    ExceptionCode ec;
+
+    RefPtr<Event> event = AccelerationEvent::create(
+            eventNames().accelerationEvent,
+            false, // bubble
+            true,  // cancelable
+            doc->defaultView(),        // view
+            0,                         // detail
+            accelX, accelY, accelZ,    // acceleration
+            time);
+
+    target->dispatchEvent(event, ec);
+
+    bool handled = event->defaultHandled() || event->defaultPrevented();
+
+    return handled;
+}
+
+bool EventHandler::dispatchCompassEvent(const float magHeading,
