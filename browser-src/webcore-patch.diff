+DeviceMotionProviderPalm::DeviceMotionProviderPalm(Palm::WebPage* page)
+    : m_SensorHandle(0)
+    , m_SensorDeletefn(0)
+    , m_WebPage(page)
+    , m_controller(0)
+    , m_SensorRunning(false)
+    , m_motion(DeviceMotionData::create())
+{
+}
