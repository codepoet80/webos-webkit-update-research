+
+#include "PGThreadGlobalContext.h"
+
+#include <unistd.h>
+#include <stdio.h>
+#include "PGContext.h"
+#include "PGFallbackFonts.h"
+
+static GPrivate* s_threadPrivateContextKey = NULL;
+
+static gpointer PrvInitalizedThreadKeys(gpointer)
+{
+	s_threadPrivateContextKey = g_private_new(NULL);
+	return NULL;
+}
+
+
+PGThreadGlobalContext* PGThreadGlobalContext::instance()
+{
+	// Initialize the thread specific private keys only once during
+	// the program lifetime
+	static GOnce once = G_ONCE_INIT;
+	g_once(&once, PrvInitalizedThreadKeys, NULL);
+
+	// Did we already create a thread specific global context?
+	PGThreadGlobalContext* c = (PGThreadGlobalContext*) g_private_get(s_threadPrivateContextKey);
+	if (!c) {
+		c = new PGThreadGlobalContext();
+		g_private_set(s_threadPrivateContextKey, c);
+		//printf("%d: PGThreadGlobalContext::instance(): %p\n", getpid(), c);
+
+		c->m_fallbackFonts = new PGFallbackFonts();
+		PGFallbackFonts::setThreadSpecificInstance(c->m_fallbackFonts);
+	}
+
+	return c;
+}
+
+PGThreadGlobalContext::PGThreadGlobalContext()
+	: m_gc(0)
+    , m_fallbackFonts(0)
+{    
+}
+
+PGThreadGlobalContext::~PGThreadGlobalContext()
+{    
+    if (m_gc)
+        m_gc->releaseRef();
+
+    delete m_fallbackFonts;
+}
+
+PGContextIface* PGThreadGlobalContext::graphicsContext()
+{
+    if (!m_gc)
+		m_gc = PGContext::create();
+
+	return m_gc;
+}
+
+void PGThreadGlobalContext::setGraphicsContext(PGContextIface* iface)
+{
+	if (m_gc)
+		m_gc->releaseRef();
+	
+	m_gc = iface;    
+}
