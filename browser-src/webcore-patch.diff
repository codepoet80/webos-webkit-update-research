+    else if (eventType == eventNames().webkitAnimationStartEvent)
+        listenerType = ANIMATIONSTART_LISTENER;
+    else if (eventType == eventNames().webkitAnimationEndEvent)
+        listenerType = ANIMATIONEND_LISTENER;
+    else if (eventType == eventNames().webkitAnimationIterationEvent)
+        listenerType = ANIMATIONITERATION_LISTENER;
+    else if (eventType == eventNames().webkitTransitionEndEvent)
+        listenerType = TRANSITIONEND_LISTENER;
+    else if (eventType == eventNames().beforeloadEvent)
+        listenerType = BEFORELOAD_LISTENER;
+    else if (eventType == eventNames().beforeprocessEvent)
+        listenerType = BEFOREPROCESS_LISTENER;
+    else if (eventType == eventNames().orientationchangeEvent)
+        listenerType = ORIENTATIONCHANGE_LISTENER;
+    else if (eventType == eventNames().compassEvent)
+        listenerType = COMPASS_LISTENER;
+    else if (eventType == eventNames().shakestartEvent ||
+             eventType == eventNames().shakingEvent ||
+             eventType == eventNames().shakeendEvent)
+        listenerType = SHAKE_LISTENER;
+    else if (eventType == eventNames().accelerationEvent)
