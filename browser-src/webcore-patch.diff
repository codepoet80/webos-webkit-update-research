+#if ENABLE(IMAGE_DECODER_DOWN_SAMPLING)
+static void adjustSourceRectForDownSampling(FloatRect& srcRect, const IntSize& origSize, const IntSize& scaledSize)
+{
+    // We assume down-sampling zoom rates in X direction and in Y direction are same.
+    if (origSize.width() == scaledSize.width())
+        return;
+
+    // Image has been down sampled.
+    double rate = static_cast<double>(scaledSize.width()) / origSize.width();
+    double temp = srcRect.right() * rate;
+    srcRect.setX(srcRect.x() * rate);
+    srcRect.setWidth(temp - srcRect.x());
+    temp = srcRect.bottom() * rate;
+    srcRect.setY(srcRect.y() * rate);
+    srcRect.setHeight(temp - srcRect.y());
+}
+#endif
+
+void BitmapImage::draw(GraphicsContext* context, const FloatRect& dst, const FloatRect& src, ColorSpace styleColorSpace, CompositeOperator op)
+{
+	// printf("Draw: %f, %f, %f, %f to %f, %f, %f, %f\n",
+	// 	   src.x(), src.y(), src.width(), src.height(),
+	// 	   dst.x(), dst.y(), dst.width(), dst.height());
+
+    //No-op for any zero-dimension, but allow drawing negative source/destination
+    if (dst.width() == 0 || dst.height() == 0 || src.width() == 0 || src.height() == 0)
+        return;
+
+	PGSurface* image = frameAtIndex(m_currentFrame);
+    if (!image) // If it's too early we won't have an image yet.
+        return;
+
+    if (mayFillWithSolidColor()) {
+        fillWithSolidColor(context, dst, solidColor(), styleColorSpace, op);
+        return;
+    }
+    /*
+    float scaleX = image->width() / src.right();
+    float scaleY = image->height() / src.bottom();
+
+    float scale = min(scaleX, scaleY);
+
+    if (scale < 1.0f) {
+        src.scale(scale);
+    }*/
+
+    FloatRect srcRectLocal(src);
+#if ENABLE(IMAGE_DECODER_DOWN_SAMPLING)
+    adjustSourceRectForDownSampling(srcRectLocal, size(), IntSize(image->width(), image->height()));
+#endif
+
+	PGContext* c = context->platformContext();
+
+	c->bitblt(image,
+               srcRectLocal.x(), srcRectLocal.y(), srcRectLocal.right(), srcRectLocal.bottom(),
+			   dst.x(), dst.y(), dst.right(), dst.bottom());
+		
+	startAnimation();
+
+    if (imageObserver())
+        imageObserver()->didDraw(this);
+}
+
+PGSurface* Image::getSurface()
+{
+	int w = width();
+	int h = height();
+	bool hasAlpha = true; // NOTE : this may not always be the case
+	
+#if P_BACKEND==P_BACKEND_GLES
+    void* bits = malloc(w * h * 4);
+    if (!bits)
+        return 0;
+
+    memset(bits, 0, w * h * 4);
+    PGSurface* s = PGSurface::create( w, h, hasAlpha , (const unsigned char*) bits );
+    free(bits);
+
+    if( !s )
+        return 0;
+#else
+    PGSurface* s = PGSurface::create( w, h, hasAlpha );
+    if( !s )
+        return 0;
+
+    memset( s->raster(), 0, s->rowbytes() * h );
+#endif
+	
+    PGContext* c = PGContext::create();
+	c->setSurface(s);
+	GraphicsContext ctx(c);
+	
+	draw( &ctx, FloatRect(0,0,w,h), FloatRect(0,0,w,h), sRGBColorSpace, CompositeSourceOver );
+	
+	c->releaseRef();
+	
+	return s;
+}
+
+void Image::drawPattern(GraphicsContext* context, const FloatRect& tileRect, const AffineTransform& patternTransform,
+                        const FloatPoint& phase, ColorSpace styleColorSpace, CompositeOperator op, const FloatRect& destRect)
+{
+    //printf("TileRect: %g:%g, %g:%g\n", tileRect.x(), tileRect.y(), tileRect.width(), tileRect.height());
+    //printf("Phase: %g, %g\n", phase.x(), phase.y());
+    //printf("DestRect: %g:%g, %g:%g\n", destRect.x(), destRect.y(), destRect.width(), destRect.height());
+    //printf("AffineTransform: %g, %g, %g, %g, %g, %g\n",
+        //patternTransform.a(), patternTransform.b(), patternTransform.c(),
+        //patternTransform.d(), patternTransform.e(), patternTransform.f());
+
+	if (tileRect.width() <= 0 || tileRect.height() <= 0) {
+		printf("Invalid tileRect specified\n");
+		return;
+	}
+
+	PGContext* c = context->platformContext();
+	PGSurface* p = nativeImageForCurrentFrame();
+
+	if (c && p) {
+
+		PGSurface* origSurf = p;
+
+		FloatRect tileRectLocal(tileRect);
+#if ENABLE(IMAGE_DECODER_DOWN_SAMPLING)
+	    adjustSourceRectForDownSampling(tileRectLocal, size(), IntSize(origSurf->width(), origSurf->height()));
+#endif
+
+		IntRect tr(enclosingIntRect(tileRectLocal));
+		if (tr.x() || tr.y() || tr.width() != (int) p->width() || tr.height() != (int) p->height()) {
+			// printf("SubSurface: %d:%d, %d:%d (%f:%f, %f:%f)\n",
+			// 	   tr.x(), tr.right(), tr.y(), tr.bottom(),
+			// 	   tileRect.x(), tileRect.right(), tileRect.y(), tileRect.bottom());
+			p = origSurf->subSurface(PRect(tr.x(), tr.y(), tr.right(), tr.bottom()));
+		}
+
+		if (!p)
+			return;
+
+		 // printf("Pattern: Phase: %f, %f, Dest: %f:%f, %f:%f, Src: %d, %d\n",
+		 //  	   phase.x(), phase.y(),
+		 //  	   destRect.x(), destRect.right(), destRect.y(), destRect.height(),
+		 //  	   p->width(), p->height());
+
+        // Apply the scale first because the scale should be applied to the tile only.
+        // It should not affect the translation. That is, translation should not be 
+        // multiplied by the tile scale.
+        PMatrix3D patternMatrix(patternTransform);
+        patternMatrix.Translate(PVertex2D(phase.x() + tr.x() - 0.5f, phase.y() + tr.y() - 0.5f));
+
+		c->push();
+
+		c->drawPattern(p, patternMatrix,
+					   destRect.x(), destRect.y(),
+					   destRect.right(), destRect.bottom());
+
+		c->pop();
+
+		if (p != origSurf)
+			p->releaseRef();
+	}
+
+    if (imageObserver())
+        imageObserver()->didDraw(this);
+}
