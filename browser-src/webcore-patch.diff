+    // instead to avoid handling divide by 0. If the user really want to
+    // throttle to 0%, he should stop the timer instead.
+    if (!throttleLevelFrom0To100Percent)
+        throttleLevelFrom0To100Percent = 1;
+
+    else if (throttleLevelFrom0To100Percent > 100)
+        throttleLevelFrom0To100Percent = 100; // Capped at 100%.
+
