+void PGContext::_bitblt(PGSurface* src,
+						int sLeft, int sTop, int sRight, int sBottom,
+						int dLeft, int dTop, int dRight, int dBottom)
+{
+	gfxLog("src: %f:%f, %f:%f dst: %f:%f, %f:%f",
+		   (float) sLeft, (float) sRight, (float) sTop, (float) sBottom,
+		   (float) dLeft, (float) dRight, (float) dTop, (float) dBottom);
+
+	int sWidth = sRight - sLeft;
+	int dWidth = dRight - dLeft;
+
+	int sHeight = sBottom - sTop;
+	int dHeight = dBottom - dTop;
+
+	int minWidth = MIN((int) sWidth, (int) dWidth);
+	int minHeight = MIN((int) sHeight, (int) dHeight);
+
+	if (minWidth == 0 || minHeight == 0)
+		return;
+
+	sRight = sLeft;
+	sRight += minWidth;
+	dRight = dLeft;
+	dRight += minWidth;
+
+	sBottom = sTop;
+	sBottom += minHeight;
+	dBottom = dTop;
+	dBottom += minHeight;
+	
+	applyState();
+
+    if (sLeft != sRight && sTop != sBottom) {
+        m_gc->DrawSubPixmap(src->m_pixmap,
+                            PVertex2D(dLeft + m_offset_x, dTop + m_offset_y), PVertex2D(dRight + m_offset_x, dBottom + m_offset_y),
+                            PVertex2D(sLeft, sTop), PVertex2D(sRight, sBottom));
+    }
+}
