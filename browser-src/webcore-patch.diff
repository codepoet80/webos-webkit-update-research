+void PluginView::setNPWindowRect(const IntRect& rect)
+{
+    if (!m_isStarted)
+        return;
+
+    IntPoint p = static_cast<FrameView*>(parent())->contentsToWindow(rect.location());
+    double scale = static_cast<ScrollView*>(parent())->getScale();
+
+    NpPalmWindow npPalmWin;
+
+    Frame* frame = Frame::frameForWidget( this );
+    if (frame) {
+		Page* page = frame->page();
+		if (page) {
+			FocusController* fc = page->focusController();
+			if (fc) {
+				npPalmWin.visible = fc->isActive();
+			}
+    	}
+	}
+
+    npPalmWin.bpp         = 32;   // FIXME
+    npPalmWin.scaleFactor = scale;
+
+    m_npWindow.window = &npPalmWin;
+
+    m_npWindow.x = p.x();
+    m_npWindow.y = p.y();
+
+    m_npWindow.width = rect.width();
+    m_npWindow.height = rect.height();
+
+    // Not valid for Palm
+    m_npWindow.clipRect.left = 0;
+    m_npWindow.clipRect.top = 0;
+    m_npWindow.clipRect.right = 0;
+    m_npWindow.clipRect.bottom = 0;
+
+    if (plugin()->pluginFuncs()->setwindow) {
+#if USE(JSC)
+        JSC::JSLock::DropAllLocks dropAllLocks(false);
+#endif		
+        setCallingPlugin(true);
+        VERBOSE_TRACE("plugin()->pluginFuncs()->setwindow(instance() = 0x%08x, m_npWindow = {x = %d, y = %d, width = %u, height = %u})",
+        		      (unsigned int) instance(), (int) m_npWindow.x, (int) m_npWindow.y, (unsigned int) m_npWindow.width, (unsigned int) m_npWindow.height);
+        plugin()->pluginFuncs()->setwindow(instance(), &m_npWindow);
+        setCallingPlugin(false);
+    }
+
+    m_npWindow.window = 0;
+}
