+void ImageBuffer::draw(GraphicsContext* destContext, ColorSpace styleColorSpace, const FloatRect& destRect, const FloatRect& srcRect,
+                       CompositeOperator op , bool useLowQualityScale)
+{
+	if (destContext == context()) 
+	{
+		RefPtr<Image> copy = copyImage();
+        destContext->drawImage(copy.get(), DeviceColorSpace, destRect, srcRect, op, useLowQualityScale);
+	} 
+	else 
+	{
+		RefPtr<Image> wrappedImage = BitmapImage::create(m_data.m_surface, 0 );
+		destContext->drawImage(wrappedImage.get(), styleColorSpace, destRect, srcRect, op, useLowQualityScale);
+	}
+}
