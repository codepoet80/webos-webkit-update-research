diff -r -u -N trunk/WebCore/platform/graphics/pg/PGFallbackFonts.cpp webkit/WebCore/platform/graphics/pg/PGFallbackFonts.cpp
--- trunk/WebCore/platform/graphics/pg/PGFallbackFonts.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGFallbackFonts.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,113 @@
+
+#include "config.h"
+
+#include "PGFallbackFonts.h"
+#include "webkitpalmsettings.h"
+#include "PGFont.h"
+
+#include <string>
+#include <pthread.h>
+#include <stdio.h>
+	
+const int kFallbackPointSize = 12;
+
+PGFallbackFonts::PGFallbackFonts()
+: m_numFonts(0)
+, m_emptyContext(0)
+{
+	init();
+}
+
+PGFallbackFonts::~PGFallbackFonts()
+{
+	for( int i=0; i< m_numFonts; i++ ) {
+		m_CjkFonts[i]->releaseRef();
+	}
+	
+	if( m_emptyContext )
+		m_emptyContext->releaseRef();
+}
+
+static pthread_key_t _tlsKey=0;
+
+/* static */ void PGFallbackFonts::setThreadSpecificInstance( PGFallbackFonts* i )
+{
+	if( !_tlsKey )	
+		pthread_key_create( &_tlsKey, 0 );
+	
+	pthread_setspecific( _tlsKey, i );
+}
+
+/* static */ PGFallbackFonts* PGFallbackFonts::threadSpecificInstance()
+{
+	if( 0 == _tlsKey ) {
+		printf( "No thread specific instace was set!\n");
+		abort();
+		return 0;
+	}
+	
+	return (PGFallbackFonts*)pthread_getspecific( _tlsKey );
+}
+
+bool PGFallbackFonts::init()
+{	
+	PGFont* font;
+
+    bool shouldClampWidth = !PalmBrowserSettings()->runningInBrowserServer;
+
+    // Chinese simplified
+    m_CjkFonts[m_numFonts] = PGFont::createFromFile( std::string( PalmBrowserSettings()->fontsPath + 
+                            std::string("HeiS_nb.ttf")).c_str(), kFallbackPointSize );
+    if( m_CjkFonts[m_numFonts] ) {
+        m_CjkFonts[m_numFonts]->setClampWidth(shouldClampWidth);
+        m_numFonts++;
+    }
+
+    // Chinese traditional
+    m_CjkFonts[m_numFonts] = PGFont::createFromFile( std::string( PalmBrowserSettings()->fontsPath + 
+                            std::string("HeiT_nb.ttf")).c_str(), kFallbackPointSize);
+    if( m_CjkFonts[m_numFonts] ) {
+        m_CjkFonts[m_numFonts]->setClampWidth(shouldClampWidth);
+        m_numFonts++;
+    }
+
+    // Japanese
+    m_CjkFonts[m_numFonts] = PGFont::createFromFile( std::string( PalmBrowserSettings()->fontsPath + 
+                            std::string("Heisei_Kaku_Gothic_nb.ttf")).c_str(), kFallbackPointSize );
+    if( m_CjkFonts[m_numFonts] ) {
+        m_CjkFonts[m_numFonts]->setClampWidth(shouldClampWidth);
+        m_numFonts++;
+    }
+
+    // Korean
+    m_CjkFonts[m_numFonts] = PGFont::createFromFile( std::string( PalmBrowserSettings()->fontsPath + 
+                            std::string("Dotum_nb.ttf")).c_str(), kFallbackPointSize );
+    if( m_CjkFonts[m_numFonts] ) {
+        m_CjkFonts[m_numFonts]->setClampWidth(shouldClampWidth);
+        m_numFonts++;
+    }
+
+	m_emptyContext = PGContext::create();
+
+	// Set override ranges for fallback fonts here (wherever we want to guarantee which fallback
+	// font is used for a particular glyph).
+	PFTRange ranges[] = {
+		{ 0x3001, 0x3002, 0 } 	// Japanese comma, period (NOV-57663).
+	};
+	m_ranges.Set(ranges, sizeof(ranges)/sizeof(ranges[0]));
+
+	if( m_numFonts ) 
+		m_emptyContext->setFallbackFonts(m_CjkFonts,m_numFonts,&m_ranges);
+	
+	//printf("PGFallbackFonts::init() -> Loaded %d CJKV fonts.\n", m_numFonts );
+	
+	return true;
+}
+
+bool PGFallbackFonts::setFallbackFontsIntoContext( PGContextIface* c )
+{
+	c->setFallbackFonts( m_CjkFonts, m_numFonts, &m_ranges );
+	return true;
+}
+
+
