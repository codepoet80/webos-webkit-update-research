+void PluginView::handleKeyboardEvent(KeyboardEvent* event)
+{
+    VERBOSE_TRACE();
+    NpPalmEventType npEvent;
+
+	//printf("PluginView::handleKeyboardEvent() key=%02x mod=%02x '%s' \n", 
+	//		event->keyEvent()->rawKeyCode(), 
+	//		event->keyEvent()->rawModifier(),
+	//		event->keyEvent()->text().utf8().data() );
+	npEvent.data.keyEvent.modifiers 	= 0;
+	npEvent.data.keyEvent.chr       	= event->keyEvent()->text()[0];
+	npEvent.data.keyEvent.rawkeyCode 	= event->keyEvent()->rawKeyCode();
+    npEvent.data.keyEvent.rawModifier	= event->keyEvent()->rawModifier();
+
+
+    if (event->type() == eventNames().keypressEvent) {
+    	npEvent.eventType = npPalmKeyPressEvent;
+    } else if (event->type() == eventNames().keydownEvent) {
+        npEvent.eventType = npPalmKeyDownEvent;
+    } else if (event->type() == eventNames().keyupEvent) {
+        npEvent.eventType = npPalmKeyUpEvent;
+    }
+
+	//printf("PluginView::handleKeyboardEvent() Sending to plugin: raw-key=%d raw-mod=%d  char=%d\n",
+	//	npEvent.data.keyEvent.rawkeyCode,
+	//	npEvent.data.keyEvent.rawModifier,
+	//	npEvent.data.keyEvent.chr);
+    
+#if USE(JSC)
+    JSC::JSLock::DropAllLocks dropAllLocks(false);
+#endif
+	if (dispatchNPEvent((NPEvent*)&npEvent))
+		event->setDefaultHandled();
+}
+
+void PluginView::handleMouseEvent(MouseEvent* event)
+{
+    VERBOSE_TRACE();
+    IntPoint p = static_cast<FrameView*>(parent())->contentsToWindow(IntPoint(event->pageX(), event->pageY()));
+
+    NpPalmEventType npEvent;
+    npEvent.data.penEvent.xCoord    = p.x();
+    npEvent.data.penEvent.yCoord    = p.y();
+    npEvent.data.penEvent.modifiers = 0;
+
+	/*
+    // FIXME: Send modifiers down
+    if (event->ctrlKey())
+        npEvent.wParam |= MK_CONTROL;
+    if (event->shiftKey())
+        npEvent.wParam |= MK_SHIFT;
+	*/
+
+    if (event->type() == eventNames().mousedownEvent) {
+        npEvent.eventType = npPalmPenDownEvent;
+        // Focus the plugin
+        Page* page;
+        if (page = m_parentFrame->page())
+            page->focusController()->setFocusedFrame(m_parentFrame);
+        m_parentFrame->document()->setFocusedNode(m_element);
+        if (page) {
+			page->editorClient()->setInputMethodState(m_element->shouldUseInputMethod());
+		}
+    }
+	else if (event->type() == eventNames().mousemoveEvent) {
+        npEvent.eventType = npPalmPenMoveEvent;
+	}
+    else if (event->type() == eventNames().mouseupEvent || event->type() == eventNames().mouseoutEvent) {
+        npEvent.eventType = npPalmPenUpEvent;
+    }
+	else if (event->type() == eventNames().clickEvent) {
+		npEvent.eventType = npPalmPenClickEvent;
+	}
+    else if (event->type() == eventNames().dblclickEvent) {
+        npEvent.eventType = npPalmPenDoubleClickEvent;
+    }
+    else {
+        return;
+    }
+
+#if USE(JSC)
+    JSC::JSLock::DropAllLocks dropAllLocks(false);
+#endif	
+    if (dispatchNPEvent((NPEvent*)&npEvent))
+        event->setDefaultHandled();
+}
+
+bool PluginView::visitPlugins_NoneRecursive(Frame* frame, FramePluginsVisitorCallback visitor, void* data)
+{
+	PluginInstanceSet* instances = s_PluginInstanceMap.get(frame);
+	if (!instances)
+		return false;
+
+	PluginInstanceSet::const_iterator end = instances->end();
+	bool visitedPlugin = false;
+	for (PluginInstanceSet::const_iterator it = instances->begin(); it != end; ++it) {
+		PluginInstanceData* instanceData = (*it);
+		PluginView* pluginView = static_cast<PluginView*>(instanceData->m_instance.ndata);
+		if (pluginView)
+		  if (visitor(pluginView, data)) visitedPlugin = true;
+	}
+	return visitedPlugin;
+}
+
+bool PluginView::visitPlugins(Frame* frame, bool subframes, FramePluginsVisitorCallback visitor, void* data)
+{
+        bool visitedPlugin = false;
+	if (subframes) {
+		for (Frame* child = frame->tree()->firstChild(); child; child = child->tree()->nextSibling())
+		  if (visitPlugins(child, true, visitor, data)) visitedPlugin = true;
+	}
+	if (visitPlugins_NoneRecursive(frame, visitor, data))
+		visitedPlugin = true;
+	return visitedPlugin;
+}
