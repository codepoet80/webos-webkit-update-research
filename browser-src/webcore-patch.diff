diff -r -u -N trunk/WebCore/platform/graphics/pg/FontCatalogPG.cpp webkit/WebCore/platform/graphics/pg/FontCatalogPG.cpp
--- trunk/WebCore/platform/graphics/pg/FontCatalogPG.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/FontCatalogPG.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,292 @@
+
+// Copyright 2008 Palm Inc.
+
+#include "config.h"
+
+#include "FontCatalogPG.h"
+
+#include "FontDescription.h"
+#include "PlatformString.h"
+#include "CString.h"
+#include "webkitpalmsettings.h"
+
+#include <glib.h>
+#include <string>
+#include <algorithm>
+
+#undef VERBOSE_MESSAGES
+
+#ifdef VERBOSE_MESSAGES
+#define FCTRACE(...) {printf("FontCatalog: " __VA_ARGS__); fflush(stdout);}
+#else
+#define FCTRACE(...) (void)0
+#endif
+
+
+namespace WebCore
+{
+	
+static std::string s_defaultFamily;
+
+static std::string normalizeFamilyName( const std::string& str );
+	
+struct FontCatalogEntry {
+	FontCatalogEntry() : styleFlags(0), faceFlags(0) { }
+	
+	std::string filePath;
+	std::string name;
+	std::string styleName;
+	int styleFlags;
+	int faceFlags;	
+	std::string normalizedName;
+	
+};
+
+// Sort favoring default family
+bool CompareFunc( const FontCatalogEntry* a, const FontCatalogEntry* b ) {
+	
+	if( a->name.find( s_defaultFamily ) != std::string::npos )
+		return true;
+	
+	if( b->name.find( s_defaultFamily ) != std::string::npos )
+		return false;
+	
+	return a->name < b->name;
+}
+
+
+std::string normalizeFamilyName( const std::string& str )
+{
+	std::string r;
+	
+	for( std::string::const_iterator it=str.begin(); it != str.end(); ++it )
+	{
+		switch( *it ) {
+		case ' ':
+		case '-':
+		case '\t':
+			break;
+		default:
+			r += *it;
+		}
+	}
+	
+	return r;
+}
+
+FontCatalog* FontCatalog::instance( const char* defaultFamily) {
+	static FontCatalog* f= 0;
+	
+	// Specifying default family causes a re-scan.
+	if( defaultFamily ) {
+		delete f;
+		f = 0;
+	}
+	
+	if( !f ) f = new FontCatalog(defaultFamily);
+	return f;
+}
+
+FontCatalog::FontCatalog( )
+{
+	FT_Init_FreeType(&m_ftlib);
+	
+	scan();
+}
+
+FontCatalog::FontCatalog(const char* defaultFamily)
+{
+	if( defaultFamily )
+		s_defaultFamily = defaultFamily;
+	FT_Init_FreeType(&m_ftlib);
+		
+	scan();
+}
+
+FontCatalog::~FontCatalog()
+{
+	clear();
+	FT_Done_FreeType(m_ftlib);
+}
+
+void FontCatalog::clear() 
+{
+	for( FontContainerType::iterator it=m_fonts.begin(); it != m_fonts.end(); ++it )
+	{
+		delete (*it);
+		it = m_fonts.erase( it );
+	}
+}
+
+void FontCatalog::scan()
+{
+	if( !s_defaultFamily.size() )
+		s_defaultFamily = "Prelude" ;
+	
+	GDir* dir = g_dir_open( PalmBrowserSettings()->fontsPath, 0, 0 );
+	if( !dir ) {
+		printf("Failed to open %s to look for fonts\n", PalmBrowserSettings()->fontsPath ); 
+		return;
+	}
+	
+	while( const gchar* file = g_dir_read_name(dir) )
+	{
+		std::string path = PalmBrowserSettings()->fontsPath + std::string(file);
+		if( g_file_test( path.c_str(),G_FILE_TEST_IS_DIR ) == TRUE )
+			continue;
+		
+		FT_Error err;		
+		FT_Face face;
+		
+		err = FT_New_Face( m_ftlib, path.c_str(), 0, &face );
+		if( !err )
+		{
+			if( face->family_name )
+			{
+				FontCatalogEntry* e = new FontCatalogEntry( );
+				e->filePath = path;
+				e->name = face->family_name;
+				e->styleName = face->style_name;
+				e->styleFlags = 
+					((face->style_flags & FT_STYLE_FLAG_BOLD)? FontCatalog::bold : 0 ) 
+					| ((face->style_flags & FT_STYLE_FLAG_ITALIC)? FontCatalog::italic : 0 )
+					;
+				e->faceFlags = 
+					 ((face->face_flags & FT_FACE_FLAG_FIXED_WIDTH)? FontCatalog::monospace : 0 )
+					 ;
+					 
+				// now check the style name to see if it has any other flags in it.
+				if( strstr( face->style_name, "Oblique" ) ) e->styleFlags |= FontCatalog::italic;
+				if( strstr( face->style_name, "Bold" ) ) e->styleFlags |= FontCatalog::bold;
+				if( strstr( face->style_name, "Italic" ) ) e->styleFlags |= FontCatalog::italic;
+				if( strstr( face->style_name, "Condensed" ) ) e->styleFlags |= FontCatalog::condensed;
+								
+				
+				// Note : this needs to be tuned -- we probably just want to read
+				// this from a pref file.
+				if( !e->styleFlags && !e->faceFlags && !(e->styleFlags & FontCatalog::condensed )
+					&& ( m_defaultFontPath.length() ? (e->name.find(s_defaultFamily) != std::string::npos) : true ) )
+					m_defaultFontPath = path.c_str();
+					
+				e->normalizedName = normalizeFamilyName( std::string( e->name + e->styleName ) );
+				m_fonts.push_back( e );
+				
+			}
+			FT_Done_Face( face );
+		}
+	}
+
+	m_genericSansSerifName = String("Prelude");
+	m_genericSerifName = String("Times New Roman");
+	m_genericMonospaceName = String("Courier New");
+	
+	m_fonts.sort( CompareFunc );
+	
+#ifdef VERBOSE_MESSAGES	
+	dump();	
+#endif	
+	
+	g_dir_close(dir);	
+}
+
+void FontCatalog::dump()
+{
+	printf("[%-26s] %16s %32s %-50s %c %c %c\n","Name", "StyleName", "Normalized", "filepath", ' ',' ',' ' );
+	for( FontContainerType::const_iterator it=m_fonts.begin(); it != m_fonts.end(); ++it )
+	{
+		const FontCatalogEntry* e = *it;
+		printf("[%-26s] %16s %32s %-80s %c %c %c %c\n",
+			e->name.c_str(), e->styleName.c_str(),
+			e->normalizedName.c_str(),
+			e->filePath.c_str(), 
+			(e->styleFlags & FontCatalog::bold) ? 'b' : ' ',
+			(e->styleFlags & FontCatalog::italic) ? 'i' : ' ',
+			(e->faceFlags & FontCatalog::monospace) ? 'm' : ' ',
+			(e->faceFlags & FontCatalog::condensed) ? 'c' : ' ');
+	}
+}
+
+// nm is actuall "FamilyName" which is in the form:
+// <fontName>-<styleString>
+//
+String FontCatalog::select( const String& nm, int family, int flags )
+{
+#ifdef VERBOSE_MESSAGES
+	printf("FontCatalog::select nm=[%s] family=%02x  flags=[ ", nm.utf8().data(), family );
+	if( flags & FontCatalog::bold ) printf("bold ");
+	if( flags & FontCatalog::italic ) printf("italic ");
+	if( flags & FontCatalog::oblique ) printf("oblique ");
+	if( flags & FontCatalog::condensed ) printf("condensed ");
+	if( flags & FontCatalog::monospace ) printf("monospace ");
+	printf("]\n" );
+#endif
+	
+	
+	
+	if( strstr( nm.utf8().data(), "Times" ) 
+		|| strstr( nm.utf8().data(), "times" ) ) {
+		family |= FontDescription::SerifFamily;
+	}
+		
+	flags = ( flags & ~monospace );
+	
+	// 1. First, try to match it by name -- let the flags guide this as well.
+	for( FontContainerType::const_iterator it=m_fonts.begin(); it != m_fonts.end(); ++it )
+	{
+		if( flags == (*it)->styleFlags )
+		{
+			if( !strcasecmp( (*it)->name.c_str(), nm.utf8().data() ) )
+			{ 
+				FCTRACE("  --> selecting [1] %s\n\n", (*it)->filePath.c_str() );
+				return (*it)->filePath.c_str();
+			}
+		}
+	}
+	
+	
+	// 3. Now run through again, try to match it by name -- let the flags guide this as well.
+	std::string normSelName = normalizeFamilyName(nm.utf8().data());
+	FCTRACE(" %s --> %s \n", nm.utf8().data(), normSelName.c_str() );
+	for( FontContainerType::const_iterator it=m_fonts.begin(); it != m_fonts.end(); ++it )
+	{
+		if( normSelName == (*it)->normalizedName )
+		{
+			FCTRACE("  --> selecting [2] %s\n\n", (*it)->filePath.c_str() );
+			return (*it)->filePath.c_str();
+		}
+	}
+	
+	// 4. Select a default using the default family name.
+	std::string name;	
+	switch( family )
+	{
+	case FontDescription::SerifFamily:
+		name = normalizeFamilyName(m_genericSerifName.utf8().data());
+		break;
+	case FontDescription::MonospaceFamily:
+		name = normalizeFamilyName(m_genericMonospaceName.utf8().data());
+		break;
+	default:	
+		name = normalizeFamilyName( m_genericSansSerifName.utf8().data());
+	}	
+	if( flags & FontCatalog::bold )
+		name += "Bold";
+	FCTRACE(" default normailzed is [%s]\n", name.c_str() );
+	for( FontContainerType::const_iterator it=m_fonts.begin(); it != m_fonts.end(); ++it )
+	{
+		if( name == (*it)->normalizedName 
+			||
+            (name+"Regular") ==  (*it)->normalizedName
+            || (name+"Medium") ==  (*it)->normalizedName )
+		{
+			FCTRACE("  --> selecting [3] %s\n\n", (*it)->filePath.c_str() );
+			return (*it)->filePath.c_str();
+		}
+	}
+
+	FCTRACE("  --> no matching font found in the system!\n\n");
+	return String();
+}
+
+}
+
