+#if ENABLE(TOUCH_EVENTS)
+void PluginView::handleTouchEvent(TouchEvent* event)
+{
+    VERBOSE_TRACE();
+    NpPalmEventType npEvent;
+
+    if (event->type() ==  eventNames().touchstartEvent) {
+        npEvent.eventType = npPalmTouchStartEvent;
+    } else if (event->type() ==  eventNames().touchmoveEvent) {
+        npEvent.eventType = npPalmTouchMoveEvent;
+    } else if (event->type() ==  eventNames().touchendEvent) {
+        npEvent.eventType = npPalmTouchEndEvent;
+    } else if (event->type() ==  eventNames().touchcancelEvent) {
+        npEvent.eventType = npPalmTouchCancelledEvent;
+    }
+    npEvent.data.touchEvent.modifiers = 0;
+
+    // copy touches() list
+    TouchList* touches = event->touches();
+    NpPalmTouchPoint touchesPoints[touches->length()];
+    for (unsigned i = 0; i < touches->length(); i++) {
+        Touch* touch = touches->item(i);
+        IntPoint p = static_cast<FrameView*>(parent())->contentsToWindow(IntPoint(touch->pageX(), touch->pageY()));
+        touchesPoints[i].xCoord = p.x();
+        touchesPoints[i].yCoord = p.y();
+    }
+    npEvent.data.touchEvent.touches.points = touchesPoints;
+    npEvent.data.touchEvent.touches.length = touches->length();
+
+    // copy targetTouches() list
+    TouchList* targetTouches = event->targetTouches();
+    NpPalmTouchPoint targetTouchesPoints[targetTouches->length()];
+    for (unsigned i = 0; i < targetTouches->length(); i++) {
+        Touch* touch = targetTouches->item(i);
+        IntPoint p = static_cast<FrameView*>(parent())->contentsToWindow(IntPoint(touch->pageX(), touch->pageY()));
+        targetTouchesPoints[i].xCoord = p.x();
+        targetTouchesPoints[i].yCoord = p.y();
+    }
+    npEvent.data.touchEvent.targetTouches.points = targetTouchesPoints;
+    npEvent.data.touchEvent.targetTouches.length = targetTouches->length();
+
+    // copy changedTouches() list
+    TouchList* changedTouches = event->changedTouches();
+    NpPalmTouchPoint changedTouchesPoints[changedTouches->length()];
+    for (unsigned i = 0; i < changedTouches->length(); i++) {
+        Touch* touch = changedTouches->item(i);
+        IntPoint p = static_cast<FrameView*>(parent())->contentsToWindow(IntPoint(touch->pageX(), touch->pageY()));
+        changedTouchesPoints[i].xCoord = p.x();
+        changedTouchesPoints[i].yCoord = p.y();
+    }
+    npEvent.data.touchEvent.changedTouches.points = changedTouchesPoints;
+    npEvent.data.touchEvent.changedTouches.length = changedTouches->length();
+
+    if (dispatchNPEvent(reinterpret_cast<NPEvent*>(&npEvent)))
+        event->setDefaultHandled();
+}
+#endif
