+ * ============================================================ */
+
+#include <string.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <stdio.h>
+
+#undef ABS
+#include "PGFont.h"
+#include "PGContext.h"
+#include "PGFallbackFonts.h"
+
+PGFont* PGFont::createFromFile(const char* filePath, int size,  int faceIndex)
+{
+	if (!filePath)
+		return 0;
+
+	struct stat stBuf;
+	if (::stat(filePath, &stBuf) != 0)
+		return 0;
+
+	PGFont* f = new PGFont;
+	f->m_fileName = ::strdup(filePath);
+	if( !f->m_font->LoadFont(filePath,faceIndex) ) {
+		printf(" ****************** FAILED TO LOAD FONT %s\n", filePath );
+		delete f;
+		return 0;
+	}
+	f->m_font->SetFontSize(size);
+
+	f->m_ptSize = size;
+	f->m_origPtSize = size;
+	
+	// Get Font properties
+	f->m_height = f->m_font->GetFontHeight();
+	f->m_ascent = f->m_font->GetAscend();
+	f->m_descent = abs(f->m_font->GetDescend());
+
+	// x-height of font
+	const unsigned short kX[1] = { 'x' };
+
+	PRect r(0,0,1,1);
+	f->m_font->GetBound(r, kX, 1);
+	f->m_xHeight = r.End.Y - r.Start.Y;
+	
+	// FIXME: Using ' ' Causes assertion failure in PG
+	// width of a space
+	
+	const unsigned short kText[2] = { 'x', ' ' };
+	PRect rSpace(0,0,1,1);
+	
+	f->m_font->GetBound(rSpace, kText, 2);
+	f->m_spaceWidth = rSpace.End.X - rSpace.Start.X - (r.End.X - r.Start.X);
+
+	
+	// line-height
+	f->m_lineHeight = f->m_height; // + f->m_ascent + f->m_descent;
+	
+	return f;
+}
+
+PGFont::PGFont()
+	: m_font(new PFont)
+	, m_origPtSize(0)
+	, m_ptSize(0)
+	, m_ascent(0)
+	, m_descent(0)
+	, m_height(0)
+	, m_xHeight(0)
+	, m_spaceWidth(0)
+	, m_lineHeight(0)
+	, m_fixedPitch(false)
+	, m_fileName(0)
+	, m_clampWidth(true)
+{    
+}
+
+PGFont::~PGFont()
+{
+	free(m_fileName);
+	delete m_font;    
+}
+
+void PGFont::setPointSize(int size, bool changeOriginalPointSize)
+{
+	m_ptSize = size;
+	if (changeOriginalPointSize)
+		m_origPtSize = m_ptSize;
+    m_font->SetFontSize(size);    
+}
+
+int PGFont::pointSize() const
+{
+	return m_ptSize;
+}
+
+int PGFont::originalPointSize() const
+{
+	return m_origPtSize;
+}
+
+int PGFont::ascent() const
+{
+	return m_ascent;    
+}
+
+int PGFont::descent() const
+{
+	return m_descent;    
+}
+
+int PGFont::height() const
+{
+	return m_height;    
+}
+
+int PGFont::xheight() const
+{
+	return m_xHeight;    
+}
+
+int PGFont::spacewidth() const
+{
+	return m_spaceWidth;    
+}
+
+int PGFont::lineheight( ) const
+{
+	return m_lineHeight;    
+}
+
+bool PGFont::isFixedPitch() const
+{
+	return m_fixedPitch;    
+}
+
+extern PGContextIface* sEmptyContext ;
+
+
+PValue PGFont::width(unsigned short c, PGContextIface* measuringContext )
+{
+	// FIXME: Need a more efficient method from PG
+	if( !m_font )
+		return 0;
+
+	if (c == 0)
+		return 0;
+
+	if (c == ' ')
+		return m_spaceWidth;					 
+
+	bool reset = false;
+	
+	if (m_origPtSize != m_ptSize) {
+		reset = true;
+		m_font->SetFontSize(m_origPtSize);
+	}
+
+	PVertex2D pen(0, 0);
+	m_font->AdvancePen(&pen, c, 0, measuringContext ? measuringContext->pgContext() : 0 );
+
+	if (reset)
+		m_font->SetFontSize(m_ptSize);
+
+    if (m_clampWidth)
+        return PValue::Floor(pen.X);
+    else
+        return pen.X;
+}
+
+bool PGFont::containsGlyphForCharCode(unsigned short inCharCode)
+{
+    // FIXME: Need PG to expose this
+	return true;
+}
+
+bool PGFont::operator==(const PGFont& other) const
+{
+	return m_font == other.m_font;
+}
