+++ webkit/WebCore/platform/graphics/pg/PGImageFrame.h	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,108 @@
+/* ============================================================
+ * Date  : 2008-12-31
+ * Copyright 2008 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#ifndef PGIMAGEFRAME_H
+#define PGIMAGEFRAME_H
+
+#include <stdlib.h>
+#include "PGSurface.h"
+#include "PGContext.h"
+
+class PGImageFrame
+{
+public:
+
+	PGImageFrame(int width, int height) {
+		m_width = width;
+		m_height = height;
+		m_hasAlpha = false;
+		m_data = (width > 0 && height > 0) ? (unsigned int*) malloc(width * height * 4) : 0;
+		m_surf = 0;
+		m_requestedScale = m_scale = 1.0f;
+	}
+
+	~PGImageFrame() {
+		free(m_data);
+		if (m_surf)
+			m_surf->releaseRef();
+	}
+
+	void setHasAlpha(bool val) { m_hasAlpha = val; }
+	void setScale(float requestedScale, float actualScale)
+	{
+		m_requestedScale = requestedScale;
+		m_scale = actualScale;
+	}
+	
+	int width() const { return m_width; }
+	int height() const { return m_height; }
+	bool hasAlpha() const { return m_hasAlpha; }
+	unsigned int* data() const { return m_data; }
+	float requestedScale() const { return m_requestedScale; }
+
+	void mapRect(PVertex2D& TopLeft, PVertex2D& BottomRight)
+	{
+		if (m_scale != 1.0f) {
+			PValue scale(m_scale);
+			TopLeft.X *= scale;
+			TopLeft.Y *= scale;
+			BottomRight.X *= scale;
+			BottomRight.Y *= scale;
+		}
+	}
+
+	PGSurface* surface() {
+
+		if (m_surf)
+			return m_surf;
+
+		if (!m_data)
+			return 0;
+
+		m_surf = PGSurface::wrap((const unsigned int) m_width,
+								 (const unsigned int) m_height,
+								 (const unsigned char*) m_data,
+								 m_hasAlpha);
+		return m_surf;
+	}
+
+	PGImageFrame* downSample(float requestedScale) 
+	{
+		float actualScale = requestedScale;
+		
+		int width = (int)(m_width * requestedScale);
+		int height = (int)(m_height * requestedScale);
+		
+		if (width == 0 || height == 0) {
+			actualScale = 1.0f;
+			width = m_width;
+			height = m_height;
+		}
+
+		PGImageFrame* resized = new PGImageFrame(width, height);
+		resized->setScale(requestedScale, actualScale);
+		resized->setHasAlpha(this->hasAlpha());
+		
+		PGContext::downSample(resized->surface(), this->surface());
+		return resized;
+	}
+
+private:
+
+	int m_width;
+	int m_height;
+	bool m_hasAlpha;
+	unsigned int* m_data;
+	PGSurface* m_surf;
+	float m_requestedScale;
+	float m_scale;
+
+private:
+
+	PGImageFrame(const PGImageFrame&);
+	PGImageFrame& operator=(const PGImageFrame&);
+};
+
+#endif /* PGIMAGEFRAME_H */
diff -r -u -N trunk/WebCore/platform/graphics/pg/PGImageGifDecoder.cpp webkit/WebCore/platform/graphics/pg/PGImageGifDecoder.cpp
--- trunk/WebCore/platform/graphics/pg/PGImageGifDecoder.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGImageGifDecoder.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,446 @@
+/* ============================================================
+ * Date  : 2009-01-06
+ * Copyright 2009 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <PMem.h>
+
+#include "PGImageFrame.h"
+#include "PGImageGifDecoder.h"
+#include "PGImageDecoderFactory.h"
+
+PGImageGifDecoder::PGImageGifDecoder(const char* data, int dataLen)
+	: PGImageDecoder(data, dataLen)
+	, m_data(data)
+	, m_dataLen(dataLen)
+	, m_dataReadPos(0)
+	, m_readHeader(false)
+	, m_width(-1)
+	, m_height(-1)
+	, m_numFrames(-1)
+{   
+}
+
+PGImageGifDecoder::~PGImageGifDecoder()
+{    
+}
+
+bool PGImageGifDecoder::getDimensions(int& width, int& height)
+{
+	if (!m_readHeader)
+		readHeader();
+	
+	if (m_failed)
+		return false;
+
+	width = m_width;
+	height = m_height;
+	return true;
+}
+
+int PGImageGifDecoder::numFrames()
+{
+	// FIXME:
+	return m_failed ? 0 : 1;
+}
+
+
+inline unsigned int indexToARGB(int index, int transparentColorIndex, GifColorType* colorMapEntry)
+{
+	if (index == transparentColorIndex) {
+		return 0;
+	}
+	else {
+		return ((0xFF                 << 24) |
+				(colorMapEntry->Red   << 16) |
+				(colorMapEntry->Green <<  8) |
+				(colorMapEntry->Blue  <<  0));
+	}		
+}
+
+PGImageFrame* PGImageGifDecoder::getFrame(int frameIndex, float scale)
+{
+	if (m_failed)
+		return 0;
+
+	m_dataReadPos = 0;
+	PGImageFrame* frame = 0;
+	unsigned char* scanLine = 0;	
+	int top, left, width, height;
+	int transparentColorIndex = -1;
+
+	GifFileType* fileType = DGifOpen(this, gifInputFunc);
+    if (!fileType) {
+		m_failed = true;
+		goto Done;
+	}
+	
+	while (true) {
+
+		GifRecordType recordType;
+		if (DGifGetRecordType(fileType, &recordType) == GIF_ERROR) {
+			m_failed = true;
+			goto Done;
+		}
+
+		switch (recordType) {
+		case (UNDEFINED_RECORD_TYPE): {
+
+			m_failed = true;
+			goto Done;
+		}
+		case (IMAGE_DESC_RECORD_TYPE): {
+
+			ColorMapObject* colorMap = 0;
+			
+			if (DGifGetImageDesc(fileType) == GIF_ERROR) {
+				m_failed = true;
+				goto Done;
+			}
+
+			m_width = fileType->SWidth;
+			m_height = fileType->SHeight;
+
+			int maxSize = PGImageDecoderFactory::maxImageSize();
+			if (m_width * m_height > maxSize * maxSize) {
+				m_failed = true;
+				m_width = -1;
+				m_height = -1;
+				goto Done;
+			}
+			
+			colorMap = fileType->Image.ColorMap;
+			if (!colorMap)
+				colorMap = fileType->SColorMap;
+
+			if (!colorMap) {
+				m_failed = true;
+				goto Done;
+			}
+
+			top = fileType->Image.Top;
+			left = fileType->Image.Left;
+			width = fileType->Image.Width;
+			height = fileType->Image.Height;
+			int numBottomFillRows = m_height - (height + top);
+				
+			if ((left + width) > m_width || (top + height) > m_height) {
+				m_failed = true;
+				goto Done;
+			}
+
+			scanLine = (unsigned char*) malloc(m_width);
+			memset(scanLine, fileType->SBackGroundColor, m_width);
+
+			frame = new PGImageFrame(m_width, m_height);
+			if (transparentColorIndex != -1)
+				frame->setHasAlpha(true);
+
+			if (fileType->Image.Interlace) {
+
+				static const int interlacedOffset[] = { 0, 4, 2, 1 };
+				static const int interlacedJumps[]  = { 8, 8, 4, 2 };
+
+	
+				unsigned int* dstScanLine = frame->data();
+				unsigned int* dstPtr = 0;
+				GifColorType* colorMapEntry = 0;
+				unsigned int pixelColor = 0;
+
+				// top -------------------------------------------------------------
+				
+				if (fileType->SBackGroundColor == transparentColorIndex) {
+					pixelColor = 0;
+				}
+				else {
+					colorMapEntry = &colorMap->Colors[CLAMP(fileType->SBackGroundColor, 0, colorMap->ColorCount - 1)];
+					pixelColor = indexToARGB(fileType->SBackGroundColor,
+												transparentColorIndex,
+											 colorMapEntry);
+				}
+				
+				dstPtr = dstScanLine;				
+				for (int j = 0; j < top; j++) {
+					PMem::Memset32((unsigned long*) dstPtr, pixelColor, m_width);
+					dstPtr += m_width;
+				}
+
+				
+								
+				// 4 passes needed for interlaced images
+				for (int pass = 0; pass < 4; pass++) {
+
+					for (int j = top + interlacedOffset[pass];
+						 j < top + height; j += interlacedJumps[pass]) {
+
+						dstPtr = dstScanLine + j * m_width;
+							 						
+						if (DGifGetLine(fileType, scanLine + left, width) == GIF_ERROR) {
+							m_failed = true;
+							goto Done;
+						}
+
+						for (int i = 0; i < m_width; i++) {
+							colorMapEntry = &colorMap->Colors[MIN(scanLine[i], colorMap->ColorCount - 1)];
+							*dstPtr++ = indexToARGB(scanLine[i],
+													transparentColorIndex,
+													colorMapEntry);
+						}
+					}
+				}
+
+				// bottom -------------------------------------------------------------
+
+				if (fileType->SBackGroundColor == transparentColorIndex) {
+					pixelColor = 0;
+				}
+				else {
+					colorMapEntry = &colorMap->Colors[CLAMP(fileType->SBackGroundColor, 0, colorMap->ColorCount - 1)];
+					pixelColor = indexToARGB(fileType->SBackGroundColor,
+												transparentColorIndex,
+											 colorMapEntry);
+				}
+				
+				dstPtr = dstScanLine + (top + height) * m_width;
+				for (int j = 0; j < numBottomFillRows; j++) {
+					PMem::Memset32((unsigned long*) dstPtr, pixelColor, m_width);
+					dstPtr += m_width;
+				}
+			}
+			else {
+
+				unsigned int* dstPtr = frame->data();
+				GifColorType* colorMapEntry = 0;
+				unsigned int pixelColor = 0;
+
+				// top ---------------------------------------------------------------
+
+				if (fileType->SBackGroundColor == transparentColorIndex) {
+					pixelColor = 0;
+				}
+				else {
+					colorMapEntry = &colorMap->Colors[CLAMP(fileType->SBackGroundColor, 0, colorMap->ColorCount - 1)];
+					pixelColor = indexToARGB(fileType->SBackGroundColor,
+												transparentColorIndex,
+											 colorMapEntry);
+				}
+
+				for (int j = 0; j < top; j++) {
+					PMem::Memset32((unsigned long*) dstPtr, pixelColor, m_width);
+					dstPtr += m_width;
+				}
+
+				
+				for (int j = 0; j < height; j++) {
+
+					if (DGifGetLine(fileType, scanLine + left, width) == GIF_ERROR) {
+						m_failed = true;
+						goto Done;
+					}
+
+					for (int i = 0; i < m_width; i++) {
+						colorMapEntry = &colorMap->Colors[MIN(scanLine[i], colorMap->ColorCount - 1)];
+						*dstPtr++ = indexToARGB(scanLine[i],
+												transparentColorIndex,
+												colorMapEntry);
+					}
+				}
+
+
+				// bottom -------------------------------------------------------------
+
+				if (fileType->SBackGroundColor == transparentColorIndex) {
+					pixelColor = 0;
+				}
+				else {
+					colorMapEntry = &colorMap->Colors[CLAMP(fileType->SBackGroundColor, 0, colorMap->ColorCount - 1)];
+					pixelColor = indexToARGB(fileType->SBackGroundColor,
+												transparentColorIndex,
+											 colorMapEntry);
+				}
+				
+				for (int j = 0; j < numBottomFillRows; j++) {
+					PMem::Memset32((unsigned long*) dstPtr, pixelColor, m_width);
+					dstPtr += m_width;
+				}				
+			}
+
+			// FIXME: only one frame decoded currently
+			goto Done;
+
+			break;
+		}
+		case (EXTENSION_RECORD_TYPE): {
+
+			int extCode;
+			GifByteType* extension;
+
+			// skipping the extension records
+			if (DGifGetExtension(fileType, &extCode, &extension) == GIF_ERROR) {
+				m_failed = true;
+				goto Done;
+			}
+			
+			while (extension != NULL) {
+
+				// extCode      (Graphic Control Label: value 0xF9)
+				// extension[0] (Block Size: value 4)
+				// extension[1] (Packed fields: 3 Bits: Reserved, 3 Bits: Disposal Method,
+				//                              1 Bit: Use Input Flag, 1 Bit: Transparent Color Flag)
+				// extension[2-3] (Delay time: unsigned short)
+				// extension[4] (Transparent Color index)
+				if (extCode == 0xF9 && extension[0] == 4 && (extension[1] & 0x1)) {
+					transparentColorIndex = extension[4];					
+				}
+
+				if (DGifGetExtensionNext(fileType, &extension) == GIF_ERROR) {
+					m_failed = true;
+					goto Done;
+				}
+			}
+				
+			break;
+		}
+		case (TERMINATE_RECORD_TYPE):
+		default:
+			goto Done;
+			break;
+		}
+	} 
+
+
+Done:
+
+	m_readHeader = true;
+	
+	if (fileType)
+		DGifCloseFile(fileType);
+
+	free(scanLine);
+
+	if (m_failed) {
+		delete frame;
+		frame = 0;
+	}
+
+	if (frame && scale != 1.0f) {
+		PGImageFrame* resized = frame->downSample(scale);
+		delete frame;
+		frame = resized;
+	}
+
+	return frame;
+}
+
+int PGImageGifDecoder::gifInputFunc(GifFileType* fileType, GifByteType* buffer, int size)
+{
+	PGImageGifDecoder* d = (PGImageGifDecoder*) fileType->UserData;
+
+	int remaining = d->m_dataLen - d->m_dataReadPos;
+	if (remaining <= 0)
+		return 0;
+
+	if (size > remaining)
+		size = remaining;
+
+	memcpy(buffer, d->m_data + d->m_dataReadPos, size);
+
+	d->m_dataReadPos += size;
+
+	return size;
+}
+
+void PGImageGifDecoder::readHeader()
+{
+	if (m_readHeader)
+		return;
+
+	m_dataReadPos = 0;
+
+	GifFileType* fileType = DGifOpen(this, gifInputFunc);
+    if (!fileType) {
+		m_failed = true;
+		goto Done;
+	}
+
+	while (true) {
+
+		GifRecordType recordType;
+		if (DGifGetRecordType(fileType, &recordType) == GIF_ERROR) {
+			m_failed = true;
+			goto Done;
+		}
+
+		switch (recordType) {
+		case (UNDEFINED_RECORD_TYPE): {
+
+			m_failed = true;
+			goto Done;
+		}
+		case (IMAGE_DESC_RECORD_TYPE): {
+
+			int codeSize;
+			GifByteType* codeBlock;			
+
+			if (DGifGetImageDesc(fileType) == GIF_ERROR) {
+				m_failed = true;
+				goto Done;
+			}
+
+			m_width = fileType->SWidth;
+			m_height = fileType->SHeight;
+
+			// skipping the encoded image
+			if (DGifGetCode(fileType, &codeSize, &codeBlock) == GIF_ERROR) {
+				m_failed = true;
+				goto Done;
+			}
+
+			while (codeBlock != NULL) {
+				if (DGifGetCodeNext(fileType, &codeBlock) == GIF_ERROR) {
+					m_failed = true;
+					goto Done;
+				}
+			}			
+
+			break;
+		}
+		case (EXTENSION_RECORD_TYPE): {
+
+			int extCode;
+			GifByteType* extension;
+
+			// skipping the extension records
+			if (DGifGetExtension(fileType, &extCode, &extension) == GIF_ERROR) {
+				m_failed = true;
+				goto Done;
+			}
+			
+			while (extension != NULL) {
+				if (DGifGetExtensionNext(fileType, &extension) == GIF_ERROR) {
+					m_failed = true;
+					goto Done;
+				}
+			}
+				
+			break;
+		}
+		case (TERMINATE_RECORD_TYPE):
+		default:
+			goto Done;
+			break;
+		}
+	} 
+
+
+Done:
+
+	m_readHeader = true;
+	
+	if (fileType)
+		DGifCloseFile(fileType);
+}
