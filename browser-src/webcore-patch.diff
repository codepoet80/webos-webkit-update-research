+void GraphicsContext::beginTransparencyLayer(float opacity)
+{
+    if (paintingDisabled())
+        return;
+
+	m_data->layers.append(opacity);
+
+	float currTransparency = 1.0f;
+	for (unsigned int i = 0; i < m_data->layers.size(); i++)
+		currTransparency *= m_data->layers[i];
+
+    unsigned char normalized = static_cast<unsigned char>(currTransparency * 255);
+    m_data->context->setFillOpacity(normalized);
+    m_data->context->setStrokeOpacity(normalized);
+}
+
+void GraphicsContext::endTransparencyLayer()
+{
+    if (paintingDisabled())
+        return;
+
+	m_data->layers.removeLast();
+
+	float currTransparency = 1.0f;
+	for (unsigned int i = 0; i < m_data->layers.size(); i++)
+		currTransparency *= m_data->layers[i];
+
+    unsigned char normalized = static_cast<unsigned char>(currTransparency * 255);
+    m_data->context->setFillOpacity(normalized);
+    m_data->context->setStrokeOpacity(normalized);
+}
