+
+void PGContext::push()
+{
+	if (m_currState >= kStackDepth - 1) {
+		g_critical("PGContext: graphics stack depth overflowed %d times", m_stateTrampoline+1);
+		//m_currState = kStackDepth - 1;
+		m_stateTrampoline++;
+		return;
+	}
+
+	m_currState++;
+
+	m_stateStack[m_currState] = m_stateStack[m_currState - 1];
+
+	m_stateChanged = true;
+}
+
+void PGContext::pop()
+{
+	if( m_stateTrampoline )
+	{
+		m_stateTrampoline--;
+		return;
+	}
+
+	if (m_currState <= 0) {
+		g_critical("PGContext graphics stack depth underflowed");
+		m_currState = 0;
+	}
+
+    // If we detected that we are switching from extended mode; we'll reset our offsets
+    if ((m_currState > 0) && m_stateStack[m_currState].Extended != m_stateStack[m_currState - 1].Extended)
+        m_offset_x = m_offset_y = 0;
+
+	m_currState--;
+
+	m_stateChanged = true;
+}
+
+int PGContext::originX() const
+{
+    if (currState()->Extended)
+        return MAT(2, 0);
+
+	return (int)currState()->matrix.GetTranslation().X - m_offset_x;
+}
+
+int PGContext::originY() const
+{
+    if (currState()->Extended)
+        return MAT(2, 1);
+
+	return (int)currState()->matrix.GetTranslation().Y - m_offset_y;
+}
+
+void PGContext::translate(int x, int y)
+{
+	gfxLog("%d, %d", (int) x, (int) y);
+
+    currState()->matrix.PreTranslate(PVertex2D(x - m_offset_x, y - m_offset_y));
+
+	m_stateChanged = true;
+}
+
+void PGContext::_translate(float x, float y)
+{
+	gfxLog("%d, %d", (int) x, (int) y);
+
+    if (m_offset_x || m_offset_y) {
+       x = (PValue)((int)x - m_offset_x);
+       y = (PValue)((int)y - m_offset_y);
+    }
+
+    currState()->matrix.PreTranslate(PVertex2D(x, y));
+
+	m_stateChanged = true;
+}
+
+void PGContext::rotate(float radians)
+{
+	gfxLog("%f", (float) radians);
+
+    if (currState()->Extended) {
+        float R = deg2rad(radians);
+        float S = sinf(R);
+        float C = cosf(R);
+
+        const float MAT_0_0 = MAT(0, 0);
+        const float MAT_0_1 = MAT(0, 1);
+
+        MAT(0, 0) = MAT_0_0 * C     - MAT(1, 0) * S;
+        MAT(1, 0) = MAT(1, 0) * C   + MAT_0_0   * S;
+
+        MAT(0, 1) = MAT_0_1 * C     - MAT(1, 1) * S;
+        MAT(1, 1) = MAT(1, 1) * C   + MAT_0_1 * S;
+    }
+
+	currState()->matrix.PreRotate(radians);
+
+	m_stateChanged = true;
+}
+
+void PGContext::scale(float x, float y)
+{
+	gfxLog("%f, %f", (float) x, (float) y);
+
+	if (fabsf((float) x - 1.0f) <= 0.0001 &&
+		fabsf((float) y - 1.0f) <= 0.0001)
+		return;
+
+    if (currState()->Extended) {
+        MAT(0, 0) *= x;
+        MAT(0, 1) *= y;
+
+        MAT(1, 0) *= x;
+        MAT(1, 1) *= y;
+    }
+
+    currState()->matrix.PreScale(PVertex2D(x, y));
+	currState()->scale *= (float) x;
+
+	m_stateChanged = true;
+}
