+/* ============================================================
+ * Date  : 2009-01-02
+ * Copyright 2009 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#include <string.h>
+
+#include "PGImageDecoderFactory.h"
+
+#include "PGImageDecoder.h"
+#include "PGImageJpegDecoder.h"
+#include "PGImageGifDecoder.h"
+#include "PGImagePngDecoder.h"
+
+// FIXME: make configurable
+static const int kMaxImageSize = 1600;
+
+PGImageDecoder* PGImageDecoderFactory::decoderForData(const char* data, const int dataLen)
+{
+    if (dataLen > 2 && (unsigned char) data[0] == 0xFF && (unsigned char) data[1] == 0xD8) {
+		return new PGImageJpegDecoder(data, dataLen);
+	}
+
+	if (dataLen > 4 && memcmp(data, "GIF8", 4) == 0) {
+		return new PGImageGifDecoder(data, dataLen);
+	}
+
+	const char pngSig[] = { 137, 80, 78, 71, 13, 10, 26, 10 };
+	if (dataLen > 8 && memcmp(data, pngSig, 8) == 0) {
+		return new PGImagePngDecoder(data, dataLen);
+	}
+
+	return 0;
+}
+
+int PGImageDecoderFactory::maxImageSize()
+{
+	return kMaxImageSize;    
+}
