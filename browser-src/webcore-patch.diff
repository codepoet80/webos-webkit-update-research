 void DocumentThreadableLoader::loadResourceSynchronously(Document* document, const ResourceRequest& request, ThreadableLoaderClient& client, const ThreadableLoaderOptions& options)
 {
+#if PLATFORM(WEBOS)
+    // Synchronous loads that take longer than 30 will cause the browserserver run afoul of deadlock detection.
+    // Disable the detection while a synchronous load is in progress.
+    Palm::WebPage* page = kit(document->page());
+    Palm::WebPageClient* pageClient = page ? page->client() : 0;
+    if (pageClient)
+        pageClient->suspendDeadlockDetection();
+    RefPtr<DocumentThreadableLoader> loader = adoptRef(new DocumentThreadableLoader(document, &client, LoadSynchronously, request, options));
+    ASSERT(loader->hasOneRef());
+    // Delete synchronous document loader to ensure it has completed before resuming deadlock detection
+    loader = 0;
+    if (pageClient) {
+        // Bump the deadlock counter for safe measure before restarting the detection.
+        pageClient->loadActive();
+        pageClient->resumeDeadlockDetection();
+    }
+#else
     // The loader will be deleted as soon as this function exits.
     RefPtr<DocumentThreadableLoader> loader = adoptRef(new DocumentThreadableLoader(document, &client, LoadSynchronously, request, options));
     ASSERT(loader->hasOneRef());
+#endif
 }
 
