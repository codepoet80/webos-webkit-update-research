+static char* NpPalmEventType_to_s(NpPalmEventType* e)
+{
+    char* s = s_NpPalmEventTypeString;
+    int off = 0;
+    
+    off += sprintf(s + off, "{\n");
+    if (npPalmDrawEvent == e->eventType) {
+        off += sprintf(s + off, "  eventType = npPalmDrawEvent\n");
+        off += sprintf(s + off, "  data.drawEvent = {\n");
+        off += sprintf(s + off, "    dstBuffer       = 0x%08x\n", (unsigned int) e->data.drawEvent.dstBuffer);
+        off += sprintf(s + off, "    dstRowBytes     = %u\n", e->data.drawEvent.dstRowBytes);
+        off += sprintf(s + off, "    srcLeft         = %d\n", e->data.drawEvent.srcLeft);
+        off += sprintf(s + off, "    srcRight        = %d\n", e->data.drawEvent.srcRight);
+        off += sprintf(s + off, "    srcTop          = %d\n", e->data.drawEvent.srcTop);
+        off += sprintf(s + off, "    srcBottom       = %d\n", e->data.drawEvent.srcBottom);
+        off += sprintf(s + off, "    graphicsContext = 0x%08x\n", (unsigned int) e->data.drawEvent.graphicsContext);
+        off += sprintf(s + off, "    dstLeft         = %d\n", e->data.drawEvent.dstLeft);
+        off += sprintf(s + off, "    dstRight        = %d\n", e->data.drawEvent.dstRight);
+        off += sprintf(s + off, "    dstTop          = %d\n", e->data.drawEvent.dstTop);
+        off += sprintf(s + off, "    dstBottom       = %d\n", e->data.drawEvent.dstBottom);
+        off += sprintf(s + off, "  }\n");
+    } else if (npPalmSystemEvent == e->eventType) {
+        off += sprintf(s + off, "  eventType = npPalmSystemEvent\n");
+        if (npPalmViewPortChangedEvent == e->data.systemEvent.type) {
+            off += sprintf(s + off, "  data.systemEvent = {\n");
+            off += sprintf(s + off, "    type       = npPalmViewPortChangedEvent");
+            off += sprintf(s + off, "    viewLeft   = %d\n", e->data.systemEvent.viewLeft);
+            off += sprintf(s + off, "    viewRight  = %d\n", e->data.systemEvent.viewRight);
+            off += sprintf(s + off, "    viewTop    = %d\n", e->data.systemEvent.viewTop);
+            off += sprintf(s + off, "    viewBottom = %d\n", e->data.systemEvent.viewBottom);
+            off += sprintf(s + off, "  }\n");
+        }
+    } else {
+        off += sprintf(s + off, "  eventType = %d\n", e->eventType);
+    }
+    
+    off += sprintf(s + off, "}");
+    return s;
+}
