diff -r -u -N trunk/WebCore/storage/SQLDump.cpp webkit/WebCore/storage/SQLDump.cpp
--- trunk/WebCore/storage/SQLDump.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/storage/SQLDump.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,75 @@
+#include "config.h"
+#include "Database.h"
+#include "SQLDump.h"
+#include "SQLError.h"
+#include "Logging.h"
+#include "PalmObjectLog.h"
+#include "VoidCallback.h"
+
+namespace WebCore {
+
+PassRefPtr<SQLDump> SQLDump::create(Database* db, PassRefPtr<SQLDumpCallback> callback, PassRefPtr<SQLDumpErrorCallback> errorCallback, 
+                                           PassRefPtr<VoidCallback> successCallback, PassRefPtr<SQLDumpWrapper> wrapper)
+{
+    return adoptRef(new SQLDump(db, callback, errorCallback, successCallback, wrapper));
+}
+
+SQLDump::SQLDump(Database* db, PassRefPtr<SQLDumpCallback> callback, PassRefPtr<SQLDumpErrorCallback> errorCallback, PassRefPtr<VoidCallback> successCallback, 
+                               PassRefPtr<SQLDumpWrapper> wrapper)
+    : m_database(db)
+	, m_watcher(NULL)
+	, m_dumpStatus(0)
+    , m_wrapper(wrapper)
+    , m_callback(callback)
+    , m_successCallback(successCallback)
+    , m_errorCallback(errorCallback)
+{
+    ASSERT(m_database);
+	//WEBOS_OBJECT_NEW(this,SQLDump);
+}
+
+SQLDump::~SQLDump()
+{
+	//WEBOS_OBJECT_DELETE(this,SQLDump);
+}
+
+
+void SQLDump::setDumpFile(const String& dumpFile)
+{
+	m_dumpFile = dumpFile;
+}
+
+bool SQLDump::performNextStep()
+{
+	m_dumpStatus = m_database->dump(m_dumpFile);
+
+	if (0 == m_dumpStatus) {
+		
+		if (m_successCallback) {
+			LOG(StorageAPI, "Calling success callback for dump %p\n", this);
+			m_successCallback->handleEvent();
+		}
+	}
+	else if (m_errorCallback) {
+		LOG(StorageAPI, "Calling error callback for dump %p\n", this);
+		String msg("Error dumping database to \"" + m_dumpFile + "\"");
+		m_dumpError = SQLError::create(0, msg);
+		m_errorCallback->handleEvent(m_dumpError.get());
+	}
+
+	if (m_callback) {
+		bool raisedException(false);
+		m_callback->handleEvent(this, raisedException);
+	}
+
+	// dereference callbacks
+	m_callback = 0;
+	m_successCallback = 0;
+	m_errorCallback = 0;
+	
+	m_database->dumpCallback(this);
+
+	return false; // Nothing else to do
+}
+
+}
