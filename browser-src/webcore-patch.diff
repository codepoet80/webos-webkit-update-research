+void PGContext::drawPattern(PGSurface* pattern, const PMatrix3D& patternMatrix,
+							int dLeft, int dTop, int dRight, int dBottom,
+							PRepeatRule repeat)
+{
+    applyState();
+
+    PMatrix3D pmatrix (patternMatrix);
+    if (m_offset_x || m_offset_y) {
+        PMatrix3D matrix;
+        matrix.Translate(PVertex2D(m_offset_x, m_offset_y));
+        matrix.Combine(&pmatrix);
+        pmatrix = matrix;
+    }
+	gfxLog("dst: %f:%f, %f:%f", (float) dLeft, (float) dRight, (float) dTop, (float) dBottom);
+
+	PMatrix3D matrix(pmatrix);
+	matrix.Combine(&(currState()->matrix));
+
+    gfxLog("[ %10.3f, %10.3f, %10.3f]", (float)matrix.Ele[0][0], (float)matrix.Ele[1][0], (float)matrix.Ele[2][0]);
+    gfxLog("[ %10.3f, %10.3f, %10.3f]", (float)matrix.Ele[0][1], (float)matrix.Ele[1][1], (float)matrix.Ele[2][1]);
+    gfxLog("[ %10.3f, %10.3f, %10.3f]", (float)matrix.Ele[0][2], (float)matrix.Ele[1][2], (float)matrix.Ele[2][2]);
+
+	pattern->m_pixmap->SetTransform(&matrix);
+	pattern->m_pixmap->SetRepeatRule(repeat);
+
+	m_gc->SetNoStroke();
+	m_gc->SetFillPixmap(pattern->m_pixmap);
+	m_gc->DrawRectangle(PVertex2D(dLeft + m_offset_x, dTop + m_offset_y), PVertex2D(dRight + m_offset_x, dBottom + m_offset_y));
+
+	m_stateChanged = true;
+}
+
+void PGContext::applyState()
+{
+	if (!m_stateChanged)
+		return;
+
+	m_stateChanged = false;
+	
+	PGContextState* s = currState();
+
+	m_gc->SetFillOpacity(s->fillOpacity);
+
+	m_gc->SetCompMode(s->compRule);
+
+	if (s->doFill)
+		m_gc->SetFillColor(s->fillColor);
+	else
+		m_gc->SetNoFill();
+
+	if (s->doStroke) {
+
+        const PValue strokeWidth = s->strokeWidth;
+        const PValue dottedArray[] = {strokeWidth};
+        const PValue dashWidthAndOffset = strokeWidth * 3;
+        const PValue dashedArray[] = {dashWidthAndOffset, dashWidthAndOffset};
+
+		switch (s->strokeStyle) {
+			case NoStroke:
+				m_gc->SetNoStroke();
+				m_gc->SetDashArray();
+				break;
+			case SolidStroke:
+				m_gc->SetDashArray();
+				break;
+			case DottedStroke:
+				m_gc->SetDashArray(dottedArray, G_N_ELEMENTS(dottedArray));
+				break;
+			case DashedStroke:
+				m_gc->SetDashArray(dashedArray, G_N_ELEMENTS(dashedArray));
+				break;
+		}
+		m_gc->SetStrokeColor(s->strokeColor);
+        m_gc->SetStrokeWidth(strokeWidth);
+		m_gc->SetStrokeOpacity(s->strokeOpacity);
+        m_gc->SetCapRule(s->lineCap);
+        m_gc->SetJoinRule(s->lineJoin);
+        m_gc->SetMiterLimit(s->miterLimit);
+	}
+	else {
+		m_gc->SetNoStroke();
+	}
+
+    // [a b c]
+    // [d e f]
+    if (currState()->Extended) {
+        // bd - ae
+        float Den = 1.0f / (MAT(1, 0) * MAT(0, 1) - MAT(0, 0) * MAT(1, 1));
+
+        // (ce - bf) / Den
+        m_offset_x = -Den * (MAT(2, 0) * MAT(1, 1) - MAT(1, 0) * MAT(2, 1));
+        // (cd - af) / Den
+        m_offset_y = Den * (MAT(2, 0) * MAT(0, 1) - MAT(0, 0) * MAT(2, 1));
+/*
+printf("[%f, %f, %f]\n", MAT(0, 0), MAT(1, 0), MAT(2, 0));
+printf("[%f, %f, %f]\n", MAT(0, 1), MAT(1, 1), MAT(2, 1));
+printf("<%d, %d>\n", m_offset_x, m_offset_y);
+*/
+        PMatrix3D Mat;
+
+        // These should not change
+        Mat.Ele[0][0] = MAT(0, 0);
+        Mat.Ele[0][1] = MAT(0, 1);
+        Mat.Ele[1][0] = MAT(1, 0);
+        Mat.Ele[1][1] = MAT(1, 1);
+
+        // We specifically computed for a zero translation.
+        Mat.Ele[2][0] = 0;
+        Mat.Ele[2][1] = 0;
+        Mat.ShortForm = true;
+        Mat.FullIdentity = Mat.HalfIdentity = false;
+        m_gc->SetTransform(&Mat);
+
+    } else {
+/*
+printf("(%f, %f, %f)\n", (float)s->matrix.Ele[0][0], (float)s->matrix.Ele[1][0], (float)s->matrix.Ele[2][0]);
+printf("(%f, %f, %f)\n", (float)s->matrix.Ele[0][1], (float)s->matrix.Ele[1][1], (float)s->matrix.Ele[2][1]);
+printf("{%d, %d}\n", m_offset_x, m_offset_y);
+*/
+        m_gc->SetTransform(&s->matrix);
+    }
+
+	if (s->globalClipSet) {
+
+		PRect r = s->globalClipRect;
+		
+		if (s->clipValid) 
+			r = intersectRects(r, s->clipRect);
+		
+		m_gc->SetClipRegion(r);
+
+		s->currClipRect = r;
+		s->currClipValid = true;
+	}
+	else {
+		if (s->clipValid) {
+		
+			const PRect surfRect(0, 0, m_surf->width(), m_surf->height());
+			if (s->clipRect.Intersects(surfRect)) {
+				m_gc->SetClipRegion(s->clipRect);
+				s->currClipRect = s->clipRect;
+			}
+			else {
+				// Piranha can't currently handle a clipRect that doesn't
+				// intersect the surface so we check here and set to an 
+				// empty rectangle explicitly. More info at NOV-109062.
+				m_gc->SetClipRegion(k_EmptyRect);
+				s->currClipRect = k_EmptyRect;
+			}
+
+			s->currClipValid = true;
+		}
+		else {
+			m_gc->ResetClip();
+
+			s->currClipRect = k_EmptyRect;
+			s->currClipValid = false;
+		}
+	}
+
+	if (s->clipPathValid  && s->clipPath.m_path ) {
+		PPath* TPath = m_gc->CreatePath();
+		s->clipPath.m_path->Transform(TPath, &s->matrix);
+		m_gc->SetClipPath(TPath, PNonZero);
+		m_gc->DestroyPath(TPath);
+	}
+	else {
+		m_gc->SetClipPath(NULL, PNonZero);
+	}
+
+}
+
+void PGContext::clipRect(int left, int top, int right, int bottom)
+{
+	gfxLog("%f:%f, %f:%f", (float) left, (float) right, (float) top, (float) bottom);
+
+	PGContextState* s = currState();
+
+	PVertex2D start(left + m_offset_x, top + m_offset_y);
+	PVertex2D end(right + m_offset_x, bottom + m_offset_y);
+
+	start = s->matrix * start;
+	end = s->matrix * end;
+
+    if (currState()->Extended) {
+        start.X = MAT(0, 0) * left + MAT(1, 0) * top + MAT(2, 0);
+        start.Y = MAT(0, 0) * left + MAT(1, 0) * top + MAT(2, 0);
+
+        end.X   = MAT(0, 0) * right + MAT(1, 0) * bottom + MAT(2, 0);
+        end.Y   = MAT(0, 0) * right + MAT(1, 0) * bottom + MAT(2, 0);
+    }
+
+	PCoord topLeft = PCoord(PValue::Round(start.X), PValue::Round(start.Y));
+	PCoord bottomRight = PCoord(PValue::Round(end.X), PValue::Round(end.Y));
+
+	if (topLeft.X >= bottomRight.X)
+		bottomRight.X = topLeft.X + 1;
+	
+	if (topLeft.Y >= bottomRight.Y)
+		bottomRight.Y = topLeft.Y + 1;
+
+	s->clipRect = PRect(topLeft, bottomRight);
+	
+	s->clipValid = true;
+	
+    m_stateChanged = true;
+}
+
+void PGContext::addClipRect(int left, int top, int right, int bottom)
+{
+	gfxLog("%f:%f, %f:%f", (float) left, (float) right, (float) top, (float) bottom);
+
+	PGContextState* s = currState();
+
+	PVertex2D start(left + m_offset_x, top + m_offset_y);
+	PVertex2D end(right + m_offset_x, bottom + m_offset_y);
+
+	start = s->matrix * start;
+	end = s->matrix * end;
+
+    if (currState()->Extended) {
+        start.X = MAT(0, 0) * left + MAT(1, 0) * top + MAT(2, 0);
+        start.Y = MAT(0, 0) * left + MAT(1, 0) * top + MAT(2, 0);
+
+        end.X   = MAT(0, 0) * right + MAT(1, 0) * bottom + MAT(2, 0);
+        end.Y   = MAT(0, 0) * right + MAT(1, 0) * bottom + MAT(2, 0);
+    }
+
+	PCoord topLeft = PCoord(PValue::Round(start.X), PValue::Round(start.Y));
+	PCoord bottomRight = PCoord(PValue::Round(end.X), PValue::Round(end.Y));
+
+	if (topLeft.X >= bottomRight.X)
+		return;
+	
+	if (topLeft.Y >= bottomRight.Y)
+		return;
+
+	if (s->clipValid) {
+		
+		s->clipRect = intersectRects(s->clipRect, PRect(topLeft, bottomRight));
+	}
+	else {
+	
+		s->clipRect = PRect(topLeft, bottomRight);
+		s->clipValid = true;
+	}
+	
+    m_stateChanged = true;    
+}
+
+void PGContext::_addClipRect(float left, float top, float right, float bottom)
+{
+	gfxLog("%f:%f, %f:%f", (float) left, (float) right, (float) top, (float) bottom);
+
+	PGContextState* s = currState();
+
+    if (m_offset_x || m_offset_y) {
+
+       left = PValue((int)left + m_offset_x);
+       right = PValue((int)right + m_offset_x);
+       top = PValue((int)top + m_offset_y);
+       bottom = PValue((int)bottom + m_offset_y);
+    }
+
+    PVertex2D start(left, top);
+    PVertex2D end(right, bottom);
+
+	start = s->matrix * start;
+	end = s->matrix * end;
+
+	PCoord topLeft = PCoord(PValue::Round(start.X), PValue::Round(start.Y));
+	PCoord bottomRight = PCoord(PValue::Round(end.X), PValue::Round(end.Y));
+
+	if (topLeft.X >= bottomRight.X)
+		return;
+	
+	if (topLeft.Y >= bottomRight.Y)
+		return;
+
+	if (s->clipValid) {
+		
+		s->clipRect = intersectRects(s->clipRect, PRect(topLeft, bottomRight));
+	}
+	else {
+	
+		s->clipRect = PRect(topLeft, bottomRight);
+		s->clipValid = true;
+	}
+	
+    m_stateChanged = true;    
+}
