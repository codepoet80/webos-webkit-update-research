+    m_data->context->setStrokeColor(colorToPColor(strokeColor()));
+
+	m_data->context->setFillColor(PColor32(0x0, 0x0, 0x0, 0x0));
+
+	m_data->context->drawPath(m_data->currentPath.platformPath());
