+void GraphicsContext::drawConvexPolygon(size_t npoints, const FloatPoint* points, bool shouldAntialias)
+{
+	if (paintingDisabled())
+		return;
+
+    if (npoints <= 1)
+        return;
+
+	int x[npoints], y[npoints];
+
+	for (unsigned int i = 0; i < npoints; i++) {
+		x[i] = points[i].x();
+		y[i] = points[i].y();
+	}
+
+	m_data->context->push();
+
+	m_data->context->setStrokeColor(colorToPColor(strokeColor()));
+
+    m_data->context->setStrokeThickness(strokeThickness());
+	
+	m_data->context->drawPolygon(x, y, (unsigned int) npoints, true, shouldAntialias);
+
+	m_data->context->pop();	
+}
