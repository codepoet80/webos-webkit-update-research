+bool ClipboardCutCommand::execute() const
+{
+    if (!m_frame)
+        return false;
+
+    return m_frame->editor()->command("Cut").execute();
+}
+
+bool ClipboardCutCommand::enabled(const WebCore::Frame* frame)
+{
+    if (!frame)
+        return false;
+
+    if (frame->selection()->isRange() && frame->selection()->isContentEditable())
+        return true;
+
+    return false;
+}
