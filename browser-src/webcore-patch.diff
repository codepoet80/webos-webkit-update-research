+            true,  // cancelable
+            doc->defaultView(),        // view
+            0,                         // detail
+            magHeading, trueHeading, accuracy,    // acceleration
+            time);
+
+    target->dispatchEvent(event, ec);
+
+    bool handled = event->defaultHandled() || event->defaultPrevented();
+
+    return handled;
+}
+
+bool EventHandler::dispatchOrientationChangeEvent(const int position,
+                                                  const float pitch,
+                                                  const float roll,
+                                                  const uint32_t time)
+{
+
+    Document* doc = m_frame->document();
+    if (!doc)
