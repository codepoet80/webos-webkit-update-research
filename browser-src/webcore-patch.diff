+
+void PGContext::drawArc( PVertex2D center, PVertex2D radii,
+                         float startAngle, float extentAngle, bool closed)
+{
+	gfxLog("center: %f, %f radii: %f, %f startAngle: %f extentAngle: %f closed: %d",
+		   (float) center.X, (float) center.Y, 
+		   (float) radii.X, (float) radii.Y,
+		   (float) startAngle, (float) extentAngle, closed);
+
+    applyState();
+
+    if (m_offset_x || m_offset_y)
+        center += PVertex2D (m_offset_x, m_offset_y);
+
+	// Ensure start angle is in range 0..360
+    const float ThreeSixty = float(360);
+	
+    while (startAngle < float(0)) {
+		startAngle += ThreeSixty;
+	}
+	while (startAngle > ThreeSixty) {
+		startAngle -= ThreeSixty;
+	}
+
+	// Ensure extent angle is in range -360..360	
+	while (extentAngle < -ThreeSixty) {
+		extentAngle += ThreeSixty;
+	}
+	while (extentAngle > ThreeSixty) {
+		extentAngle -= ThreeSixty;
+	}
+
+	const bool drawPie = false;
+	m_gc->DrawArc(center, radii, startAngle, extentAngle, drawPie, closed);
+}
