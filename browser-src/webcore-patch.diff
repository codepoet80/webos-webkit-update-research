+++ webkit/WebCore/platform/graphics/pg/PGSurface.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,1131 @@
+/* ============================================================
+ * Date  : 2008-08-08
+ * Copyright 2008 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#include "config.h"
+
+#include <png.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+#include <math.h>
+
+extern "C" {
+#include <jpeglib.h>
+}
+
+#include "PGSurface.h"
+#include "PGContextIface.h"
+#include "PGThreadGlobalContext.h"
+
+#include "palmmemstats.h"
+
+struct PGJpegErrorMgr {
+	struct jpeg_error_mgr pub;
+	jmp_buf setjmpBuffer;	
+};
+
+static void
+PrvJpegReadErrorExit(j_common_ptr cinfo)
+{
+	PGJpegErrorMgr* err = (PGJpegErrorMgr*) cinfo->err;
+	(*cinfo->err->output_message) (cinfo);
+	longjmp(err->setjmpBuffer, 1);
+}
+
+PGSurface* PGSurface::createFromJPEGFile(const char* filePath)
+{
+	PGSurface* surf = 0;
+
+	struct jpeg_decompress_struct cinfo;
+	PGJpegErrorMgr jerr;
+	FILE* fp;
+	uint8_t*  scanLines[4];
+	uint8_t*  scanBuffer = 0;
+	int numScanLinesRead = 0;
+	uint8_t* sPtr = 0;
+	uint32_t* dPtr = 0;
+    void* bits = 0;
+	  
+
+	fp = fopen(filePath, "rb");
+	if (!fp)
+		return 0;
+
+	cinfo.err = jpeg_std_error(&jerr.pub);
+	jerr.pub.error_exit = PrvJpegReadErrorExit;
+
+	if (setjmp(jerr.setjmpBuffer)) {
+		jpeg_destroy_decompress(&cinfo);		
+		fclose(fp);
+		free(scanBuffer);
+        if (bits)
+            free(bits);
+		if (surf)
+			surf->releaseRef();
+		return 0;
+	}
+
+	jpeg_create_decompress(&cinfo);
+	jpeg_stdio_src(&cinfo, fp);
+
+	if (jpeg_read_header(&cinfo, TRUE) != JPEG_HEADER_OK) {
+		longjmp(jerr.setjmpBuffer, 1);
+		return 0;
+	}
+
+	// Speed at expense of quality
+	cinfo.out_color_space     = JCS_RGB;
+	cinfo.dither_mode         = JDITHER_NONE;
+	cinfo.dct_method          = JDCT_IFAST;
+	cinfo.do_fancy_upsampling = FALSE;
+	cinfo.do_block_smoothing  = FALSE;
+		
+	(void) jpeg_start_decompress(&cinfo);
+
+	// According to libjpeg.doc, max number of scanlines that can be read
+	// in one shot is 4
+	scanBuffer = (uint8_t*) malloc(cinfo.output_width * 3 * 4);
+	if (!scanBuffer) {
+		longjmp(jerr.setjmpBuffer, 1);
+		return 0;
+	}
+
+	for (int i = 0; i < 4; i++) {
+		scanLines[i] = scanBuffer + i * cinfo.output_width * 3;
+	}
+
+    bits = malloc(cinfo.image_width * cinfo.image_height * 4);
+    if (!bits) {
+        longjmp(jerr.setjmpBuffer, 1);
+        return 0;
+    }
+
+	dPtr = (uint32_t*)bits;
+
+	while (cinfo.output_scanline < cinfo.output_height) {
+
+		numScanLinesRead = jpeg_read_scanlines(&cinfo, scanLines,
+											   cinfo.rec_outbuf_height);
+
+		sPtr = scanBuffer;		
+		for (int j = 0; j < numScanLinesRead; j++) {
+			for (unsigned int i = 0; i < cinfo.output_width; i++) {
+				*dPtr++ = 0xFF000000 |
+						  sPtr[0] << 16 |
+						  sPtr[1] <<  8 |
+						  sPtr[2];
+				sPtr += 3;
+			}
+		}
+	}
+
+	jpeg_finish_decompress(&cinfo);
+	jpeg_destroy_decompress(&cinfo);
+	
+	fclose(fp);
+	free(scanBuffer);
+
+    surf = PGSurface::create(cinfo.image_width, cinfo.image_height, false, (unsigned char*)bits);
+    if (!surf) {
+        longjmp(jerr.setjmpBuffer, 1);
+        return 0;
+    }
+
+    free(bits);
+
+	return surf;
+}
