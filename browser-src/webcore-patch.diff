+
+struct PGGradient
+{
+    PGGradient() : colors(0), dist(0) { }
+    ~PGGradient() {
+
+        delete[] colors;
+        delete[] dist;
+    }
+
+    unsigned long* colors;
+    PValue* dist;
+    PColorRamp ramp;
+};
+
+
+namespace WebCore {
+
+void Gradient::platformDestroy()
+{
+    delete m_gradient;
+    m_gradient = 0;
+}
+
+PlatformGradient Gradient::platformGradient()
+{
+    if( !m_gradient )
+    {
+        m_gradient = new PGGradient();
+
+        if( m_radial )
+        {
+            m_gradient->colors = new unsigned long[ m_stops.size() ];
+            m_gradient->dist = new PValue[ m_stops.size() ];
+
+            //printf("RADIAL\nstart=%d,%d,%d   end=%d,%d,%d   %d,%d,%d,%d\n",
+            //    (int)m_p0.x(), (int)m_p0.y(), (int)m_r0,
+            //    (int)m_p1.x(), (int)m_p1.y(), (int)m_r1,
+            //    (int)rect.x(), (int)rect.y(),
+            //    (int)rect.right(), (int)rect.bottom() );
+
+            // Note : We can't implement this to spec with the software back-end of Piranha right now
+
+            for( unsigned i=0; i<m_stops.size(); i++ )
+            {
+                ColorStop& stop = m_stops[i] ;
+                //printf(" offset=%f (%d)   %f,%f,%f,%f\n",stop.stop, int( rect.width() * stop.stop ), stop.red, stop.green, stop.blue, stop.alpha );
+                m_gradient->colors[i] = ((int)( stop.alpha * 255.0 ) << 24);
+                m_gradient->colors[i] |= ((int)( stop.red * 255.0 ) << 16);
+                m_gradient->colors[i] |= ((int)( stop.green * 255.0 ) << 8);
+                m_gradient->colors[i] |= ((int)( stop.blue * 255.0 ));
+
+                m_gradient->dist[i] = PValue( (m_r1  ) * stop.stop );
+            }
+
+            m_gradient->ramp.SetStopPoints( (PColor32 *)m_gradient->colors, m_gradient->dist, m_stops.size() );
+
+            PMatrix3D Matrix = gradientSpaceTransform();
+            Matrix.Translate( PVertex2D( m_p1.x(), m_p1.y() ) );
+
+            m_gradient->ramp.SetTransform(&Matrix);
+        }
+        else
+        {
+            // LINEAR
+
+            // Gradient goes from p0..p1 with m_stops in between.
+            // There is an affine matrix to be applied in between.
+            //printf(" rect=%d,%d,%d,%d   vector: %d,%d -- %d,%d\n",
+            //    (int)rect.x(), (int)rect.y(), (int)rect.right(), (int)rect.bottom(),
+            //    (int)m_p0.x(), (int)m_p0.y(), (int)m_p1.x(), (int)m_p1.y());
+
+            //printf("LINEAR\nstart=%d,%d,%d   end=%d,%d,%d   %d,%d,%d,%d\n",
+            //    (int)m_p0.x(), (int)m_p0.y(), (int)m_r0,
+            //    (int)m_p1.x(), (int)m_p1.y(), (int)m_r1,
+            //    (int)rect.x(), (int)rect.y(),
+            //    (int)rect.right(), (int)rect.bottom() );
+
+            m_gradient->colors = new unsigned long[ m_stops.size() ];
+            m_gradient->dist = new PValue[ m_stops.size() ];
+
+            //printf(" %d stops\n", m_stops.size() );
+            for( unsigned i=0; i<m_stops.size(); i++ )
+            {
+                ColorStop& stop = m_stops[i] ;
+                //printf(" offset=%f (%d)   %f,%f,%f,%f\n",stop.stop, int( rect.width() * stop.stop ), stop.red, stop.green, stop.blue, stop.alpha );
+                m_gradient->colors[i] = ((int)( stop.alpha * 255.0 ) << 24);
+                m_gradient->colors[i] |= ((int)( stop.red * 255.0 ) << 16);
+                m_gradient->colors[i] |= ((int)( stop.green * 255.0 ) << 8);
+                m_gradient->colors[i] |= ((int)( stop.blue * 255.0 ));
+
+                // Need to scale the values with the length of the vector later
+                m_gradient->dist[i] = PValue( /* rect.width() * */ stop.stop );
+            }
+
+            m_gradient->ramp.SetStopPoints( (PColor32 *)m_gradient->colors, m_gradient->dist, m_stops.size() );
+        }
+    }
+
+    return m_gradient;
+}
+
+void Gradient::fill(GraphicsContext* context, const FloatRect& rect)
+{
+    platformGradient();
+
+    if( m_radial )
+    {
+        PGContext* c = (PGContext*)context->platformContext();
+        PContext2D* c2d = c->pgContext();
+
+        PMatrix3D Matrix = gradientSpaceTransform();
+        Matrix.Translate( PVertex2D( m_p1.x()+c->originX(), m_p1.y()+c->originY() ) );
+
+        m_gradient->ramp.SetTransform(&Matrix);
+
+        // m_p0        center of start circle
+        // m_r0     radius of start circle
+        // m_p1        center of end circle
+        // m_r1        radius of end circle
+
+        c2d->SetStrokeRGrad(&(m_gradient->ramp));
+        c2d->SetFillRGrad(&(m_gradient->ramp));
+
+        PMatrix3D transM = c->matrix();
+        c2d->SetTransform( &transM );
+        c2d->DrawRectangle( PVertex2D( rect.x(), rect.y() ), PVertex2D( rect.right(), rect.bottom() ) );
+    }
+    else
+    {
+        // LINEAR
+
+        // Gradient goes from p0..p1 with m_stops in between.
+        // There is an affine matrix to be applied in between.
+        //printf(" rect=%d,%d,%d,%d   vector: %d,%d -- %d,%d\n",
+        //    (int)rect.x(), (int)rect.y(), (int)rect.right(), (int)rect.bottom(),
+        //    (int)m_p0.x(), (int)m_p0.y(), (int)m_p1.x(), (int)m_p1.y());
+
+        //printf("LINEAR\nstart=%d,%d,%d   end=%d,%d,%d   %d,%d,%d,%d\n",
+        //    (int)m_p0.x(), (int)m_p0.y(), (int)m_r0,
+        //    (int)m_p1.x(), (int)m_p1.y(), (int)m_r1,
+        //    (int)rect.x(), (int)rect.y(),
+        //    (int)rect.right(), (int)rect.bottom() );
+
+
+        PGContext* c = (PGContext*)context->platformContext();
+        PContext2D* c2d = c->pgContext();
+
+        PMatrix3D Matrix = gradientSpaceTransform();
+
+        // Compute angle of linear direction vector
+        const float k_PI = 3.14159265f;
+        float angle= (180.0f / k_PI ) * atan2( (float) ( m_p1.y() - m_p0.y() ),
+            (float) ( m_p1.x() - m_p0.x() ));
+        Matrix.Rotate(PValue(-angle));
+        Matrix.Scale( PVertex2D( rect.width(), rect.height() ) );
+        Matrix.Translate( PVertex2D( rect.x()+c->originX(), rect.y()+c->originY() ) );
+
+        m_gradient->ramp.SetTransform(&Matrix);
+
+        c2d->SetStrokeLGrad(&(m_gradient->ramp));
+        c2d->SetFillLGrad(&(m_gradient->ramp));
+
+        PMatrix3D transM = c->matrix();
+        c2d->SetTransform( &transM );
+        c2d->DrawRectangle( PVertex2D(rect.x(),rect.y()), PVertex2D(rect.right(),rect.bottom()) );
+    }
+
+}
+
+} //namespace
