+MediaPlayerPrivate::~MediaPlayerPrivate()
+{
+    PRINTF_BLUE("%s MediaPlayerPrivate::~MediaPlayerPrivate %p", getTimeStamp(), this);
+    disconnect();
+    deinit();
+    if (m_videoFrameCaptured)
+        m_videoFrameCaptured->releaseRef();
+}
+
+void MediaPlayerPrivate::init()
+{
+    bool result = true;
+    LSError lserror;
+    LSErrorInit(&lserror);
+
+    if (!m_serverHandle) {
+        result = LSRegisterPalmService(0, &m_serverHandle, &lserror);
+        if (!result) {
+            LSErrorPrint(&lserror, stderr);
+            LSErrorFree(&lserror);
+        } else {
+            result = LSGmainAttachPalmService(m_serverHandle, Palm::WebGlobal::mainLoop(), &lserror);
+
+            if (!result) {
+                LSErrorPrint(&lserror, stderr);
+                LSErrorFree(&lserror);
+            }
+        }
+    }
+}
