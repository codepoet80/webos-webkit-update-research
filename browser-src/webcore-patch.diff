+		return;
+
+    applyState();
+
+    if (m_offset_x || m_offset_y)
+        for (unsigned int ix = 0; ix < count; ix++) {
+            x[ix] = x[ix] + m_offset_x;
+            y[ix] = y[ix] + m_offset_y;
+        }
+
+    PVertex2D pts[count];
+    for (unsigned int i = 0; i < count; i++) {
+        pts[i].X = x[i];
+        pts[i].Y = y[i];
+	}
+	
+    m_gc->DrawPolygon(pts, count, closed);
+}
