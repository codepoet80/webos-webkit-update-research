diff -r -u -N trunk/WebCore/platform/graphics/pg/PGLruCache.h webkit/WebCore/platform/graphics/pg/PGLruCache.h
--- trunk/WebCore/platform/graphics/pg/PGLruCache.h	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGLruCache.h	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,145 @@
+/* ============================================================
+ * Date  : 2009-03-09
+ * Copyright 2009 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#ifndef PGLRUCACHE_H
+#define PGLRUCACHE_H
+
+#include <map>
+#include <algorithm>
+
+template <typename Key, typename Value>
+class PGLruCache
+{
+public:
+
+	PGLruCache();
+	~PGLruCache();
+
+	void setMaxSize(int maxSize);
+
+	Value* find(const Key& key);
+	void add(const Key& key, Value* value);
+
+	void clear();   
+
+private:
+
+	void prune();
+	
+	class PGLruCacheEntry {
+	public:
+
+		PGLruCacheEntry() : next(this), prev(this), value(0) {}
+		PGLruCacheEntry(Value* val) : next(this), prev(this), value(val) {}
+		~PGLruCacheEntry() { delete value; }
+	
+		PGLruCacheEntry* next;
+		PGLruCacheEntry* prev;
+		Value* value;
+	};	
+	
+	std::map<Key, PGLruCacheEntry*> m_cache;
+	PGLruCacheEntry* m_list;
+	int m_currSize;
+	int m_maxSize;
+};
+
+template <typename Key, typename Value>
+PGLruCache<Key, Value>::PGLruCache()
+	: m_list(new PGLruCacheEntry)
+	, m_currSize(0)
+	, m_maxSize(0)
+{	
+}
+
+template <typename Key, typename Value>
+PGLruCache<Key, Value>::~PGLruCache()
+{
+	clear();
+	delete m_list;
+}
+
+template <typename Key, typename Value>
+void PGLruCache<Key, Value>::setMaxSize(int maxSize)
+{
+	m_maxSize = maxSize;
+	prune();
+}
+
+template <typename Key, typename Value>
+Value* PGLruCache<Key, Value>::find(const Key& key)
+{
+	typename std::map<Key, PGLruCacheEntry*>::iterator it = m_cache.find(key);
+	if (it == m_cache.end())
+		return 0;
+
+	// Move to beginning of list
+	PGLruCacheEntry* entry = (*it).second;
+	if (m_list->next == entry)
+		return entry->value;
+
+	// Remove from list
+	entry->next->prev = entry->prev;
+	entry->prev->next = entry->next;
+	entry->next = entry;
+	entry->prev = entry;
+
+	// this is the new head
+	m_list->next->prev = entry;
+	entry->next = m_list->next;
+	entry->prev = m_list;
+	m_list->next = entry;
+
+	return entry->value;
+}
+
+template <typename Key, typename Value>
+void PGLruCache<Key, Value>::add(const Key& key, Value* value)
+{
+	PGLruCacheEntry* entry = new PGLruCacheEntry(value);
+	if (!m_list) {
+		m_list = entry;
+		return;
+	}
+	
+	// This is the new head
+	m_list->next->prev = entry;
+	entry->next = m_list->next;
+	entry->prev = m_list;
+	m_list->next = entry;
+
+	m_cache[key] = entry;
+	m_currSize += value->size();
+
+	prune();
+}
+
+template <typename Key, typename Value>
+void PGLruCache<Key, Value>::clear()
+{
+	// FIXME: implement
+}
+
+template <typename Key, typename Value>
+void PGLruCache<Key, Value>::prune()
+{
+	if (m_currSize <= m_maxSize)
+		return;
+
+	PGLruCacheEntry* entry = m_list->prev;
+	while (entry != m_list && m_currSize > m_maxSize) {
+
+		entry->prev->next = m_list;
+		m_list->prev = entry->prev;
+
+		m_currSize -= entry->value->size();
+		m_cache.erase(entry->value->key());
+		delete entry;
+		
+		entry = m_list->prev;
+	}
+}
+
+#endif /* PGLRUCACHE_H */
diff -r -u -N trunk/WebCore/platform/graphics/pg/PGPath.cpp webkit/WebCore/platform/graphics/pg/PGPath.cpp
--- trunk/WebCore/platform/graphics/pg/PGPath.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGPath.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,300 @@
+
+// Copyright 2010 Palm Inc.
+
+#include "config.h"
+
+#include <string.h>
+#include <stdio.h>
+#include <PContext.h>
+#include "PGPath.h"
+#include "TransformationMatrix.h"
+#include "PGContext.h"
+#include "PGThreadGlobalContext.h"
+
+PGPath::PGPath() 
+	: m_data(NULL),
+	  m_dataAllocated(false),
+	  m_path(NULL),
+	  m_rectOnly(false)
+{
+}
+
+PGPath::PGPath(const PGPath& Path) 
+	: m_data(NULL),
+	  m_dataAllocated(false),
+	  m_path(NULL)
+{
+	copyPathData(Path);
+}
+
+PGPath& PGPath::operator=(const PGPath& Path)
+{
+	if (&Path != this) {
+		freePathData();
+		copyPathData(Path);
+	}
+	return *this;
+}
+
+PGPath::~PGPath()
+{
+	freePathData();
+}
+
+void PGPath::allocPathData(int MaxElements, int MaxPoints, PPath* Path)
+{
+	m_data = new PGPathData;
+	m_dataAllocated = true;
+
+	
+	if (m_data != NULL) {
+		m_data->MaxElements = MaxElements;
+		m_data->NumElements = 0;
+		m_data->Element = (PGPathElement*)malloc(m_data->MaxElements * sizeof(m_data->Element[0]));
+		
+		m_data->MaxPoints = MaxPoints;
+		m_data->NumPoints = 0;
+		m_data->Point = (PVertex2D*)malloc(m_data->MaxPoints * sizeof(m_data->Point[0]));
+	}
+
+	m_path = PGThreadGlobalContext::instance()->graphicsContext()->pgContext()->CreatePath();
+	if (Path != NULL) {
+		*m_path = *Path;
+	}
+}
+
+void PGPath::copyPathData(const PGPath& Path)
+{
+	PGPathData* PathData = Path.pgPathData();
+	
+	if (PathData && PathData->MaxElements > 0 && PathData->MaxPoints > 0) {
+		allocPathData(PathData->MaxElements, PathData->MaxPoints, Path.pgPath());
+		
+		if (m_data != NULL) {
+			m_data->NumElements = PathData->NumElements;
+			m_data->NumPoints = PathData->NumPoints;
+			
+			for (int i = 0; i < m_data->NumElements; i++) {
+				m_data->Element[i] = PathData->Element[i];
+			}
+			for (int i = 0; i < m_data->NumPoints; i++) {
+				m_data->Point[i] = PathData->Point[i];
+			}
+		}
+	}
+
+	m_transform = Path.m_transform;
+	m_rectOnly = Path.m_rectOnly;
+	m_floatRect = Path.m_floatRect;
+}
+
+void PGPath::freePathData()
+{	
+	if (m_dataAllocated && m_data != NULL) {
+		if (m_data->Element != NULL) {
+			free(m_data->Element);
+		}
+		if (m_data->Point != NULL) {
+			free(m_data->Point);
+		}
+		delete m_data;
+	}
+	m_data = NULL;
+	if (m_path != NULL) {
+		PGThreadGlobalContext::instance()->graphicsContext()->pgContext()->DestroyPath(m_path);
+		m_path = NULL;
+	}
+}
+
+
+int PGPath::addElement(const PGPathElement& Element)
+{
+	if (m_data == NULL) {
+		allocPathData();
+	}
+	else if (m_data->NumElements == m_data->MaxElements) {
+		m_data->MaxElements *= 2;
+		m_data->Element = (PGPathElement*) realloc(m_data->Element, m_data->MaxElements * sizeof(m_data->Element[0]));
+	}
+	m_data->Element[m_data->NumElements] = Element;
+	return m_data->NumElements++;
+}
+
+int PGPath::addPoint(const PVertex2D& Point)
+{
+	if (m_data == NULL) {
+		allocPathData();
+	}
+	else if (m_data->NumPoints == m_data->MaxPoints) {
+		m_data->MaxPoints *= 2;
+		m_data->Point = (PVertex2D*) realloc(m_data->Point, m_data->MaxPoints * sizeof(m_data->Point[0]));
+	}
+	m_data->Point[m_data->NumPoints] = Point;
+	return m_data->NumPoints++;
+}
+
+WebCore::FloatRect PGPath::boundingRect() const
+{
+    PRect rect;
+    m_path->GetBBox(rect);
+    const int x = rect.Start.X;
+    const int y = rect.Start.Y;
+    const int width = rect.End.X - x;
+    const int height = rect.End.Y - y;
+    return WebCore::FloatRect(x, y, width, height);
+}
+
+WebCore::FloatPoint PGPath::currentPosition()
+{
+	if( !m_data->NumPoints )
+		return WebCore::FloatPoint( 0, 0 );
+	
+	PVertex2D* pt = & m_data->Point[ m_data->NumPoints-1 ] ;
+	return WebCore::FloatPoint( pt->X, pt->Y );
+}
+
+void PGPath::clear()
+{
+	if (m_data != NULL) {
+		m_data->NumElements = 0;
+		m_data->NumPoints = 0;
+	}
+	if (m_path != NULL) {
+		m_path->Reset();
+	}
+}
+
+
+bool PGPath::isEmpty() const
+{
+    return (m_data == NULL) ? true : !m_data->NumPoints;
+	//return (m_path == NULL) ? true : m_path->IsEmpty();
+}
+
+	
+void PGPath::moveTo(const WebCore::FloatPoint& p)
+{
+    PVertex2D pt = PVertex2D(p.x(), p.y());
+	int idx = addPoint(pt);
+	
+	PGPathElement el(PGPathElement::MoveTo, idx);
+	addElement(el);
+	
+	m_path->MoveTo(&pt);
+}
+
+void PGPath::lineTo(const WebCore::FloatPoint& p)
+{
+    PVertex2D pt = PVertex2D(p.x(), p.y());
+	int idx = addPoint(pt);
+
+	PGPathElement el(PGPathElement::LineTo, idx);
+	addElement(el);
+	
+	m_path->LineTo(&pt);
+}
+
+void PGPath::bezierTo(const WebCore::FloatPoint& controlPoint1, const WebCore::FloatPoint& controlPoint2,
+			  const WebCore::FloatPoint& controlPoint3)
+{
+	PVertex2D pts[3];
+    pts[0] = PVertex2D(controlPoint1.x(), controlPoint1.y());
+    pts[1] = PVertex2D(controlPoint2.x(), controlPoint2.y());
+    pts[2] = PVertex2D(controlPoint3.x(), controlPoint3.y());
+
+	int idx = addPoint(pts[0]);
+	addPoint(pts[1]);	 
+	addPoint(pts[2]);
+	
+	PGPathElement el(PGPathElement::BezierTo, idx);
+	addElement(el);
+	
+	m_path->BezierTo(3, pts);
+}
+
+void PGPath::arcTo( const WebCore::FloatPoint& end, const WebCore::FloatPoint& center, const float radius, const bool ccw)
+{
+    PVertex2D End = PVertex2D(end.x(), end.y());
+    PVertex2D Center = PVertex2D(center.x(), center.y());
+	PVertex2D Radii = PVertex2D(radius, radius);
+
+    int idx = addPoint(End);
+
+    PGPathElement el(PGPathElement::ArcTo, idx);
+    addElement(el);
+
+	m_path->ArcTo(End, Center, Radii, ccw);
+}
+
+void PGPath::close()
+{
+	PGPathElement el(PGPathElement::Close, -1);
+	addElement(el);
+	m_path->Close();
+}
+
+
+void PGPath::loadPathData(PGPathData* PathData)
+{
+	freePathData();
+	
+	m_data = PathData;
+	m_dataAllocated = false;
+	
+	m_path = PGThreadGlobalContext::instance()->graphicsContext()->pgContext()->CreatePath();
+	if (m_path == NULL) {
+		return;
+	}
+
+	for (int i = 0; i < m_data->NumElements; i++) {
+		PGPathElement* el = &m_data->Element[i];
+		switch(el->Type) {
+			case PGPathElement::MoveTo:
+				m_path->MoveTo(&m_data->Point[el->PointIndex]);
+				break;
+				
+			case PGPathElement::LineTo:
+				m_path->LineTo(&m_data->Point[el->PointIndex]);
+				break;
+				
+			case PGPathElement::BezierTo:
+				m_path->BezierTo(3, &m_data->Point[el->PointIndex]);
+				break;			  
+				
+			case PGPathElement::Close:
+				m_path->Close();
+				break;
+				
+			default:
+				printf( "PGPath::load unsupported type %d\n", el->Type);
+		}
+	}
+}
+
+// WebKit seems to call transform first, and expect subsequent path
+// operations to respect the transform.
+void PGPath::transform(const WebCore::TransformationMatrix& m)
+{
+	m_transform = m;
+}
+
+void PGPath::transform(const WebCore::AffineTransform& m)
+{
+	m_transform = m;
+}
+
+void PGPath::enableRectHitDetect(bool Enable, const WebCore::FloatRect* Rect)
+{
+	m_rectOnly = Enable;
+	if (Rect) {
+		m_floatRect = *Rect;
+	}
+}
+
+bool PGPath::isRectHitDetectEnabled(WebCore::FloatRect* Rect)
+{
+	if (Rect) {
+		*Rect = m_floatRect;
+	}
+	return m_rectOnly;
+}
diff -r -u -N trunk/WebCore/platform/graphics/pg/PGPath.h webkit/WebCore/platform/graphics/pg/PGPath.h
--- trunk/WebCore/platform/graphics/pg/PGPath.h	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGPath.h	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,110 @@
+/* ============================================================
+ * Date	 : 2008-12-31
+ * Copyright 2008 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#ifndef PGPATH_H
+#define PGPATH_H
+
+#include <stdint.h>
+#include <PPath.h>
+#include <PMatrix3D.h>
+#include "PGShared.h"
+#include "FloatPoint.h"
+#include "FloatRect.h"
+#include "TransformationMatrix.h"
+#include "AffineTransform.h"
+
+struct PGPathElement
+{
+	enum ElementType
+	{
+    ArcTo,
+	MoveTo,
+	LineTo,
+	BezierTo,
+	Close,
+	};
+	ElementType Type;
+	int		PointIndex;
+
+	PGPathElement(ElementType _Type, int _PointIndex) 
+	: Type(_Type),
+	  PointIndex(_PointIndex)
+	{
+	}
+
+};
+
+struct PGPathData
+{
+	PGPathElement* Element;
+	int		   MaxElements;
+	int		   NumElements;
+	
+	PVertex2D*	   Point;
+	int		   MaxPoints;
+	int		   NumPoints;
+
+	// Not used.  Don't think Record/Playback needs the transform.
+	//PMatrix3D	   Transform;
+};
+
+	
+class PGEXPORT PGPath
+{
+public:
+
+	PGPath();
+	~PGPath();
+	
+	// Must be copiable
+	PGPath(const PGPath&);
+	PGPath& operator=(const PGPath&);
+	
+	PPath*		pgPath() const { return m_path; }
+	PGPathData* pgPathData() const { return m_data; }
+	
+	bool isEmpty() const;
+	
+	void clear();
+	void moveTo(const WebCore::FloatPoint&);
+	void lineTo(const WebCore::FloatPoint&);
+	void bezierTo(const WebCore::FloatPoint& controlPoint1, const WebCore::FloatPoint& controlPoint2, const WebCore::FloatPoint&);
+	void arcTo( const WebCore::FloatPoint& end, const WebCore::FloatPoint& center, const float radius, const bool ccw);
+	void close();
+	void transform(const WebCore::TransformationMatrix&);
+	void transform(const WebCore::AffineTransform&);
+
+    WebCore::FloatRect boundingRect() const;
+	WebCore::FloatPoint currentPosition();
+    
+	void loadPathData(PGPathData* PathData);
+
+	void enableRectHitDetect(bool Enable, const WebCore::FloatRect* Rect = NULL);
+	bool isRectHitDetectEnabled(WebCore::FloatRect* Rect = NULL);
+	
+protected:
+
+	PPath*		m_path;
+	PMatrix3D	m_transform;
+	PGPathData*	m_data;
+	bool		m_dataAllocated;
+
+	// For rectangle hit detection
+	bool                 m_rectOnly;
+	WebCore::FloatRect   m_floatRect;
+	
+	int	 addElement(const PGPathElement& Element);
+	int	 addPoint(const PVertex2D& Point);
+	
+private:
+	
+	void allocPathData(int MaxElements = 10, int MaxPoints = 20, PPath* Path = NULL);
+	void freePathData();
+	void copyPathData(const PGPath&);
+    
+	friend class PGContext;
+};
+
+#endif /* PGPATH_H */
diff -r -u -N trunk/WebCore/platform/graphics/pg/PGShared.h webkit/WebCore/platform/graphics/pg/PGShared.h
--- trunk/WebCore/platform/graphics/pg/PGShared.h	1969-12-31 16:00:00.000000000 -0800
