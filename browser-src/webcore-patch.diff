+		m_data->context->setStrokeColor(PColor32(0, 0, 0, 0));
+		m_data->context->setFillColor(PColor32(color.red(), color.green(), color.blue(), color.alpha()));
+		m_data->context->drawRect(rect.x(), rect.y(), rect.right(), rect.bottom());
+		m_data->context->pop();
