+namespace WebCore {
+
+static Vector<String> splitString(const String& str, char delimiter, int padTo)
+{
+    int pos = 0;
+    int newPos;
+    Vector<String> result;
+    String ds = str;
+    String s;
+    do {
+        newPos = ds.find(delimiter, pos);
+
+        if (newPos == -1)
+            s = ds.substring(pos);
+        else
+            s = ds.substring(pos, newPos - pos);
+        
+        if (!s.isEmpty())
+            result.append(s);
+
+        pos = newPos + 1;
+    } while (newPos != -1);
+
+    while (padTo != -1 && static_cast<int>(result.size()) < padTo)
+        result.append("");
+
+    return result;
+}
+
+/**
+ * Validate the signature of any file (with a suffix) using the plugin key.
+ */
+bool PluginPackage::isSignatureValid(const String& path)
+{
+	const char* const certfile = "/etc/ssl/certs/browser-plugin-signature.pem";
+	if (access(certfile, R_OK) != 0) {
+		return false;
+	}
+
+    gchar* g_pluginFile = g_strdup(path.utf8().data());
+
+    gchar* g_sigFile = g_strdup_printf("%s.sig", g_pluginFile);
+    if (access(g_sigFile, R_OK) != 0) {
+        g_free(g_pluginFile);
+        g_free(g_sigFile);
+		return false;
+	}
+
+	const gchar* const argv[] = {
+		"/usr/bin/openssl",
+		"dgst",
+		"-sha1",
+		"-verify",
+		certfile,
+		"-signature",
+        g_sigFile,
+        g_pluginFile,
+		NULL
+	};
+
+	bool valid(false);
+ 	GError* gerr(NULL);
+	gint exit_status(0);
+	gchar* g_stdoutBuffer(NULL);
+	gchar* g_stderrBuffer(NULL);
+
+	gboolean resultStatus = g_spawn_sync(NULL,
+			const_cast<gchar**>(argv),	// just passed to execv so safe to const cast
+			NULL,
+			GSpawnFlags(0x0),
+			NULL,
+			NULL,
+			&g_stdoutBuffer,
+			&g_stderrBuffer,
+			&exit_status,
+			&gerr);
+
+	if (resultStatus && g_stdoutBuffer) {
+		// dgst returns "Verified OK" and smime returns "Verification successful"
+        // but neither of them return success/failure in their return code which is
+        // why we need to parse stdout (Ugh!).
+		valid = strstr(g_stdoutBuffer, "Verified OK") != NULL;
+	}
+	else {
+        g_warning("ERROR running openssl to verify signature of %s", g_pluginFile);
+	}
+
+    g_free(g_pluginFile);
+    g_free(g_sigFile);
+	g_free(g_stdoutBuffer);
+	g_free(g_stderrBuffer);
+	if (gerr) {
+		g_warning("openssl error: %s", gerr->message);
+		g_error_free(gerr);
+	}
+	
+	return valid;
+}
+
+bool PluginPackage::fetchInfo()
+{
+	// We only validate signatures on user installed plugins because the others are
+	// on a read-only partition.
+	if (PalmBrowserSettings()->s_userInstalledPluginsPath[0] != '\0' &&
+			m_path.contains(PalmBrowserSettings()->s_userInstalledPluginsPath)) {
+		if (!isSignatureValid(m_path)) {
+			g_warning("Invalid signature for %s", m_path.utf8().data());
+			return false;
+		}
+    }
+    if (!m_module) {
+        struct stat st;
+
+        if (::stat(m_path.utf8().data(), &st) != 0) {
+            // Can't stat. should not happen
+            return false;
+        }
+
+        if (!S_ISREG(st.st_mode)) {
+            // Not a regular file
+            return false;
+        }
+        
+        m_module = ::dlopen(m_path.utf8().data(), RTLD_LAZY);
+        if (!m_module) {
+            LOG_NPERROR(NPERR_MODULE_LOAD_FAILED_ERROR);
+            fprintf(stderr, "plugin load error: %s\n", dlerror());
+            return false;
+        }
+    }
+
+    NP_GetMIMEDescriptionProcPtr NP_GetMIMEDescription;
+    NP_GetMIMEDescription = (NP_GetMIMEDescriptionProcPtr) ::dlsym(m_module, "NP_GetMIMEDescription");
+    if (!NP_GetMIMEDescription) {
+        LOG_NPERROR(NPERR_MODULE_LOAD_FAILED_ERROR);
+        return false;
+    }
+
+    const char* pluginMimeStr = NP_GetMIMEDescription();
+    if (!pluginMimeStr)
+        return false;
+
+    m_mimeToExtensions.clear();
+    m_mimeToDescriptions.clear();
+
+    Vector<String> mimeStrList = splitString(pluginMimeStr, ';', -1);
+    for (Vector<String>::const_iterator it = mimeStrList.begin();
+         it != mimeStrList.end(); ++it) {
+        Vector<String> mimeStr = splitString(*it, ':', -1);
+        Vector<String> exts;
+        if (mimeStr.size() == 1) {
+            // only mime-type
+            exts.append("");
+            m_mimeToExtensions.add(mimeStr[0], exts);
+            m_mimeToDescriptions.add(mimeStr[0], "");
+        }
+        else if (mimeStr.size() == 2) {
+            // mime and extension
+            exts.append(mimeStr[1]);
+            m_mimeToExtensions.add(mimeStr[0], exts);
+            m_mimeToDescriptions.add(mimeStr[0], "");
+        }
+        else if (mimeStr.size() >= 3) {
+            // mime, extension and description
+            exts.append(mimeStr[1]);
+            m_mimeToExtensions.add(mimeStr[0], exts);
+            m_mimeToDescriptions.add(mimeStr[0], mimeStr[2]);
+        }
+    }
+
+    NP_GetValueProcPtr NP_GetValue;
+    NP_GetValue = (NP_GetValueProcPtr) ::dlsym(m_module, "NP_GetValue");
+    if (!NP_GetValue) {
+        LOG_NPERROR(NPERR_MODULE_LOAD_FAILED_ERROR);
+        return false;
+    }
+
+    const char* name = 0;
+    const char* desc = 0;
+
+    NP_GetValue(NULL, NPPVpluginNameString, &name);
+    NP_GetValue(NULL, NPPVpluginDescriptionString, &desc);
+
+    if (name) {
+        m_name = name;
+    }
+
+    if (desc) {
+        m_description = desc;
+    }
+
+    return true;
+}
+
+bool PluginPackage::load()
+{
+    if (m_freeLibraryTimer.isActive()) {
+        ASSERT(m_module);
+        m_freeLibraryTimer.stop();
+    } else if (m_isLoaded) {
+        m_loadCount++;
+        return true;
+    }
+
+    if (!m_module) {
+        m_module = ::dlopen(m_path.utf8().data(), RTLD_LAZY);
+        if (!m_module) {
+            LOG_NPERROR(NPERR_MODULE_LOAD_FAILED_ERROR);
+            return false;
+        }
+    }    
+
+    m_isLoaded = true;
+
+    NP_InitializeProcPtr NP_Initialize = 0;
+    m_NPP_Shutdown = 0;
+
+    NPError npErr;
+
+    NP_Initialize  = (NP_InitializeProcPtr) ::dlsym(m_module, "NP_Initialize");
+    m_NPP_Shutdown = (NPP_ShutdownProcPtr)  ::dlsym(m_module, "NP_Shutdown");
+
+    if (!NP_Initialize || !m_NPP_Shutdown) {
+        LOG_NPERROR(NPERR_MODULE_LOAD_FAILED_ERROR);
+        goto abort;
+    }
+
+    initializeBrowserFuncs();
+
+    // Initialize the size of the m_pluginFuncs structure with the
+    // size of our structure. The plugin may know about a future
+    // (larger) structure and unless this size is set they could
+    // exceed the bounds we give them - for ref see the other
+    // platform PluginPackage*.cpp files which do this
+    memset(&m_pluginFuncs, 0, sizeof(m_pluginFuncs));
+    m_pluginFuncs.size = sizeof(m_pluginFuncs);
+
+    npErr = NP_Initialize(&m_browserFuncs, &m_pluginFuncs);
+    LOG_NPERROR(npErr);
+
+    if (npErr != NPERR_NO_ERROR)
+        goto abort;
+
+    m_loadCount++;
+    return true;
+
+ abort:
+
+    unloadWithoutShutdown(); 
+    return false;
+}
+
+bool PluginPackage::clearSiteData()
+{
+    /*
+
+    NOTE: The PluginPackage::clearSiteData() routine used to be the following:
+
+    ---
+
+    load();
+
+    if (m_isLoaded && m_pluginFuncs.clearsitedata)
+        m_pluginFuncs.clearsitedata(0, 0, -1);
+
+    unload();
+
+    ---
+
+    However this resulted in crashing bug DFISH-27217.
+
+    The issue was run down to seemingly unbalanced (or at least misunderstood) semantics
+    for load() / unload(). There was insufficient time to run down the total cause with
+    Dubonnet lockdown approaching - so we are adding this workaround which directly loads
+    the plugin and invokes the clearsites API (if supported).
+
+    Please note, where possible we are using local vars instead of the PluginPackage
+    members (module/pluginFuncs vs. m_module/m_pluginFuncs) so that we do not pollute
+    the other users of load()/unload().
+
+    One exception, we are making use of m_browserFuncs, since there was no low-impact way
+    of refactoring the initializeBrowserFuncs() routine to operate on a standalone instance
+    of NPNetscapeFuncs. This should be fine however, since this structure will never have
+    different values from one invocation to the next.
+
+    Also, please note, we are not calling dlclose() on module. We do not seem to currently
+    be invoking dlclose() on *any* dynamically loaded libraries in Palm WebKit - and I did
+    not want to run the risk of accidentally unloading a library in use by some other part
+    of the system (i.e. some lifetime control managed by the use of load()/unload()).
+
+    */
+
+    PlatformModule module = ::dlopen(m_path.utf8().data(), RTLD_LAZY);
+
+    if (module) {
+
+        NP_InitializeProcPtr NP_Initialize = (NP_InitializeProcPtr) ::dlsym(module, "NP_Initialize");
+
+        if (NP_Initialize) {
+
+            initializeBrowserFuncs();
+
+            // Initialize the size of the pluginFuncs structure with the
+            // size of our structure. The plugin may know about a future
+            // (larger) structure and unless this size is set they could
+            // exceed the bounds we give them - for ref see the other
+            // platform PluginPackage*.cpp files which do this
+            NPPluginFuncs pluginFuncs;
+            memset(&pluginFuncs, 0, sizeof(pluginFuncs));
+            pluginFuncs.size = sizeof(pluginFuncs);
+
+            if (NPERR_NO_ERROR == NP_Initialize(&m_browserFuncs, &pluginFuncs)) {
+                if (pluginFuncs.clearsitedata)
+                    pluginFuncs.clearsitedata(0, 0, -1);
+            }
+        }
+    }
+}
+
+bool PluginPackage::equal(const PluginPackage& a, const PluginPackage& b)
+{
+    if (a.m_lastModified != b.m_lastModified)
+        return false;
+
+    return a.m_path == b.m_path;
+}
+
+unsigned PluginPackage::hash() const
+{
+    unsigned hashCodes[] = {
+        m_path.impl()->hash(),
+        m_lastModified
+    };
+
+    return StringImpl::computeHash(reinterpret_cast<UChar*>(hashCodes), sizeof(hashCodes) / sizeof(UChar));
+}
+
+uint16_t PluginPackage::NPVersion() const
+{
+    return NP_VERSION_MINOR;
+}
+
+}
