+/**
+ * Writes the current image data as JPEG to an output buffer
+ *
+ * @param out      The output buffer, initialized to the correct size
+ * @param quality  The JPEG quality factor - defaults to 95
+ */
+uint32_t PGSurface::writeJPGToStream(void* out, int quality )
+{
+    if (out == NULL) {
+        g_warning("[PGSurface::writeJPGToStream] output stream must be properly initialized");
+        return 0;
+    }
+
+    struct jpeg_error_mgr jerr;
+    struct jpeg_compress_struct jpgInfo;
+    struct jpeg_destination_mgr dmgr;
+
+    memset( &jerr, 0, sizeof(jerr) );
+    memset( &jpgInfo, 0, sizeof(jpgInfo) );
+    memset( &dmgr, 0, sizeof(dmgr) );
+
+    jpgInfo.err = jpeg_std_error(&jerr);
+    jpeg_create_compress(&jpgInfo);
+
+    /* initialize our in-memory output buffer to hold the jpeg */
+    JOCTET * out_buffer   = (JOCTET*)out;
+    dmgr.init_destination    = init_buffer;
+    dmgr.empty_output_buffer = empty_buffer;
+    dmgr.term_destination    = term_buffer;
+    dmgr.next_output_byte    = out_buffer;
+    dmgr.free_in_buffer      = m_width * m_height * 3;
+    jpgInfo.dest = &dmgr;
+
+    jpgInfo.image_width = m_width;
+    jpgInfo.image_height = m_height;
+    jpgInfo.input_components = 3;
+    jpgInfo.in_color_space = JCS_RGB;
+
+    jpeg_set_defaults( &jpgInfo );
+    jpeg_set_quality( &jpgInfo, quality, TRUE );
+
+    jpeg_start_compress( &jpgInfo, TRUE );
+
+    int rowBytesWidth = m_width*4;
+    unsigned char* imageBase = (unsigned char*)m_raster;
+    unsigned char* scanline = new unsigned char[ rowBytesWidth ];
+    if( scanline )
+    {
+        while (jpgInfo.next_scanline < jpgInfo.image_height) {
+            unsigned char* sptr = imageBase +  ( jpgInfo.next_scanline * rowBytesWidth ) ;
+            unsigned char* dptr = scanline;
+            for( unsigned x = 0; x<m_width; x++ ) {
+
+                dptr[0] = sptr[2];
+                dptr[1] = sptr[1];
+                dptr[2] = sptr[0];
+
+                sptr+=4;
+                dptr+=3;
+            }
+            JSAMPROW row[1] =  { scanline };
+            jpeg_write_scanlines( &jpgInfo, row, 1);
+        }
+        delete[] scanline;
+    }
+
+    jpeg_finish_compress(&jpgInfo);
+    uint32_t size = jpgInfo.dest->next_output_byte - out_buffer;
+
+    /* For testing, write the buffer to disk to see the image
+    FILE        *outfile  = fopen("/tmp/test.jpeg", "wb");
+    fwrite(out_buffer, size, 1, outfile);
+    fclose(outfile);
+    */
+    jpeg_destroy_compress(&jpgInfo);
+    return size;
+}
