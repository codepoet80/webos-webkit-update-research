+bool PluginView::platformStart()
+{
+    VERBOSE_TRACE("");
+    ASSERT(m_isStarted);
+    ASSERT(m_status == PluginStatusLoadedSuccessfully);
+    
+    if (plugin()->pluginFuncs()->setvalue && !m_instanceData->platformStarted()) {
+        plugin()->pluginFuncs()->setvalue(instance(),
+                                          (NPNVariable) npPalmEventLoopValue,
+                                          webkit_palm_get_mainloop());
+        m_instanceData->setPlatformStarted();
+    }
+
+    if (plugin()->pluginFuncs()->getvalue) {
+        if (m_instanceData->m_cacheInstanceData) {
+            // Allow plugin to disable caching if it wants, but it can't enable it if
+            // globally disabled.
+            plugin()->pluginFuncs()->getvalue(instance(),
+                                              (NPPVariable) npPalmCachePluginValue,
+                                              &m_instanceData->m_cacheInstanceData);
+        }
+
+        bool useGraphicsContext = false;
+        NPError err = plugin()->pluginFuncs()->getvalue(instance(),
+                                                        (NPPVariable) npPalmUseGraphicsContext,
+                                                        &useGraphicsContext);
+
+        VERBOSE_TRACE("err = %d, useGraphicsContext = %s", err, useGraphicsContext ? "true" : "false");
+        m_instanceData->m_sendRaster = (err == NPERR_NO_ERROR && useGraphicsContext) ? false : true;
+
+        int interval(-1);
+        if (parent() && plugin()->pluginFuncs()->getvalue(instance(), (NPPVariable)npPalmScriptStuckTimeout, &interval) == NPERR_NO_ERROR) {
+
+            Palm::WebView* view = parent()->containingWindow();
+            Palm::WebPage* page = view ? view->page() : 0;
+            Palm::WebPageClient* client = page ? page->client() : 0;
+
+            if (client)
+                // Give the plugin an additional 5 seconds beyond the returned value to recover from a stuck script
+                // before deadlock detection kills the browserserver.
+                client->setDeadlockDetectionInterval(interval + 5);
+        }
+
+        bool isInteractive = false;
+        err = plugin()->pluginFuncs()->getvalue(instance(),
+                                                (NPPVariable) npPalmIsInteractive,
+                                                &isInteractive);
+        VERBOSE_TRACE("err = %d, isInteractive = %s", err, isInteractive ? "true" : "false");
+        m_instanceData->m_isInteractive = (err == NPERR_NO_ERROR && isInteractive) ? true: false;
+    } else {
+    	VERBOSE_TRACE("plugin()->pluginFuncs()->getvalue is null");
+        m_instanceData->m_sendRaster = true;
+        m_instanceData->m_isInteractive = false;
+    }
+    
+    VERBOSE_TRACE("m_instanceData->m_sendRaster = %s", m_instanceData->m_sendRaster ? "true" : "false");
+    // Create the buffer for the plugin to paint into if necessary
+    if (m_instanceData->m_sendRaster && !gLegacyPluginSurfaceBuffer) {
+    	int screen_width, screen_height;
+    	getScreenSize(screen_width, screen_height);
+        gLegacyPluginSurfaceBuffer = new char[screen_height * screen_width * 4];
+        gLegacyPluginContext = PGContext::create();
+    }
+    
+    if (m_instanceData->m_isInteractive) {
+        IntRect rect = frameRect();
+
+        Palm::WebView* view = parent()->containingWindow();
+
+        if (view) {
+            Palm::WebViewClient* client = view->client();
+
+            if (client) {
+                m_instanceData->m_client = client;
+                client->addInteractiveWidgetRect((uintptr_t)m_instanceData,
+                                                 rect.x(),
+                                                 rect.y(),
+                                                 rect.width(),
+                                                 rect.height(),
+                                                 Palm::InteractiveRectPlugin);
+            }
+        }
+    }
+
+    if (m_instanceData->m_cacheInstanceData) {
+        const WTF::String& attr = m_element->getAttribute("x-palm-cache-plugin");
+        if (attr == "false") {
+            m_instanceData->m_cacheInstanceData = false;
+        }
+    }
+
+    show();
+    
+    if (!(plugin()->quirks().contains(PluginQuirkDeferFirstSetWindowCall)))
+        setNPWindowRect(frameRect());
+    
+	Palm::WebView* view = parent()->containingWindow();
+	// send initial focus information to plugin
+	if (view) {
+		if (view->isViewActive())
+			handlePageGainFocus();
+		else handlePageLoseFocus();
+	}
+    return true;
+}
