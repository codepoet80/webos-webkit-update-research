diff -r -u -N trunk/WebCore/platform/graphics/pg/PGImageJpegDecoder.cpp webkit/WebCore/platform/graphics/pg/PGImageJpegDecoder.cpp
--- trunk/WebCore/platform/graphics/pg/PGImageJpegDecoder.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGImageJpegDecoder.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,250 @@
+/* ============================================================
+ * Date  : 2008-12-31
+ * Copyright 2008 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+#include <sys/time.h>
+#include <time.h>
+
+extern "C" {
+#include <jpeglib.h>
+}
+
+#include "PGImageJpegDecoder.h"
+#include "PGImageFrame.h"
+#include "PGImageDecoderFactory.h"
+
+#define PAGE_SIZE 4096
+
+struct PGImageJpegErrorMgr : public jpeg_error_mgr
+{
+	jmp_buf setjmpBuffer;	
+};
+
+static void PrvReadErrorExit(j_common_ptr cinfo)
+{
+	PGImageJpegErrorMgr* err = (PGImageJpegErrorMgr*) cinfo->err;
+	(*cinfo->err->output_message) (cinfo);
+	longjmp(err->setjmpBuffer, 1);
+}
+
+struct PGImageJpegSrcMgr : public jpeg_source_mgr
+{
+	PGImageJpegSrcMgr(const char* data, const int dataLen)
+		: m_data(data)
+		, m_dataLen(dataLen) {
+	}
+
+
+	const char* m_data;
+	const int m_dataLen;
+};
+
+static void PrvInitSource(j_decompress_ptr cinfo)
+{
+	//PGImageJpegSrcMgr* src = (PGImageJpegSrcMgr*) (cinfo->src);
+}
+
+static boolean PrvFillInputBuffer(j_decompress_ptr cinfo)
+{
+	return FALSE;
+}
+
+static void PrvSkipInputData(j_decompress_ptr cinfo, long numBytes)
+{
+	PGImageJpegSrcMgr* src = (PGImageJpegSrcMgr*) (cinfo->src);
+
+	if (numBytes > 0) {
+		src->next_input_byte += (size_t) numBytes;
+		src->bytes_in_buffer -= (size_t) numBytes;
+	}
+}
+
+static void PrvTermSource(j_decompress_ptr cinfo)
+{
+}
+
+PGImageJpegDecoder::PGImageJpegDecoder(const char* data, int dataLen)
+	: PGImageDecoder(data, dataLen)
+	, m_data(data)
+	, m_dataLen(dataLen)
+	, m_width(-1)
+	, m_height(-1)
+{    
+}
+
+PGImageJpegDecoder::~PGImageJpegDecoder()
+{    
+}
+
+bool PGImageJpegDecoder::getDimensions(int& width, int& height)
+{
+	if (m_failed)
+		return false;
+
+	if (m_width != -1 && m_height != -1) {
+		width = m_width;
+		height = m_height;
+		return true;
+	}
+	
+	struct jpeg_decompress_struct cinfo;
+
+	PGImageJpegErrorMgr errMgr;	
+	cinfo.err = jpeg_std_error(&errMgr);
+	errMgr.error_exit = PrvReadErrorExit;
+
+	if (setjmp(errMgr.setjmpBuffer)) {
+		m_failed = true;
+		jpeg_destroy_decompress(&cinfo);
+		return false;
+	}
+
+	jpeg_create_decompress(&cinfo);
+		
+	PGImageJpegSrcMgr srcMgr(m_data, m_dataLen);
+    srcMgr.init_source       = PrvInitSource;
+	srcMgr.fill_input_buffer = PrvFillInputBuffer;
+	srcMgr.skip_input_data   = PrvSkipInputData;
+	srcMgr.resync_to_restart = jpeg_resync_to_restart;
+	srcMgr.term_source       = PrvTermSource;
+
+	srcMgr.next_input_byte   = (const JOCTET*) m_data;
+	srcMgr.bytes_in_buffer   = m_dataLen;
+
+	cinfo.src = &srcMgr;
+
+	if (jpeg_read_header(&cinfo, TRUE) == JPEG_HEADER_OK) {
+
+		m_width = cinfo.image_width;
+		m_height = cinfo.image_height;
+		width = cinfo.image_width;
+		height = cinfo.image_height;
+	}
+	else {
+		longjmp(errMgr.setjmpBuffer, 1);
+		return false;
+	}
+
+	jpeg_start_decompress(&cinfo);
+	jpeg_destroy_decompress(&cinfo);
+
+	int maxSize = PGImageDecoderFactory::maxImageSize();
+	if (m_width * m_height > maxSize * maxSize) {
+		m_failed = true;
+		m_width = -1;
+		m_height = -1;
+		return false;
+	}
+	
+	return !m_failed;
+}
+
+PGImageFrame* PGImageJpegDecoder::getFrame(int frameIndex, float scale)
+{
+	if (m_failed)
+		return 0;
+
+	struct jpeg_decompress_struct cinfo;
+	unsigned char* scanLines[4];
+	unsigned char* scanBuffer = 0;
+	int numScanlinesRead = 0;
+	unsigned char* sPtr = 0;
+	unsigned int* dPtr = 0;
+	PGImageFrame* frame = 0;	
+
+	PGImageJpegErrorMgr errMgr;	
+	cinfo.err = jpeg_std_error(&errMgr);
+	errMgr.error_exit = PrvReadErrorExit;
+
+	if (setjmp(errMgr.setjmpBuffer)) {
+		jpeg_destroy_decompress(&cinfo);
+		delete frame;
+		free(scanBuffer);
+		m_failed = true;
+		return 0;
+	}
+
+	jpeg_create_decompress(&cinfo);
+
+	PGImageJpegSrcMgr srcMgr(m_data, m_dataLen);
+    srcMgr.init_source       = PrvInitSource;
+	srcMgr.fill_input_buffer = PrvFillInputBuffer;
+	srcMgr.skip_input_data   = PrvSkipInputData;
+	srcMgr.resync_to_restart = jpeg_resync_to_restart;
+	srcMgr.term_source       = PrvTermSource;
+
+	srcMgr.next_input_byte   = (const JOCTET*) m_data;
+	srcMgr.bytes_in_buffer   = m_dataLen;
+	
+	cinfo.src = &srcMgr;
+
+	if (jpeg_read_header(&cinfo, TRUE) == JPEG_HEADER_OK) {
+
+		m_width = cinfo.image_width;
+		m_height = cinfo.image_height;
+	}
+	else {
+		longjmp(errMgr.setjmpBuffer, 1);
+		return 0;
+	}
+
+	// Speed at expense of quality
+	cinfo.out_color_space     = JCS_RGB;
+	cinfo.dither_mode         = JDITHER_NONE;
+	cinfo.dct_method          = JDCT_IFAST;
+	cinfo.do_fancy_upsampling = FALSE;
+	cinfo.do_block_smoothing  = FALSE;
+	cinfo.two_pass_quantize   = FALSE;
+
+	jpeg_start_decompress(&cinfo);
+
+	frame = new PGImageFrame(m_width, m_height);
+
+	scanBuffer = (unsigned char*) malloc(cinfo.output_width * 3 * 4);
+	for (int i = 0; i < 4; i++) {
+		scanLines[i] = scanBuffer + i * cinfo.output_width * 3;
+	}
+
+	dPtr = frame->data();
+	while (cinfo.output_scanline < cinfo.output_height) {
+
+		numScanlinesRead = jpeg_read_scanlines(&cinfo, scanLines,
+											   cinfo.rec_outbuf_height);
+
+		if ((numScanlinesRead <= 0) || (numScanlinesRead > cinfo.rec_outbuf_height)) {
+			longjmp(errMgr.setjmpBuffer, 1);
+		}
+
+		sPtr = scanBuffer;
+		for (int j = numScanlinesRead; j > 0; j--) {
+
+			for (int i = cinfo.output_width; i > 0; i--) {
+
+				*dPtr++ = (sPtr[2] <<  0) |
+						  (sPtr[1] <<  8) |
+						  (sPtr[0] << 16) |
+						  (0xFF000000);
+
+				sPtr += 3;
+			}
+		}
+	}
+	
+    jpeg_finish_decompress(&cinfo);	
+	jpeg_destroy_decompress(&cinfo);
+
+	free(scanBuffer);
+
+	if (frame && scale != 1.0f) {
+		PGImageFrame* resized = frame->downSample(scale);
+		delete frame;
+		frame = resized;
+	}
+	
+	return frame;  
+}
