diff -r -u -N trunk/WebCore/platform/palm/parsedate.cpp webkit/WebCore/platform/palm/parsedate.cpp
--- trunk/WebCore/platform/palm/parsedate.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/palm/parsedate.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,414 @@
+/***************************************************************************
+ *                                  _   _ ____  _
+ *  Project                     ___| | | |  _ \| |
+ *                             / __| | | | |_) | |
+ *                            | (__| |_| |  _ <| |___
+ *                             \___|\___/|_| \_\_____|
+ *
