+class VoidCallback;
+class SQLError;
+class DatabaseWatcher;
+
+class SQLDumpWrapper : public ThreadSafeShared<SQLDumpWrapper> {
+public:
+    virtual ~SQLDumpWrapper() { }
+    virtual bool performPreflight(SQLDump*) = 0;
+    virtual bool performPostflight(SQLDump*) = 0;
+    
+    virtual SQLError* sqlError() const = 0;
+};
+
+class SQLDump : public ThreadSafeShared<SQLDump> {
+public:
+    static PassRefPtr<SQLDump> create(Database*, PassRefPtr<SQLDumpCallback>, PassRefPtr<SQLDumpErrorCallback>, PassRefPtr<VoidCallback>, PassRefPtr<SQLDumpWrapper>);
+
+    ~SQLDump();
+   
+	void setDumpFile(const String& dumpFile);
+	void setWatcher(PassRefPtr<DatabaseWatcher> watcher) { m_watcher = watcher; }
+	PassRefPtr<DatabaseWatcher> getWatcher() const { return m_watcher; }
+	int getDumpStatus() const { return m_dumpStatus; }
+    bool performNextStep();
+    
+    Database* database() { return m_database.get(); }
+
+private:
+    SQLDump(Database*, PassRefPtr<SQLDumpCallback>, PassRefPtr<SQLDumpErrorCallback>, PassRefPtr<VoidCallback>, PassRefPtr<SQLDumpWrapper>);
+
+	RefPtr<Database> m_database;
+	String	m_dumpFile;
+	RefPtr<DatabaseWatcher> m_watcher;
+	int    m_dumpStatus;
+    RefPtr<SQLDumpWrapper> m_wrapper;
+    RefPtr<SQLDumpCallback> m_callback;
+    RefPtr<VoidCallback> m_successCallback;
+    RefPtr<SQLDumpErrorCallback> m_errorCallback;
+	RefPtr<SQLError> m_dumpError;
+};
+
+} // namespace WebCore
