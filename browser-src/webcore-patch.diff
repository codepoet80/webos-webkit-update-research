diff -r -u -N trunk/WebCore/platform/graphics/pg/PGImagePngDecoder.cpp webkit/WebCore/platform/graphics/pg/PGImagePngDecoder.cpp
--- trunk/WebCore/platform/graphics/pg/PGImagePngDecoder.cpp	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/graphics/pg/PGImagePngDecoder.cpp	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,253 @@
+/* ============================================================
+ * Date  : 2009-01-13
+ * Copyright 2009 Palm, Inc. All rights reserved.
+ * ============================================================ */
+
+#include <png.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+
+#include "PGImagePngDecoder.h"
+#include "PGImageFrame.h"
+#include "PGImageDecoderFactory.h"
+
+PGImagePngDecoder::PGImagePngDecoder(const char* data, int dataLen)
+	: PGImageDecoder(data, dataLen)
+	, m_data(data)
+	, m_dataLen(dataLen)
+	, m_width(-1)
+	, m_height(-1)
+	, m_hasAlpha(false)
+{
+    
+}
+
+PGImagePngDecoder::~PGImagePngDecoder()
+{
+    
+}
+
+struct PGImagePngDecoderRead
+{
+	PGImagePngDecoderRead(const char* _data, const int _dataLen)
+		: data(_data)
+		, dataLen(_dataLen)
+		, dataReadPos(0) {
+	}
+	
+	const char* data;
+	const int dataLen;
+	int dataReadPos;	
+};
+
+static void PGImagePngDecoderReadFunction(png_structp pngPtr, png_bytep outData, png_size_t inSize)
+{
+	PGImagePngDecoderRead* rp = (PGImagePngDecoderRead*) png_get_io_ptr(pngPtr);
+	if ((rp->dataReadPos + inSize) > (unsigned int) rp->dataLen)
+		return;
+
+	memcpy(outData, rp->data + rp->dataReadPos, inSize);
+	rp->dataReadPos += inSize;
+}
+
+bool PGImagePngDecoder::getDimensions(int& width, int& height)
+{
+	if (m_failed)
+		return false;
+
+	if (m_width != -1 && m_height != -1) {
+		width = m_width;
+		height = m_height;
+		return true;
+	}
+
+	png_structp pngPtr = 0;
+	png_infop infoPtr = 0;
+	png_uint_32 w, h;
+	int bitDepth, colorType, interlaceType;
+	PGImagePngDecoderRead rinfo(m_data, m_dataLen);
+
+	pngPtr = png_create_read_struct(PNG_LIBPNG_VER_STRING, 0, 0, 0);
+	infoPtr = png_create_info_struct(pngPtr);
+
+	if (setjmp(png_jmpbuf(pngPtr))) {
+		png_destroy_read_struct(&pngPtr, &infoPtr, png_infopp_NULL);
+		m_failed = true;
+		return false;
+	}
+	
+	png_set_read_fn(pngPtr, &rinfo, &PGImagePngDecoderReadFunction);
+
+	png_read_info(pngPtr, infoPtr);
+	png_get_IHDR(pngPtr, infoPtr, &w, &h, &bitDepth, &colorType,
+				 &interlaceType, int_p_NULL, int_p_NULL);
+
+	m_width = w;
+	m_height = h;
+	width = w;
+	height = h;
+
+    if (png_get_valid(pngPtr, infoPtr, PNG_INFO_tRNS))
+        m_hasAlpha = true;
+
+	if (colorType & PNG_COLOR_MASK_ALPHA)
+		m_hasAlpha = true;
+
+	png_destroy_read_struct(&pngPtr, &infoPtr, png_infopp_NULL);
+
+	int maxSize = PGImageDecoderFactory::maxImageSize();
+	if (m_width * m_height > maxSize * maxSize) {
+		m_failed = true;
+		m_width = -1;
+		m_height = -1;
+		m_hasAlpha = false;
+		return false;
+	}
+	
+	return true;
+}
+
+PGImageFrame* PGImagePngDecoder::getFrame(int frameIndex, float scale)
+{
+	if (m_failed)
+		return 0;
+
+	png_structp pngPtr = 0;
+	png_infop infoPtr = 0;
+	png_uint_32 w, h;
+	int bitDepth, colorType, interlaceType;
+	PGImagePngDecoderRead rinfo(m_data, m_dataLen);
+	PGImageFrame* frame = 0;
+	int numPasses = 1;
+	unsigned char** lines = 0;
+
+	pngPtr = png_create_read_struct(PNG_LIBPNG_VER_STRING, 0, 0, 0);
+	infoPtr = png_create_info_struct(pngPtr);
+
+	if (setjmp(png_jmpbuf(pngPtr))) {
+		png_destroy_read_struct(&pngPtr, &infoPtr, png_infopp_NULL);
+		m_failed = true;
+		delete frame;
+		free(lines);
+		return 0;
+	}
+	
+	png_set_read_fn(pngPtr, &rinfo, &PGImagePngDecoderReadFunction);
+
+	png_read_info(pngPtr, infoPtr);
+	png_get_IHDR(pngPtr, infoPtr, &w, &h, &bitDepth, &colorType,
+				 &interlaceType, int_p_NULL, int_p_NULL);
+
+	m_width = w;
+	m_height = h;
+
+    // Extract multiple pixels with bit depths of 1, 2, and 4 from a single
+    // byte into separate bytes (useful for paletted and grayscale images).
+	if (bitDepth < 8) {
+		png_set_packing(pngPtr);
+	}
+
+	if (colorType == PNG_COLOR_TYPE_PALETTE ||
+		(colorType == PNG_COLOR_TYPE_GRAY && bitDepth < 8)) {
+		png_set_expand(pngPtr);
+	}		
+
+    // Convert paletted image to RGB format
+    if (colorType == PNG_COLOR_TYPE_PALETTE) {
+		png_set_palette_to_rgb(pngPtr);
+    }
+
+    // Downsample 16 bits/color to 8 bits/color
+    png_set_strip_16(pngPtr);
+
+    if (colorType == PNG_COLOR_TYPE_GRAY ||
+        colorType == PNG_COLOR_TYPE_GRAY_ALPHA) {
+
+		// Convert gray images to rgb
+        png_set_gray_to_rgb(pngPtr);
+
+        if (bitDepth < 8) {
+			// Expand 1,2,4 bit grayscale to 8 bit
+            png_set_gray_1_2_4_to_8(pngPtr);
+        }
+    }
+	
+    // We want data in bgr(a) lil endian format
+    png_set_bgr(pngPtr);
+    
+	// Expand paletted or RGB images with transparency to full alpha channels
+    // so the data will be available as RGBA quartets.
+	if (png_get_valid(pngPtr, infoPtr, PNG_INFO_tRNS)) {
+        png_set_tRNS_to_alpha(pngPtr);
+        m_hasAlpha = true;
+	}
+
+	if (colorType & PNG_COLOR_MASK_ALPHA)
+		m_hasAlpha = true;
+
+	// we want data in ARGB format. add an opaque filler 0xFF if alpha channel is missing
+	// this does not affect images with existing alpha channel
+	png_set_filler(pngPtr, 0xFF, PNG_FILLER_AFTER);
+	
+	// interlace handling
+	numPasses = png_set_interlace_handling(pngPtr);
+
+	frame = new PGImageFrame(w, h);
+	frame->setHasAlpha(m_hasAlpha);
+
+	lines = (unsigned char**) malloc(h * sizeof(unsigned char*));
+    for (int y = 0; y < (int) h; y++) {
+        lines[y] = (unsigned char*) frame->data() + y * w * 4;
+    }
+
+	for (int pass = 0; pass < numPasses; pass++) {
+		for (int y = 0; y < (int) h; y++) {
+			png_read_rows(pngPtr, &lines[y], png_bytepp_NULL, 1);
+		}
+	}
+
+	// Webkit expects image buffers in pre-multiplied alpha format
+	if (m_hasAlpha) {
+
+		unsigned int r, g, b, a;
+		for (int y = 0; y < (int) h; y++) {
+			unsigned char* line = lines[y];
+			for (int x = 0; x < (int) w; x++) {
+
+				a = line[3];
+				
+				if (line[3] == 0) {
+					*((unsigned int*) line) = 0;
+				}
+				else {
+
+					b = (line[0] * a) >> 8;
+					g = (line[1] * a) >> 8;
+					r = (line[2] * a) >> 8;
+
+					*((unsigned int*) line) = (a << 24) |
+											  (r << 16) |
+											  (g <<  8) |
+											  (b <<  0);
+				}
+				 
+				line +=4;			
+			}	
+		}
+	}
+
+	// read rest of file, and get additional chunks in info_ptr - REQUIRED
+	png_read_end(pngPtr, infoPtr); 
+	png_destroy_read_struct(&pngPtr, &infoPtr, png_infopp_NULL);
+	free(lines);
+
+	if (frame && scale != 1.0f) {
+		PGImageFrame* resized = frame->downSample(scale);
+		delete frame;
+		frame = resized;
+	}
+	
+	return frame;
+}
