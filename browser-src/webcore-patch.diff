+}
+
+void PGContext::setGlobalClipRect(int left, int top, int right, int bottom)
+{
+	gfxLog("%f:%f, %f:%f", (float) left, (float) right, (float) top, (float) bottom);
+
+	PGContextState* s = currState();
+
+	s->clipRect = PRect(0, 0, 1, 1);
+	s->clipValid = false;
+
+	s->globalClipRect = PRect(PValue::Round(left), PValue::Round(top), PValue::Round(right), PValue::Round(bottom));
+	s->globalClipSet = true;
+
+	m_stateChanged = true;    
+}
+
+void PGContext::setFgColor(unsigned char r, unsigned char g, unsigned char b, unsigned char a )
+{
+	setStrokeColor(PColor32(r, g, b, a));    
+}
+
+void PGContext::drawTextA(const char* str, int len, int x, int y, const PGFont* font)
+{
+	if (!str || len <= 0)
+		return;
+
+	UTFChar* utf16Str = new UTFChar[len + 1];
+	for (int i = 0; i < len; i++) {
+		utf16Str[i] = str[i];
+	}
+	utf16Str[len] = 0;
+
+	
+	setFont(const_cast<PGFont*>(font));	
+
+	applyState();
+
+	PVertex2D pt(x + m_offset_x, y + m_offset_y);
+	pt = currState()->matrix * pt;
+	pt = PVertex2D(PValue::Round(pt.X),  PValue::Round(pt.Y));
+
+	m_gc->DrawText(utf16Str, (unsigned int) len, pt);
+
+	delete [] utf16Str;
+}
+
+void PGContext::concatMatrix(const float *Data)
+{
+	gfxLog(" ");
+
+    float Copy[3][3];
+
+    if (!currState()->Extended)
+        for (int i = 0; i < 3; i++)
+            for (int j = 0; j < 3; j++)
+                Copy[i][j] = (float)currState()->matrix.Ele[j][i];
+    else
+        memcpy(Copy, currState()->Matrix, sizeof(Copy));
+
+    float Ox = Copy[0][0] * Data[4] + Copy[1][0] * Data[5] + Copy[0][2];
+    float Oy = Copy[0][1] * Data[4] + Copy[1][1] * Data[5] + Copy[1][2];
+    const float hackScaledX = MAX_HACK * Data[0];
+    const float hackScaledY = MAX_HACK * Data[3];
+ 
+    if (!currState()->Extended && ((Ox > hackScaledX) || (Oy > hackScaledY) || (Ox < -hackScaledX) || (Oy < -hackScaledY))) {
+
+        currState()->Extended = true;
+
+        // First; copy the matrix
+        for (int i = 0; i < 3; i++)
+            for (int j = 0; j < 3; j++)
+                currState()->Matrix[i][j] = (float)currState()->matrix.Ele[j][i];
+    }
+
+    if (currState()->Extended) {
+        MAT(2, 0) = Ox;
+        MAT(1, 0) = Copy[0][0] * Data[2] + Copy[1][0] * Data[3];
+        MAT(0, 0) = Copy[0][0] * Data[0] + Copy[1][0] * Data[1];
+
+        MAT(2, 1) = Oy;
+        MAT(1, 1) = Copy[0][1] * Data[2] + Copy[1][1] * Data[3];
+        MAT(0, 1) = Copy[0][1] * Data[0] + Copy[1][1] * Data[1];
+
+    } else {
+        PMatrix3D matrix;
+
+        matrix.Set(Data[0], Data[1], Data[2], Data[3], Data[4], Data[5]);
+
+        currState()->matrix *= &matrix;
+    }
+
+	m_stateChanged = true;
+}
+
+PMatrix3D PGContext::matrix() const
+{
+    return currState()->matrix;
+}
+
+void PGContext::matrix(float *Data) const
+{
+    if (currState()->Extended) {
+        Data[0] = MAT(0, 0);
+        Data[1] = MAT(1, 0);
+        Data[2] = MAT(2, 0);
+        Data[3] = MAT(0, 1);
+        Data[4] = MAT(1, 1);
+        Data[5] = MAT(2, 1);
+
+    } else {
+        Data[0] = (float)currState()->matrix.Ele[0][0];
+        Data[1] = (float)currState()->matrix.Ele[1][0];
+        Data[2] = (float)currState()->matrix.Ele[2][0];
+        Data[3] = (float)currState()->matrix.Ele[0][1];
+        Data[4] = (float)currState()->matrix.Ele[1][1];
+        Data[5] = (float)currState()->matrix.Ele[2][1];
+    }
+}
+
+PRect PGContext::getClipRect() const
+{	
+	PGContextState* s = currState();
+
+	if (s->globalClipSet) {
+
+		PRect r = s->globalClipRect;
+		
+		if (s->clipValid) 
+			r = intersectRects(r, s->clipRect);
+
+		return r;
+	}
+	else if (s->clipValid) {
+
+		return s->clipRect;
+	}
+
+	return k_EmptyRect;
+}
+
+float PGContext::getScale() const
+{
+	return currState()->scale;
+}
+
+void PGContext::downSample(PGSurface* dst, PGSurface* src)
+{
+	// TODO: use new Piranha downsampler
+	PGContext* context = create();
+	
+	context->setSurface(dst);
+	if (src->hasAlpha()) {
+		context->clearRect(0, 0, dst->width(), dst->height());
+	}
+	context->bitblt(src, 0, 0, dst->width(), dst->height());
+
+	delete context;
+}
