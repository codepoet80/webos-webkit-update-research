+{
+    Vector<DOMTimer*> timeouts;
+    for (HashMap<int, DOMTimer*>::iterator it = m_timeouts.begin(),
+            end = m_timeouts.end(); it != end; ++it)
+        // We need a separate data structure because DOMTimers automatically remove
