+void PluginView::paint(GraphicsContext* context, const IntRect& rect)
+{
+    if (m_isStarted) {
+        VERBOSE_TRACE("Painting plugin - context = 0x%08x, context->platformContext() = 0x%08x, rect = {x = %d, y = %d, width = %d, height = %d}", (unsigned int) context, (unsigned int) (context->platformContext()), rect.x(), rect.y(), rect.width(), rect.height());
+    } else {
+        VERBOSE_TRACE("Painting missing plugin");
+        paintMissingPluginIcon(context, rect);
+        return;
+    }
+    
+    if (context->paintingDisabled()) {
+        VERBOSE_TRACE("Painting disabled");
+        return;
+    }
+
+    int screen_width, screen_height;
+    getScreenSize(screen_width, screen_height);
+    VERBOSE_TRACE("screen_width = %d, screen_height = %d", screen_width, screen_height);
+
+#if P_BACKEND==P_BACKEND_GLES
+    if (m_instanceData->m_sendRaster && !gLegacyPluginSurfaceBuffer) {
+        // Create the buffer for the plugin to paint into if necessary
+        gLegacyPluginSurfaceBuffer = new char[screen_height * screen_width * 4];
+    }
+#endif
+
+    PGContext* gc = static_cast<PGContext*>(context->platformContext());
+        
+    m_npWindow.type = NPWindowTypeDrawable;
+
+    IntRect srcRect(rect);
+    srcRect.intersect(frameRect()); // clip to buffer dimensions.  frameGeometry might be bigger than the GC buffer
+    
+    if (srcRect.isEmpty())
+        return;
+
+    setNPWindowRect(frameRect()); // tell the plugin the dimensions of the window
+
+    VERBOSE_TRACE("Src rect        : {x = %d, y = %d, width = %d, height = %d}",
+                  srcRect.x(), srcRect.y(), srcRect.width(), srcRect.height());
+    VERBOSE_TRACE("Win (frame rect): {x = %d, y = %d, width = %d, height = %d}",
+                  frameRect().x(), frameRect().y(), frameRect().width(), frameRect().height());
+
+    double scale = static_cast<ScrollView*>(parent())->getScale();
+
+    int32_t dLeft   = srcRect.x();
+    int32_t dTop    = srcRect.y();
+    int32_t dWidth  = srcRect.width();
+    int32_t dHeight = srcRect.height();
+    int32_t dRight  = dLeft + dWidth;
+    int32_t dBottom = dTop + dHeight;
+    
+    dLeft   = (int32_t) (dLeft * scale);
+    dTop    = (int32_t) (dTop * scale);
+    dRight  = (int32_t) (dRight * scale);
+    dBottom = (int32_t) (dBottom * scale);
+
+    dWidth  = dRight - dLeft;
+    dHeight = dBottom - dTop;
+
+    srcRect.move(-frameRect().x(), -frameRect().y());
+
+    uint8_t*  surfRaster   = (m_instanceData->m_sendRaster) ? (uint8_t*) gLegacyPluginSurfaceBuffer : 0;
+    int32_t   surfOrigX    = (int32_t) (gc->originX() * scale);
+    int32_t   surfOrigY    = (int32_t) (gc->originY() * scale);
+    int32_t   surfRowBytes = (m_instanceData->m_sendRaster) ? screen_width * 4 : 0;
+    int32_t   surfBpp      = (m_instanceData->m_sendRaster) ? gc->getSurface()->bpp() : 0;
+
+    VERBOSE_TRACE("origin: %d:%d, %d:%d\n",
+                  (surfOrigX + dLeft), (surfOrigX + dLeft) + dWidth,
+                  (surfOrigY + dTop), (surfOrigY + dTop) + dHeight);
+    
+    if (m_instanceData->m_sendRaster) {
+        uint32_t* pRaster = (uint32_t*) surfRaster;
+        surfRaster = (uint8_t*) (pRaster + srcRect.x() + (srcRect.y() * screen_width));
+    } else {
+        uint32_t* pRaster = (uint32_t*) surfRaster;
+        surfRaster = (uint8_t*) (pRaster + (surfOrigX + dLeft) + (surfOrigY + dTop) * surfRowBytes/4);
+    }
+
+    NpPalmEventType npEvent;
+    npEvent.eventType = npPalmDrawEvent;
+    npEvent.data.drawEvent.dstBuffer    = surfRaster;
+    npEvent.data.drawEvent.dstRowBytes  = surfRowBytes;
+    npEvent.data.drawEvent.srcLeft      = srcRect.x();
+    npEvent.data.drawEvent.srcRight     = srcRect.right();
+    npEvent.data.drawEvent.srcTop       = srcRect.y();
+    npEvent.data.drawEvent.srcBottom    = srcRect.bottom();
+
+    IntRect dstRect(srcRect);
+    if (m_instanceData->m_sendRaster) {
+        if (srcRect.right() > screen_width || srcRect.bottom() > screen_height) {
+            // The Plugin is larger than the screen. Instead of creating a larger surface that uses more memory
+            // we'll downsample to the screen resolution (also, the size of our legacy offscreen buffer)
+            dstRect.scale(min((float) screen_width / (float) srcRect.right(), (float) screen_height / (float) srcRect.bottom()));
+        }
+        
+#if P_BACKEND==P_BACKEND_GLES
+        // Only send a valid PGContext if we're _not_ sending the raster
+        npEvent.data.drawEvent.graphicsContext = 0;
+#else
+        // XXX: Why are we sending a graphicsContext if we are also sending the raster buffer?
+        npEvent.data.drawEvent.graphicsContext = context->platformContext();
+#endif
+
+        npEvent.data.drawEvent.dstLeft      = dstRect.x();
+        npEvent.data.drawEvent.dstRight     = dstRect.right();
+        npEvent.data.drawEvent.dstTop       = dstRect.y();
+        npEvent.data.drawEvent.dstBottom    = dstRect.bottom();
+        
+        if (!gLegacyPluginOffscreenSurface) {
+            // Create an offscreen surface from the raster buffer
+            gLegacyPluginOffscreenSurface = PGSurface::wrap(screen_width, screen_height, surfRaster);
+        }
+        // Set the context to draw to the offscreen surface for legacy reasons
+        gLegacyPluginContext->setSurface(gLegacyPluginOffscreenSurface);
+    } else {
+        npEvent.data.drawEvent.graphicsContext = context->platformContext();
+        npEvent.data.drawEvent.dstLeft      = dLeft;
+        npEvent.data.drawEvent.dstRight     = dRight;
+        npEvent.data.drawEvent.dstTop       = dTop;
+        npEvent.data.drawEvent.dstBottom    = dBottom;
+    }
+    
+    ASSERT(parent()->isFrameView());
+    
+    if (!dispatchNPEvent((NPEvent*)&npEvent)) {
+        LOG(Events, "PluginView::paint(): Paint event not accepted");
+    }
+
+#if P_BACKEND==P_BACKEND_GLES
+    if (m_instanceData->m_sendRaster) {
+        // Upload the frame to the GPU and blit it
+        PGSurface* tempSurf = PGSurface::create(srcRect.width(), srcRect.height(), true, surfRaster);
+        gc->bitblt(tempSurf, dLeft, dTop, dRight, dBottom);
+        tempSurf->releaseRef();
+    }
+#else
+    if (m_instanceData->m_sendRaster) {
+        // blit the offscreen to the primary graphics context
+        context->platformContext()->bitblt(gLegacyPluginOffscreenSurface,
+                                           dstRect.x(), dstRect.y(), dstRect.right(), dstRect.bottom(),
+                                           dLeft, dTop, dRight, dBottom);
+    }
+#endif
+}
