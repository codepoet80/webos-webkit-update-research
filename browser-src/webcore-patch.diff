+void PluginView::frameDeleted(PluginInstanceData *instanceData)
+{
+    PluginView *view = instanceMap().get(&instanceData->m_instance);
+
+    if (view) {
+        instanceData->setElementDeleting();
+    } else {
+        if (instanceData && instanceData->m_cacheInstanceData)
+            g_pluginInstanceCache.remove(instanceData);
+        delete instanceData;
+    }
+}
+
+void PluginView::detachInstanceData()
+{
+    if (!m_instanceData)
+        return;
+
+    if(m_instanceData->m_cacheInstanceData && !m_instanceData->isElementDeleting()) {
+        // This happens if the view is deleted *before* its element.
+
+        // If we failed to find the plug-in, we'll return early in our constructor, and
+        // m_instance will be 0.
+        if (m_instance)
+            m_instance->ndata = 0;
+    } else {
+        if (m_instanceData->m_cacheInstanceData) {
+            PluginInstanceData *d = g_pluginInstanceCache.get(m_element);
+            ASSERT(d == m_instanceData);
+        }
+
+        delete m_instanceData;
+    }
+    /* since we're detaching the data, don't keep a dangling reference to the
+     * instance */
+    m_instanceData = 0;
+    m_instance = 0;
+}
