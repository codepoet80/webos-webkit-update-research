 void ScriptExecutionContext::suspendActiveDOMObjects()
 {
+#if PLATFORM(WEBOS)
+    if (m_isSuspended)
+        return; // Nothing to do if already suspended.
+#endif
     // No protection against m_activeDOMObjects changing during iteration: suspend() shouldn't execute arbitrary JS.
     HashMap<ActiveDOMObject*, void*>::iterator activeObjectsEnd = m_activeDOMObjects.end();
     for (HashMap<ActiveDOMObject*, void*>::iterator iter = m_activeDOMObjects.begin(); iter != activeObjectsEnd; ++iter) {
         ASSERT(iter->first->scriptExecutionContext() == this);
         iter->first->suspend();
     }
+#if PLATFORM(WEBOS)
+    m_isSuspended = true;
+#endif
 }
 
 void ScriptExecutionContext::resumeActiveDOMObjects()
 {
+#if PLATFORM(WEBOS)
+    if (!m_isSuspended)
+        return; // Nothing to resume if not suspended.
+#endif
     // No protection against m_activeDOMObjects changing during iteration: resume() shouldn't execute arbitrary JS.
     HashMap<ActiveDOMObject*, void*>::iterator activeObjectsEnd = m_activeDOMObjects.end();
     for (HashMap<ActiveDOMObject*, void*>::iterator iter = m_activeDOMObjects.begin(); iter != activeObjectsEnd; ++iter) {
         ASSERT(iter->first->scriptExecutionContext() == this);
         iter->first->resume();
     }
+#if PLATFORM(WEBOS)
+    m_isSuspended = false;
+#endif
 }
 
+#if PLATFORM(WEBOS)
+void ScriptExecutionContext::throttle(unsigned int throttleLevelFrom0To100Percent, unsigned int minThrottleMS)
+{
+    // The throttleLevel must be between 0 and 100.
+    if (throttleLevelFrom0To100Percent > 100)
+        throttleLevelFrom0To100Percent = 100;
+    m_minThrottleMS = minThrottleMS;
+
+    if (m_throttleLevel != throttleLevelFrom0To100Percent) {
+        // If we're throttling down to 0, then just suspend it if possible.
+        if (throttleLevelFrom0To100Percent == 0 && canSuspendActiveDOMObjects()) {
+            // Suspend the active objects if not already suspended.
+            if (!m_isSuspended)
+                suspendActiveDOMObjects();
+
+        } else {
+            // If we're here because we want to suspend but can't,
+            // then approximate it by throttling down to 1%.
+            if (throttleLevelFrom0To100Percent == 0)
+                throttleLevelFrom0To100Percent = 1;
+
+            // Adjust all the timing parameters before resuming the objects.
+            HashMap<ActiveDOMObject*, void*>::iterator activeObjectsEnd = m_activeDOMObjects.end();
+            for (HashMap<ActiveDOMObject*, void*>::iterator iter = m_activeDOMObjects.begin(); iter != activeObjectsEnd; ++iter) {
+                ASSERT(iter->first->scriptExecutionContext() == this);
+                iter->first->throttle(throttleLevelFrom0To100Percent, minThrottleMS);
+            }
+
+            // Resume the active objects if it was previously suspended.
+            if (m_isSuspended)
+                resumeActiveDOMObjects();
+        }
+        m_throttleLevel = throttleLevelFrom0To100Percent;
+    }
+}
+#endif
