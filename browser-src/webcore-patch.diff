+
+void Font::drawGlyphs(GraphicsContext* context, const SimpleFontData* font, const GlyphBuffer& glyphBuffer,
+                      int from, int numGlyphs, const FloatPoint& point) const
+{
+	GlyphBufferGlyph* glyphs = (GlyphBufferGlyph*) glyphBuffer.glyphs(from);
+
+	PGContextIface* c = context->platformContext();
+
+	c->push();
+
+	Color color = context->fillColor();
+	c->setStrokeColor(PColor32(color.red(), color.green(), color.blue(), color.alpha()));
+
+	font->setFont(c);
+	
+	PGFallbackFonts* fallbackFonts = PGFallbackFonts::threadSpecificInstance();
+	if( fallbackFonts )
+		fallbackFonts->setFallbackFontsIntoContext( c );
+	
+	// Piranha will take care of matching the point sizes for the fonts. we don't really need
+	// to specify the font size here. but specifying a fixed one allows us to reuse the same
+	// font again and again
+	
+	float xOffset[numGlyphs];
+	float yOffset;
+	
+	float offset = point.x();
+
+	yOffset = point.y();		
+	for (int i = 0; i < numGlyphs; i++) 
+	{
+		xOffset[i] = offset;
+		offset += glyphBuffer.advanceAt(from + i);
+	}
+
+	c->drawCharacters(numGlyphs, glyphs, xOffset, yOffset);
+   
+	c->pop();
+}
