+#if PLATFORM(WEBOS)
+
+/**
+ * Manage a plugin instance cache so that they can be reused. This class is 
+ * a map that associates the DOM Element with it's plugin. It will also register 
+ * to be notified when the Element is deleted and will delete the Plugin at 
+ * that time.
+ */
