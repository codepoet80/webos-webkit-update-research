diff -r -u -N trunk/WebCore/platform/palm/Parser.h webkit/WebCore/platform/palm/Parser.h
--- trunk/WebCore/platform/palm/Parser.h	1969-12-31 16:00:00.000000000 -0800
+++ webkit/WebCore/platform/palm/Parser.h	2011-11-08 15:18:23.000000000 -0800
@@ -0,0 +1,32 @@
+/**
+ * @file Parser.h
+ * 
+ */
+
+#ifndef _Parser_h_
+#define _Parser_h_
+
+#include <wtf/text/WTFString.h>
+
+namespace WebCore 
+{
+
+struct ParserSpan {
+    
+    int start;  // can be negative if span expansion goes left over node boundaries
+    int end;
+    
+    WTF::String str;  // string within the span
+    
+    ParserSpan() { 
+        start = -1; 
+        end = -1; 
+        str = "";
+    }
+    
+    int length() const { return ((start <= end) ? end - start + 1 : 0); } 
+    
+};
+
+}  // namespace WebCore 
+#endif // _Parser_H_
