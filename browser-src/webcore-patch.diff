+PGSurface* PGSurface::createFromPNGFile(const char* filePath)
+{
+	PGSurface* s=0;
+	png_structp png_ptr;
+	png_infop info_ptr;
+	unsigned int sig_read = 8*sizeof(png_byte);
+	png_uint_32 width, height;
+	int bit_depth, color_type, interlace_type;
+	unsigned char** lines = 0;
+	FILE *fp;
+	png_byte header[8];
+	memset(header,0,8*sizeof(png_byte));
+	
+	fp = fopen(filePath, "rb");
+	if (!fp)
+		return 0;
+	size_t sz = fread(header, 1, sig_read, fp);
+	
+	int is_png = !png_sig_cmp(header, 0, sig_read);
+	if (!is_png)
+	{
+		printf("PGSurface::createFromPNGFile(): [%s] is not a PNG!\n",filePath);
+		fclose(fp);
+		return (0);
+	}
+
+	png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING,
+									 0, 0, 0 );  // png_voidp user_error_ptr, user_error_fn, user_warning_fn);
+	if (png_ptr == NULL) {
+		fclose(fp);
+		return (0);
+	}
+
+	// Allocate/initialize the memory for image information.  REQUIRED.
+	info_ptr = png_create_info_struct(png_ptr);
+	if (info_ptr == NULL) {
+		fclose(fp);
+		png_destroy_read_struct(&png_ptr, png_infopp_NULL, png_infopp_NULL);
+		return (0);
+	}
+
+    if (setjmp(png_jmpbuf(png_ptr))) {
+
+        png_destroy_read_struct(&png_ptr, &info_ptr, png_infopp_NULL);
+        fclose(fp);
+
+        if (lines)
+            delete [] lines;
+
+        if (s)
+            s->releaseRef();
+        return 0;
+    }
+
+	
+	png_init_io(png_ptr, fp);
+	
+	// If we have already read some of the signature
+	png_set_sig_bytes(png_ptr, sig_read);
+	
+ 	// The call to png_read_info() gives us all of the information from the
+	// PNG file before the first IDAT (image data chunk).  REQUIRED
+	png_read_info(png_ptr, info_ptr);
+
+	png_get_IHDR(png_ptr, info_ptr, &width, &height, &bit_depth, &color_type,
+				 &interlace_type, int_p_NULL, int_p_NULL);
+	//printf( "Load PNG : %d x %d x %d color_type=%d \n", width, height, bit_depth, color_type );
+	
+	
+    // Extract multiple pixels with bit depths of 1, 2, and 4 from a single
+    // byte into separate bytes (useful for paletted and grayscale images).
+    if (bit_depth < 8) {
+        png_set_packing(png_ptr);
+    }
+
+    // Convert paletted image to RGB format
+    if (color_type == PNG_COLOR_TYPE_PALETTE) {
+		png_set_palette_to_rgb(png_ptr);
+    }
+
+    // Downsample 16 bits/color to 8 bits/color
+    png_set_strip_16(png_ptr);
+
+    if (color_type == PNG_COLOR_TYPE_GRAY ||
+        color_type == PNG_COLOR_TYPE_GRAY_ALPHA) {
+
+		// Convert gray images to rgb
+        png_set_gray_to_rgb(png_ptr);
+
+        if (bit_depth < 8) {
+			// Expand 1,2,4 bit grayscale to 8 bit
+            png_set_gray_1_2_4_to_8(png_ptr);
+        }
+    }
+	
+    // We want data in bgr(a) lil endian format
+    png_set_bgr(png_ptr);
+
+	// we want data in ARGB format. add an opaque filler 0xFF if alpha channel is missing
+	// this does not affect images with existing alpha channel
+	png_set_filler(png_ptr, 0xFF, PNG_FILLER_AFTER);
+    
+	// Expand paletted or RGB images with transparency to full alpha channels
+    // so the data will be available as RGBA quartets.
+    bool hasAlpha = false;
+    if (png_get_valid(png_ptr, info_ptr, PNG_INFO_tRNS)) {
+        png_set_tRNS_to_alpha(png_ptr);
+        hasAlpha = true;
+    }
+
+   if (color_type & PNG_COLOR_MASK_ALPHA)
+	   hasAlpha = true;
+	
+
+	// Turn on interlace handling.  REQUIRED if you are not using
+	// png_read_image().  To see how to handle interlacing passes,
+	// see the png_read_row() method below:
+	//
+	int number_passes = png_set_interlace_handling(png_ptr);
+
+    void* bits = malloc(width * height * 4);
+    if (!bits) {
+		png_destroy_read_struct(&png_ptr, &info_ptr, png_infopp_NULL);
+		fclose(fp);
+		return 0;
+	}
+
+    lines = new unsigned char*[ height ];
+    for (int y = 0; y < (int) height; y++) {
+        lines[y] = (unsigned char*)bits + y * width * 4;
+    }
+
+	for (int pass = 0; pass < number_passes; pass++) {
+		for (int y = 0; y < (int) height; y++) {
+			png_read_rows(png_ptr, &lines[y], png_bytepp_NULL, 1);
+		}
+	}
+
+	// Webkit expects image buffers in pre-multiplied alpha format
+	if (hasAlpha) {
+		
+		unsigned int alpha;
+		for (int y = 0; y < (int) height; y++) {
+			unsigned char* line = lines[y];
+			for (int x = 0; x < (int) width; x++) {
+
+				alpha = line[3];	
+				
+				if (alpha == 0) {
+					*((unsigned int*) line) = 0;
+				}
+				else {
+
+					line[0] = (line[0]  * alpha) >> 8;
+					line[1] = (line[1]  * alpha) >> 8;
+					line[2] = (line[2]  * alpha) >> 8;
+				}
+				 
+				line +=4;			
+			}		
+		}
+	}
+
+	delete  [] lines;
+
+	// read rest of file, and get additional chunks in info_ptr - REQUIRED
+	png_read_end(png_ptr, info_ptr); 
+	png_destroy_read_struct(&png_ptr, &info_ptr, png_infopp_NULL);
+	
+    s = PGSurface::create(width, height, hasAlpha, (unsigned char*)bits);
+    if (!s) {
+        png_destroy_read_struct(&png_ptr, &info_ptr, png_infopp_NULL);
+        fclose(fp);
+        return 0;
+    }
+
+    free(bits);
+
+	fclose(fp);
+		
+	return s;    
+}
+
+struct png_file_read_info
+{
+	png_file_read_info() : sz(0), offset(0), data(0) { }
+	
+	long sz;
+	long offset;
+	const unsigned char* data;
+};
+
+static void my_png_rw_ptr(png_structp png_ptr, png_bytep outData, png_size_t inSize)
+{
+	png_file_read_info* ip = (png_file_read_info*)png_get_io_ptr(png_ptr);
+	memcpy( outData, ip->data + ip->offset, inSize );
+	ip->offset += inSize;
+}
