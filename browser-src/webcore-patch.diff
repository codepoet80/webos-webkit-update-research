+void PGContext::setFallbackFonts(PGFont** inFonts, int numFonts, PFTRangeArray* ranges)
+{
+	if( !inFonts || !numFonts || !m_gc )
+		return;
+	
+	const int kMaxFallbackFonts = 8;
+	PFont* fonts[kMaxFallbackFonts];
+	numFonts = MIN(numFonts,kMaxFallbackFonts);
+	
+	for( int i=0; i<numFonts; i++ ) {
+		fonts[i] = inFonts[i]->m_font;
