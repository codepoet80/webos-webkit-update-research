+bool ClipboardPasteCommand::enabled(const WebCore::Frame* frame)
+{
+    if (!frame)
+        return false;
+
+    String text = WebCore::Pasteboard::generalPasteboard()->plainText();
+    if (!text.isEmpty() && frame->selection()->isContentEditable())
+        return true;
+
+    return false;
