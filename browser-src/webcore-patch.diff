+bool PGSurface::writeJPG(const char* filePath, int quality )
+{
+	struct jpeg_error_mgr jerr;
+	struct jpeg_compress_struct jpgInfo;
+	FILE * hOutFile;
+	
+	memset( &jerr, 0, sizeof(jerr) );
+	memset( &jpgInfo, 0, sizeof(jpgInfo) );
+
+	jpgInfo.err = jpeg_std_error(&jerr);
+	jpeg_create_compress(&jpgInfo);
+	
+	if((hOutFile = fopen(filePath, "wb")) == NULL) {
+		return false;
+	}
+	 
+	jpeg_stdio_dest(&jpgInfo, hOutFile);
+	jpgInfo.image_width = m_width;
+	jpgInfo.image_height = m_height;
+	jpgInfo.input_components = 3;
+	jpgInfo.in_color_space = JCS_RGB;
+	
+	jpeg_set_defaults( &jpgInfo );
+	jpeg_set_quality( &jpgInfo, quality, TRUE );
+
+	jpeg_start_compress( &jpgInfo, TRUE );
+	
+	int rowBytesWidth = m_width*4;
+	unsigned char* imageBase = (unsigned char*)m_raster;
+    unsigned char* scanline = new unsigned char[ rowBytesWidth ];
+	if( scanline )
+	{
+		while (jpgInfo.next_scanline < jpgInfo.image_height) {
+			unsigned char* sptr = imageBase +  ( jpgInfo.next_scanline * rowBytesWidth ) ;
+			unsigned char* dptr = scanline;
+			for( unsigned x = 0; x<m_width; x++ ) {
+				
+				dptr[0] = sptr[2];
+				dptr[1] = sptr[1];
+				dptr[2] = sptr[0];
+				
+				sptr+=4;
+				dptr+=3;
+			}
+			JSAMPROW row[1] =  { scanline };
+			jpeg_write_scanlines( &jpgInfo, row, 1);
+		}
+		delete[] scanline;
+	}
+	 
+	jpeg_finish_compress(&jpgInfo);
+	jpeg_destroy_compress(&jpgInfo);	
+	fclose(hOutFile);
+
+	return true;	
+}
+
+/**
+ * Creates a JPEG file for writing
+ *
+ * @param fp       Pointer to a file opened for writing - cannot be NULL
+ * @param width    The width of the JPEG image
+ * @param height   The height of the JPEG image
+ * @param jpgInfo  The jpeg_compress_struct used for writing out the image data - this function will initialize it
+ * @param jerr     The jpg_err_mgr - this function will initialize it
+ * @param quality  The JPEG quality factor - defaults to 95
+ */
+bool PGSurface::openJPG(FILE* fp, int width, int height, struct jpeg_compress_struct* jpgInfo, struct jpeg_error_mgr* jerr, int quality)
+{
+    if (fp == NULL) {
+        g_warning("[PGSurface::openJPG] File pointer is null!");
+        return false;
+    }
+    memset( jerr, 0, sizeof(*jerr) );
+    memset( jpgInfo, 0, sizeof(*jpgInfo) );
+
+    jpgInfo->err = jpeg_std_error(jerr);
+    jpeg_create_compress(jpgInfo);
+    jpeg_stdio_dest(jpgInfo, fp);
+    jpgInfo->image_width = width;
+    jpgInfo->image_height = height;
+    jpgInfo->input_components = 3;
+    jpgInfo->in_color_space = JCS_RGB;
+
+    jpeg_set_defaults( jpgInfo );
+    jpeg_set_quality( jpgInfo, quality, TRUE );
+
+    jpeg_start_compress( jpgInfo, TRUE );
+    return true;
+}
+/**
+ * Appends image data to the next available scanline in the JPEG
+ *
+ * @param jpgInfo  The jpeg_compress_struct used for writing out the image data
+ * @param height   The number of rows of image data to write out
+ */
+int PGSurface::appendToJPG(struct jpeg_compress_struct* jpgInfo, int height)
+{
+    if (height < 0 || height > (int)m_height)
+        height = m_height;
+    int line = 0;
+    int rowBytesWidth = m_width*4;
+    unsigned char* imageBase = (unsigned char*)m_raster;
+    unsigned char* scanline = new unsigned char[ rowBytesWidth ];
+    if( scanline )
+    {
+        while (jpgInfo->next_scanline < jpgInfo->image_height && line < height) {
+            unsigned char* sptr = imageBase +  ( line * rowBytesWidth ) ;
+            unsigned char* dptr = scanline;
+            for( unsigned x = 0; x<m_width; x++ ) {
+
+                dptr[0] = sptr[2];
+                dptr[1] = sptr[1];
+                dptr[2] = sptr[0];
+
+                sptr+=4;
+                dptr+=3;
+            }
+            JSAMPROW row[1] =  { scanline };
+            jpeg_write_scanlines( jpgInfo, row, 1);
+            line++;
+        }
+        delete[] scanline;
+    }
+    return line;
+}
+/**
+ * Appends 0xFFFFFF to the remaining rows in the JPEG image
+ *
+ * @param jpgInfo  The jpeg_compress_struct used for writing out the image data
+ */
+int PGSurface::appendWhiteToJPG(struct jpeg_compress_struct* jpgInfo)
+{
+    int line = 0;
+    int rowBytesWidth = m_width*4;
+    unsigned char* scanline = new unsigned char[ rowBytesWidth ];
+    if( scanline )
+    {
+        unsigned char* dptr = scanline;
+        for( unsigned x = 0; x<m_width; x++ ) {
+
+            dptr[0] = 0xFF;
+            dptr[1] = 0xFF;
+            dptr[2] = 0xFF;
+
+            dptr+=3;
+        }
+        while (jpgInfo->next_scanline < jpgInfo->image_height) {
+            JSAMPROW row[1] =  { scanline };
+            jpeg_write_scanlines( jpgInfo, row, 1);
+            line++;
+        }
+        delete[] scanline;
+    }
+    return line;
+}
+/**
+ * Close the JPEG
+ *
+ * @param jpgInfo  The jpeg_compress_struct used for writing out the image data
+ */
+bool PGSurface::closeJPG(struct jpeg_compress_struct* jpgInfo)
+{
+    jpeg_finish_compress(jpgInfo);
+    jpeg_destroy_compress(jpgInfo);
+
+    return true;
+}
+
+
+struct png_encode_state
+{
+	StreamWriteFunction func;
+	void* user;		
+};
+
+static void pgsurface_png_write_flush( png_structp ) { }
+
+static void pgsurface_png_write_function( png_structp png_ptr, png_bytep data, png_size_t length )
+{
+	struct png_encode_state* state = (png_encode_state*)png_ptr->io_ptr; 
+	(state->func)( data, length, state->user );
+}
+
+bool PGSurface::writePNGToStream( StreamWriteFunction func, void* user )
+{
+	int x,y;
+	png_byte color_type = PNG_COLOR_TYPE_RGBA;
+	png_byte bit_depth=bpp();
+	
+	png_structp png_ptr;
+	png_infop info_ptr;
+
+	bit_depth = 8;
+	
+	png_encode_state callbackState;
+	callbackState.func = func;
+	callbackState.user = user;
+	
+	// initialize stuff 
+	png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
+	
+	if (!png_ptr)
+		g_warning("[write_png_file] png_create_write_struct failed");
+
+	info_ptr = png_create_info_struct(png_ptr);
+	if (!info_ptr) {
+		g_warning("[write_png_file] png_create_info_struct failed");
+		png_destroy_write_struct(&png_ptr, NULL);
+		return false;
+	}
+
+	if (setjmp(png_jmpbuf(png_ptr))) 
+	{
+		g_warning("[write_png_file] Error during init_io");
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		return false;		
+	}
+
+	png_set_write_fn( png_ptr, &callbackState, pgsurface_png_write_function, pgsurface_png_write_flush );
+
+	// write header 
+	if (setjmp(png_jmpbuf(png_ptr)))
+	{
+		g_warning("[write_png_file] Error during writing header");
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		return false;
+	}
+
+	png_set_IHDR(png_ptr, info_ptr, width(), height(),
+		     bit_depth, color_type, PNG_INTERLACE_NONE,
+		     PNG_COMPRESSION_TYPE_BASE, PNG_FILTER_TYPE_BASE);
+
+	png_write_info(png_ptr, info_ptr);
+
+	unsigned char* row2 = new unsigned char[rowbytes()];
+
+	// write bytes 
+	if (setjmp(png_jmpbuf(png_ptr)))
+	{
+		g_warning("[write_png_file] Error during writing bytes");
+		delete[] row2;
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		return false;
+	}
+
+	for (y=0; y < (int) height(); y++) {
+
+		const unsigned char* src = scanline(y);
+		unsigned char* r = row2;
+		for( x=0; x<(int)width(); x++ ) {
+
+			r[3] = src[3];
+			r[2] = src[0];
+			r[1] = src[1];
+			r[0] = src[2];
+			r += 4;
+			src += 4;
+		}
+		png_write_row( png_ptr, (unsigned char*)row2 );
+	}
+
+	delete[] row2;
+	
+	// end write 
+	if (setjmp(png_jmpbuf(png_ptr))) {
+		g_warning("[write_png_file] Error during end of write");
+	}
+	else {
+		png_write_end(png_ptr, NULL);
+	}
+
+	if (setjmp(png_jmpbuf(png_ptr))) {
+		g_warning("[write_png_file] Error cleaning up after write.");
+	}
+	else {
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+	}
+
+	return true;
+}
+
+bool PGSurface::writePNG(const char* filePath)
+{
+	int x,y;
+    volatile int num_color_bytes = m_hasAlpha ? 4 : 3;
+    volatile png_byte color_type = m_hasAlpha ? PNG_COLOR_TYPE_RGBA : PNG_COLOR_TYPE_RGB;
+	png_byte bit_depth=bpp();
+	
+	png_structp png_ptr;
+	png_infop info_ptr;
+
+	bit_depth = 8;
+	
+	// create file 
+	FILE *fp = fopen(filePath, "wb");
+	if (!fp) {
+		g_warning("[writePNG] File %s could not be opened for writing", filePath);
+		return false;
+	}
+
+	// initialize stuff 
+	png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
+	
+	if (!png_ptr)
+		g_warning("[write_png_file] png_create_write_struct failed");
+
+	info_ptr = png_create_info_struct(png_ptr);
+	if (!info_ptr) {
+		g_warning("[write_png_file] png_create_info_struct failed");
+		png_destroy_write_struct(&png_ptr, NULL);
+		fclose( fp );
+		return false;
+	}
+
+	if (setjmp(png_jmpbuf(png_ptr))) 
+	{
+		g_warning("[write_png_file] Error during init_io");
+		fclose(fp);
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		fclose( fp );
+		return false;		
+	}
+
+	png_init_io(png_ptr, fp);
+
+
+	// write header 
+	if (setjmp(png_jmpbuf(png_ptr)))
+	{
+		g_warning("[write_png_file] Error during writing header");
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		fclose( fp );
+		return false;
+	}
+
+	png_set_IHDR(png_ptr, info_ptr, width(), height(),
+		     bit_depth, color_type, PNG_INTERLACE_NONE,
+		     PNG_COMPRESSION_TYPE_BASE, PNG_FILTER_TYPE_BASE);
+
+	png_write_info(png_ptr, info_ptr);
+
+	unsigned char* row2 = new unsigned char[num_color_bytes * m_width];
+
+	// write bytes 
+	if (setjmp(png_jmpbuf(png_ptr)))
+	{
+		g_warning("[write_png_file] Error during writing bytes");
+		delete[] row2;
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+		fclose( fp );
+		return false;
+	}
+
+	for (y=0; y < (int) height(); y++) {
+
+		const unsigned char* src = scanline(y);
+		unsigned char* r = row2;
+		for( x=0; x<(int)width(); x++ ) {
+
+			if (m_hasAlpha)
+                r[3] = src[3];  //alpha
+			r[2] = src[0];  //blue
+			r[1] = src[1];  //green
+			r[0] = src[2];  //red
+			r += num_color_bytes;
+			src += 4;
+		}
+		png_write_row( png_ptr, (unsigned char*)row2 );
+	}
+
+	delete[] row2;
+	
+	// end write 
+	if (setjmp(png_jmpbuf(png_ptr))) {
+		g_warning("[write_png_file] Error during end of write");
+	}
+	else {
+		png_write_end(png_ptr, NULL);
+	}
+
+	fclose(fp);	
+
+	if (setjmp(png_jmpbuf(png_ptr))) {
+		g_warning("[write_png_file] Error cleaning up after write.");
+	}
+	else {
+		png_destroy_write_struct(&png_ptr, &info_ptr);
+	}
+	
+	return true;
+}
+
+PGSurface* PGSurface::subSurface(PRect rect) const
+{
+ 	if( !m_pixmap )
+ 		return 0;
+  	
+	if (rect.End.X <= rect.Start.X ||
+		rect.End.Y <= rect.Start.Y) {
+		printf("Invalid subSurface rect specified: %d:%d, %d:%d\n",
+			   rect.Start.X, rect.End.X,
+			   rect.Start.Y, rect.End.Y);
+		return 0;
+	}
+	
+    if( rect.End.X > (int)width() )
+		rect.End.X = width();
+    if( rect.End.Y > (int)height() )
+		rect.End.Y = height();
+
+	PointPairSurfaceMap::const_iterator it = m_subSurfaces.find(PointPair(rect.Start.Value, rect.End.Value));
+	if (it != m_subSurfaces.end()) {
+		PGSurface* s = it->second;
+		s->addRef();
+		return s;
+	}
+
+	void * bits = malloc((rect.End.X - rect.Start.X) * (rect.End.Y - rect.Start.Y) * 4);
+
+	m_pixmap->Get(rect, bits);
+
+	PGSurface* s = PGSurface::create(rect.End.X - rect.Start.X,
+					rect.End.Y - rect.Start.Y,
+					hasAlpha(), (unsigned char*)bits);
+
+	free(bits);
+
+	m_subSurfaces[PointPair(rect.Start.Value, rect.End.Value)] = s;
+	s->addRef();
+
+	return s;
+}
+
+void PGSurface::setQuality(PSampling quality)
+{
+	m_pixmap->SetQuality(quality);    
+}
+
+PGSurface* PGSurface::scale(uint32_t width, uint32_t height) const
+{
+	PGSurface* s = PGSurface::create(width, height, hasAlpha(), 0);
+#if P_BACKEND!=P_BACKEND_GLES
+    memset(s->raster(), 0, width * height * 4);
+#endif
+
+	m_context->setSurface(s);
+	m_context->bitblt(const_cast<PGSurface*>(this), 0, 0, (int) width, (int) height);
+
+	return s;
+}
+
+void PGSurface::desaturate()
+{
+    uint32_t* data = (uint32_t*) m_raster;
+
+	float redScale   = 0.30f;
+	float greenScale = 0.59f;
+	float blueScale  = 0.11f;
+
+	int r, g, b;
+	
+	for (unsigned int i = 0; i < m_width * m_height; i++) {
+
+		unsigned int a = (((*data) >> 24) & 0xFF);
+
+		if (a == 0) {
+			
+			*data++ = 0;
+		}
+		else {
+
+			r = ((*data) >> 16) & 0xFF;
+			g = ((*data) >>  8) & 0xFF;
+			b = ((*data) >>  0) & 0xFF;
+
+			r = static_cast<unsigned char>(r * redScale + g * greenScale + b * blueScale);
+
+			*data++ = a << 24 | (int) r << 16 | (int) r << 8 | (int) r;
+		}
+
+	}
+}
