+        RefPtr<PluginCacheListener> listener;
+        PluginInstanceData*  data;
+    };
+
+public:
+
+    PluginInstanceCache() {
+    }
+
+
+    ~PluginInstanceCache() {
+    }
+
+    bool contains(const PluginInstanceData* instance) const {
+
+        HashMap<Element*, PluginCacheItem>::const_iterator i = m_items.begin();
+        for (; i != m_items.end(); ++i) {
+            if (i->second.data == instance) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Add instance data to the cache.
+     */
+    void add(Element* element, PluginInstanceData* instance) {
+
+        ASSERT(NULL != element);
+        ASSERT(m_items.find(element) == m_items.end());
+        ASSERT(!contains(instance));
+        ASSERT(instance->m_cacheInstanceData);
+
+        PluginCacheItem item;
+        item.listener = PluginCacheListener::create(this, element);
+        item.data = instance;
+        m_items.set(element, item);
+        ASSERT(contains(instance));
+    }
+
+    /**
+     * Get a matching plugin package from this cache. If an element is found then it
+     * will be removed from this cache.
+     *
+     * @param element The element that we're trying to find the instance data for.
+     * @return The cached PluginInstanceData or NULL if no cached instance was found
+     *         matching the element. The caller is responsible for deleting this
+     *         returned pointer.
+     */
+    PluginInstanceData* get(Element* element) {
+
+        HashMap<Element*, PluginCacheItem>::iterator i = m_items.find(element);
+        if (i == m_items.end()) {
+            return NULL;	// Not in the cache
+        }
+        else {
+            PluginCacheItem item = (*i).second;
+            item.listener->unregister();
+            item.listener = 0;
+            m_items.remove(i);
+            return item.data;
+        }
+    }
+
+    /**
+     * Remove the element's PluginCacheData from the cache. The caller is now responsible for
+     * deleting it.
+     * @return true if removed from the list, false if not.
+     */
+    bool remove(Element* element) {
+        HashMap<Element*, PluginCacheItem>::iterator i = m_items.find(element);
+        if (i == m_items.end()) {
+            return false;
+        }
+        else {
+            i->second.listener->unregister();
+            i->second.listener = 0;
+            m_items.remove(i);
+            return true;
+        }
+    }
