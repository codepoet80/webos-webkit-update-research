+void V8Proxy::registerProxy(V8Proxy *proxy) {
+    // Link this to next proxy:
+    proxy->next_ = head_;
+    if (head_) {
+        head_->prev_ = proxy;
+    }
+
+    // Insert this at the head of the list:
+    proxy->prev_ = NULL;
+    head_ = proxy;
+}
+
+void V8Proxy::unregisterProxy(V8Proxy *proxy) {
+    // Unlink from next:
+    if (proxy->next_) {
+        proxy->next_->prev_ = proxy->prev_;
+    }
+    // Unlink from prev:
+    if (proxy->prev_) {
+        proxy->prev_->next_ = proxy->next_;
+    }
+    // Unlink from head:
+    if (head_ == proxy) {
+        head_ = proxy->next_;
+    }
+}
