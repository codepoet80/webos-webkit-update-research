+    , m_currentShader(0)
+#if PLATFORM(PG)
+    , m_rootLayerBackingSurface(0)
+    , m_rootLayerGraphicsContextPG(0)
+#endif
+    , m_context(context)
+	, m_maxTextureSize(0)
