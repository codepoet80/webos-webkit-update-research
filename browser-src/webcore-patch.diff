+
+void GraphicsContext::setCompositeOperation(CompositeOperator op)
+{
+    if (paintingDisabled())
+        return;
+
+	PCompRule compRule;
+	switch (op) {
+		case CompositeClear: // TODO is this copy mode?
+		case CompositeCopy:
+			compRule = PCopyMode;
+			break;
+		case CompositeSourceOver:
+			compRule = PSrcOverMode;
+			break;
+		case CompositeSourceIn:
+			compRule = PSrcInMode;
+			break;
+		case CompositeSourceOut:
+			compRule = PSrcOutMode;
+			break;
+		case CompositeSourceAtop:
+			compRule = PSrcATopMode;
+			break;
+		case CompositeDestinationOver:
+			compRule = PDstOverMode;
+			break;
+		case CompositeDestinationIn:
+			compRule = PDstInMode;
+			break;
+		case CompositeDestinationOut:
+			compRule = PDstOutMode;
+			break;
+		case CompositeDestinationAtop:
+			compRule = PDstATopMode;
+			break;
+		case CompositeXOR:
+			compRule = PXorMode;
+			break;
+		case CompositePlusDarker:
+			compRule = PDarkenMode;
+			break;
+		case CompositeHighlight:
+			// TODO
+			return;
+			break;
+		case CompositePlusLighter:
+			compRule = PLightenMode;
+			break;
+        default:
+            return;
+	}
+	m_data->context->setCompositeOperation(compRule);
+}
