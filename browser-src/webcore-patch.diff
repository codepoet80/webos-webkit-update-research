+PGSurface* PGContext::createSurface(uint32_t width, uint32_t height,
+									bool hasAlpha, const void* pixelData)
+{
+	PGSurface* p = new PGSurface;
+	p->m_width  = width;
+	p->m_height = height;
+	p->m_hasAlpha = hasAlpha;
+    p->m_context = this;
+
+#if P_BACKEND==P_BACKEND_GLES
+    p->m_pixmap = m_gc->CreatePixmap(width, height, hasAlpha ? PFORMAT_8888 : PFORMAT_8880, const_cast<void *>(pixelData));
+	p->m_raster = 0;
+#else
+	p->m_pixmap = m_gc->CreatePixmap(width, height);
+	p->m_pixmap->Set(hasAlpha ? PFORMAT_8888 : PFORMAT_8880, pixelData, pixelData ? width * 4 : 0, true);
+	p->m_raster = (uint8_t*) p->m_pixmap->GetBuffer();	
+#endif
+
+	return p;
+}
+
+PGSurface* PGContext::wrapBitmapData(uint32_t width, uint32_t height,
+									 bool hasAlpha, const void* pixelData, uint32_t pitch)
+{
+#if P_BACKEND==P_BACKEND_GLES
+    notImplemented();
+    return 0;
+#else	
+	PGSurface* p = new PGSurface;
+	p->m_width  = width;
+	p->m_height = height;
+	p->m_hasAlpha = hasAlpha;
+	p->m_ownData = false;
+    p->m_context = this;
+
+	p->m_pixmap = m_gc->CreatePixmap(width, height);
+
+	if (!p->m_pixmap->Wrap(hasAlpha ? PFORMAT_8888 : PFORMAT_8880, (void*) pixelData,
+                           pitch ? pitch : (width * sizeof(uint32_t)), true))
+	    return 0;
+
+	p->m_raster = (uint8_t*) p->m_pixmap->GetBuffer();
+
+	return p;
+#endif
+}
