+ImageBuffer::ImageBuffer(const IntSize& size, ImageColorSpace colorSpace, bool& success)
+    : m_data(size)
+    , m_size(size)
+{
+	success = false;
+	
+	m_data.m_surface = PGSurface::create( size.width(), size.height(), true );
+	if( !m_data.m_surface )
+		return;
+	
+	PGContext* cr = PGContext::create( );
+	if( !cr )
+		return;
+	
+	cr->setSurface( m_data.m_surface );
+	
+	cr->clearRect(0, 0, size.width(), size.height());
+
+	m_context.set( new GraphicsContext(cr) );
+	cr->releaseRef(); // owned by GraphicsContext now
+	success = true;
+}
+
+
+ImageBuffer::~ImageBuffer()
+{
+	if (m_data.m_surface)
+		m_data.m_surface->releaseRef();
+}
