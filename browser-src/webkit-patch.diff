+	struct LayerCandidate
+	{
+		LayerCandidate(RenderObject* r, float sc=0.0f, float centerScore=0.0f) : ro(r), scale(sc), centerScore(centerScore) { } 
+		LayerCandidate() : ro(0) {} 
+		~LayerCandidate() { }
+		RenderObject*   ro;
