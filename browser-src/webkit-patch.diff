+FloatRect ChromeClient::windowRect()
+{
+    Palm::WebView* view = m_webPage->view();
+    if (!view)
+        return FloatRect();
+
+    Palm::WebViewClient* viewClient = view->client();
+    int width, height;
+    viewClient->getScreenSize(width, height);
+
+    return FloatRect(0.0f, 0.0f, float(width), float(height));
+}
