+bool SpellCheck::SpellCheckCache::lookup(const WTF::String& typedWord, SpellCheckWordInfo& info) const
+{
+	if (m_entries.contains(typedWord)) {
+		info = m_entries.get(typedWord);
+		return true;
+	}
+	else {
+		return false;
+	}
+}
