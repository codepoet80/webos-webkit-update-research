+bool EditorStickyState::isTerminalPunctuationKey(unsigned short key,unsigned short modifier)
+{
+		modifyKeyEvent(key,modifier);
+		
+		if( key == Key_Return ||
+			key == Key_Period ||
+			key == Key_Exclamation ||
+			key == Key_Question )
+		return true;
+	else
+		return false;
+}
