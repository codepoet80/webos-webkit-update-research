+{
+}
+
+bool GLES2Context::makeCurrent()
+{
+    WebGLES2Context* webContext = m_internal->getWebGLES2Context();
+    if (!webContext)
+        return false;
+    return webContext->makeCurrent();
+}
+
+bool GLES2Context::destroy()
+{
+    WebGLES2Context* webContext = m_internal->getWebGLES2Context();
+    if (!webContext)
+        return false;
+    return webContext->destroy();
+}
