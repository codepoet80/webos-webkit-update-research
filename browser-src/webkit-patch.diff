+void MemStats::inc(const char* category, int size)
+{
+	init();
+
+	if (!s_enableMemoryStats)
+		return;	
+	
+	MemStatsEntry* entry = findEntry(category);
+	entry->size += size;
+}
+
+void MemStats::dec(const char* category, int size)
+{
+	init();
+
+	if (!s_enableMemoryStats)
+		return;	
+	
+	MemStatsEntry* entry = findEntry(category);
+	entry->size -= size;
+}
+
+void MemStats::set(const char* category, int size)
+{
+	init();
+
+	if (!s_enableMemoryStats)
+		return;	
+	
+	MemStatsEntry* entry = findEntry(category);
+	entry->size = size;
+}
