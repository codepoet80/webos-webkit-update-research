+static std::string escapeStringForJson( const String& str )
+{
+	std::string r;	
+	const char* s = str.utf8().data();
+	
+	while( *s )
+	{
+		if( *s == '\"' || *s == '\\' ) {
+			r += "\\";
+			r += *s;
+		} else if( *s == 0x0a )
+			r += "\\n";
+		else if( *s == 0x0d )
+			r += "\\r";
+		else
+			r += *s;
+		
+		s++;
+	}
+	
+	return r;
+}
