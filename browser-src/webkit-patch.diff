+static const char* kFixedUserAgents[] = 
+{
+	"Mozilla/5.0 (%s; Linux; %s/%s; U; %s) AppleWebKit/" FULL_VERSION_STRING " (KHTML, like Gecko) %s/" SUBMISSION_NUMBER_STRING " Safari/" FULL_VERSION_STRING " %s/%s",
