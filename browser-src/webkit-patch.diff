+        s_browserFuncs.reloadplugins = NPN_ReloadPlugins;
+        s_browserFuncs.geturlnotify = NPN_GetURLNotify;
+        s_browserFuncs.posturlnotify = (NPN_PostURLNotifyProcPtr)NPN_PostURLNotify;
+        s_browserFuncs.getvalue = NPN_GetValue;
