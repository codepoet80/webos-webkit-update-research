                     if (!value || value->unit != CSSPrimitiveValue::CSS_STRING)
                         return false;
+                    // Security: Validate string pointer
+                    if (!value->string.characters() && value->string.length() > 0)
+                        return false;
+
                     values->append(CSSFontFaceSrcValue::createLocal(value->string));
                 } else if (equalIgnoringCase(value->string, "format(")) {
                     // The format value
@@ -2679,6 +2688,11 @@ bool CSSParser::parseFontFaceSrc()
