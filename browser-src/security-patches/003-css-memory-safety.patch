From: webOS Security Patches
Subject: [PATCH 003] CSS parsing memory safety improvements
Date: 2025-01-01

This patch addresses CVE-2010-0046 and similar memory corruption
vulnerabilities in CSS parsing code, particularly around format()
function handling and property value parsing.

---
diff -u a/WebCore/css/CSSParser.cpp b/WebCore/css/CSSParser.cpp
--- a/WebCore/css/CSSParser.cpp
+++ b/WebCore/css/CSSParser.cpp
@@ -2647,6 +2647,11 @@ bool CSSParser::parseFontFaceSrc()
         CSSParserValue* value = m_valueList->current();
         if (!value)
             break;
+
+        // Security: Validate value pointer and type before use
+        if (!value || value->unit == CSSPrimitiveValue::CSS_UNKNOWN)
+            return false;
+
         if (val->unit == CSSPrimitiveValue::CSS_URI) {
             // url() value
             String uriValue = val->string;
@@ -2667,6 +2672,10 @@ bool CSSParser::parseFontFaceSrc()
