                     if (value->unit != CSSPrimitiveValue::CSS_STRING)
                         continue;
+
+                    // Security: Bounds check format string
+                    if (value->string.length() > 256)
+                        return false;
+
                     uriValue->setFormat(value->string);
                     value = m_valueList->next();
                     if (!value)
@@ -3128,6 +3142,10 @@ PassRefPtr<CSSValue> CSSParser::parseAnimationProperty()

 bool CSSParser::parseTransformOriginShorthand(RefPtr<CSSValue>& value1, RefPtr<CSSValue>& value2, RefPtr<CSSValue>& value3)
 {
+    // Security: Validate value list exists
+    if (!m_valueList || !m_valueList->current())
+        return false;
+
     CSSParserValue* value = m_valueList->current();
     if (!value)
         return false;
@@ -4620,6 +4638,12 @@ bool CSSParser::parseValue(int propId, bool important)
     CSSParserValue* value = m_valueList->current();
     if (!value)
         return false;
+
+    // Security: Validate we have a sane value unit
+    // Negative units should not appear in most contexts
+    if (value->unit < 0 && value->unit != CSSParserValue::Operator)
+        return false;
+
     int id = value->id;

