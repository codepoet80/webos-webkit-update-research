diff -u a/WebCore/css/CSSStyleSelector.cpp b/WebCore/css/CSSStyleSelector.cpp
--- a/WebCore/css/CSSStyleSelector.cpp
+++ b/WebCore/css/CSSStyleSelector.cpp
@@ -4127,6 +4127,12 @@ void CSSStyleSelector::applyProperty(int id, CSSValue *value)
